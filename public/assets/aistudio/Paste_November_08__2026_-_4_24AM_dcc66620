:: ============================================================
:: SECCION 1: PLAN DE ENERGIA - ULTIMATE PERFORMANCE
:: ============================================================
echo.
echo [1/12] Plan de energia: ULTIMATE PERFORMANCE...
powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61
for /f "tokens=2 delims=:" %%i in ('powercfg -l /s') do (
    set "ULTRA_GUID=%%i"
)
for /f "tokens=2 delims=:" %%i in ('powercfg -l /s ^| findstr /i "Ultimate"') do (
