```batch
@echo off
title [RYZER CORTEX ULTRA] - CS2 FPS OPTIMIZER v2.0
color 0A
cls

echo.
echo  ============================================
echo   RYZER CORTEX ULTRA - CS2 FPS OPTIMIZER
echo   Target: ASUS ExpertCenter PN64 / i3-1220P
echo   16GB DDR4 DC / NVMe 500GB
echo  ============================================
