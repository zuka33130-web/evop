reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\cs2.exe\PerfOptions" /v "IoPriority" /t REG_DWORD /d 3 /f >nul 2>&1

:: Configurar también para Steam
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\steam.exe\PerfOptions" /v "CpuPriorityClass" /t REG_DWORD /d 2 /f >nul 2>&1

echo      [OK] Thread Affinity: CS2 = HIGH priority

echo  [9/10] Deshabilitando System Integrity Checks...

:: ============================================================
:: SYSTEM INTEGRITY - Reducir overhead de verificaciones
:: ============================================================

:: Deshabilitar SFC checks automáticos
schtasks /change /tn "\Microsoft\Windows\Windows SFC\SCM" /disable >nul 2>&1

:: Deshabilitar WFP (Windows Filtering Platform) inspection
reg add "HKLM\SYSTEM\CurrentControlSet\Services\BFE\Parameters" /v "EnableDnsFilter" /t REG_DWORD /d 0 /f >nul 2>&1

:: Deshabilitar Windows Firewall (si no es necesario)
netsh advfirewall set allprofiles state off >nul 2>&1

:: Deshabilitar IPsec
reg add "HKLM\SYSTEM\CurrentControlSet\Services\IPsec" /v "Start" /t REG_DWORD /d 4 /f >nul 2>&1

echo      [OK] System Integrity Checks: DESHABILITADOS

echo  [10/10] Limpiando optimizaciones de registro inútiles...

:: Eliminar claves de registro que usan I/O innecesario
reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\Results\Install" /f >nul 2>&1

