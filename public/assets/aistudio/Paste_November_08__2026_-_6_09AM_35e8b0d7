## 🧠 ARCHIVO 17 — Kernel + CPU Ultra

```batch
:: ============================================================
:: ARCHIVO: 17_KERNEL_CPU_ULTRA.bat
:: OBJETIVO: Tweaks a nivel KERNEL + CPU
::           Cache, prefetch, branch prediction, threading
::           [EXTREMO] Esto casi nadie lo hace
:: ============================================================
@echo off
title CS2 Optimizer - Kernel CPU ULTRA
color 0B
echo.
echo  =============================================
echo   CS2 FPS OPTIMIZER - KERNEL CPU ULTRA
echo  =============================================
echo.

net session >nul 2>&1
if %errorlevel% neq 0 (
    color 0C
    echo  [ERROR] Ejecutar como ADMINISTRADOR
    pause
    exit /b 1
)

echo  [1/10] Optimizando Kernel Memory Manager...

:: ============================================================
:: KERNEL MEMORY - Tweaks de bajo nivel
:: ============================================================

:: Deshabilitar working set trimming (mantiene apps en RAM)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "DisablePagingExecutive" /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "LargeSystemCache" /t REG_DWORD /d 0 /f >nul 2>&1

:: Configurar Working Set para gaming
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "SessionViewSize" /t REG_DWORD /d 1024 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "SessionImageSize" /t REG_DWORD /d 512 /f >nul 2>&1

:: I/O Page Lock Limit (mantener I/O en memoria)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "IoPageLockLimit" /t REG_DWORD /d 536870912 /f >nul 2>&1

:: System Pages optimizado
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "SystemPages" /t REG_DWORD /d 0 /f >nul 2>&1

:: Deshabilitar memory scrubbing (ahorra CPU)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "MemoryScrubInterval" /t REG_DWORD /d 0 /f >nul 2>&1

echo      [OK] Kernel Memory Manager ULTRA

echo  [2/10] Optimizando CPU Scheduling a nivel kernel...

:: ============================================================
:: CPU SCHEDULER - Kernel level threading
:: ============================================================

:: Processor scheduling: Programs (foreground)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v "Win32PrioritySeparation" /t REG_DWORD /d 38 /f >nul 2>&1

:: IRQ Priority: Highest para hardware crítico
reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v "IRQ8Priority" /t REG_DWORD /d 1 /f >nul 2>&1

:: Deshabilitar Processor Security Mitigations completamente
bcdedit /set {current} nx AlwaysOff >nul 2>&1
bcdedit /set {current} isolatedcontext No >nul 2>&1

:: Habilitar Boot Optimization
bcdedit /set {current} bootmenupolicy legacy >nul 2>&1

:: Configurar kernel para maximum throughput
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "DisableExceptionChainValidation" /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "MitigationOptions" /t REG_BINARY /d 22222222222222222222222222222222 /f >nul 2>&1

:: Deshabilitar Stack Protection (reduce overhead CPU)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "StackCookie" /t REG_DWORD /d 0 /f >nul 2>&1

:: Kernel Pool optimization
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "KernelStackPages" /t REG_DWORD /d 12 /f >nul 2>&1

echo      [OK] CPU Scheduling ULTRA

echo  [3/10] Optimizando Cache y Prefetch a nivel CPU...

:: ============================================================
:: CPU CACHE & PREFETCH - Maximizar cache hit rate
:: ============================================================

:: L2 Cache size (i3-1220P tiene 12.5MB total)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "SecondLevelDataCache" /t REG_DWORD /d 12800 /f >nul 2>&1

:: L3 Cache (Shared)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "ThirdLevelDataCache" /t REG_DWORD /d 12800 /f >nul 2>&1

:: Prefetch aggressiveness
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v "EnablePrefetcher" /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v "EnableSuperfetch" /t REG_DWORD /d 0 /f >nul 2>&1

:: Deshabilitar Branch Target Injection mitigations
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "FeatureSettingsOverride" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "FeatureSettingsOverrideMask" /t REG_DWORD /d 3 /f >nul 2>&1

:: Deshabilitar Retpoline (savings masivos en Intel)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "FeatureSettingsOverride" /t REG_DWORD /d 3 /f >nul 2>&1

echo      [OK] CPU Cache & Prefetch ULTRA

echo  [4/10] Deshabilitando TODAS las mitigaciones CPU...

:: ============================================================
:: CPU SECURITY MITIGATIONS - COMPLETAMENTE OFF
:: [!] Esto da +10-25% de rendimiento en CPU
:: [!] Reduce seguridad del sistema
:: ============================================================

:: Crear PowerShell script para deshabilitar TODO
powershell -command ^
"Set-ProcessMitigation -System -Disable EnableRopCallerCheck, EnableRopSimExec, EnableExportAddressFilter, EnableExportAddressFilterPlus, EnableRopStackPivot, EnableImportAddressFilter, BlockRemoteImageLoads, BlockLowLabelImageLoads, PreferSystem32Images, AllowThreadsToOptOut 2>$null" 2>nul

:: Deshabilitar via BCD
bcdedit /set {current} vsmlaunchtype off >nul 2>&1
bcdedit /set {current} vm 0 >nul 2>&1

:: Deshabilitar Hardware-enforced Stack Protection
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "MitigationOptions" /t REG_BINARY /d 22222222222222222222222222222222 /f >nul 2>&1

:: Deshabilitar CFG (Control Flow Guard)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "MitigationOptions" /t REG_BINARY /d 22222222222222222222222222222222 /f >nul 2>&1

:: Deshabilitar HVCI
bcdedit /set {current} hypervisorlaunchtype off >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard" /v "EnableVirtualizationBasedSecurity" /t REG_DWORD /d 0 /f >nul 2>&1

echo      [OK] TODAS las CPU mitigations: DESHABILITADAS

echo  [5/10] Optimizando Thread Pool del Kernel...

:: ============================================================
:: THREAD POOL - Kernel threading optimization
:: ============================================================

:: Configurar thread pool para gaming
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "GlobalTimerResolutionRequests" /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v "DpcWatchdogTimerDisable" /t REG_DWORD /d 1 /f >nul 2>&1

:: Processor Thread Quantum (aumentar = menos context switching)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v "ForegroundBoost" /t REG_DWORD /d 6 /f >nul 2>&1

:: Idle Thread Priority (reduce overhead)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v "IdleTime" /t REG_DWORD /d 0 /f >nul 2>&1

echo      [OK] Thread Pool optimizado

echo  [6/10] Configurando CPU States a nivel registry...

:: ============================================================
:: CPU STATES - Forzar máximo performance
:: ============================================================

:: Deshabilitar Intel SpeedStep (usar siempre max freq)
:: NOTA: Esto aumenta temperatura - monitorizar
reg add "HKLM\SYSTEM\CurrentControlSet\Services\intelppm\Parameters" /v "AdaptiveSleep" /t REG_DWORD /d 0 /f >nul 2>&1

:: Configurar C-States (0 = solo C0 = máximo performance)
:: vía powercfg
powercfg -setacvalueindex scheme_current sub_processor 5d76a2ca-e8c0-402f-a133-2158492d58ad 0
powercfg -setacvalueindex scheme_current sub_processor PROCTHROTTLEMIN 100
powercfg -setacvalueindex scheme_current sub_processor PROCTHROTTLEMAX 100
powercfg -setacvalueindex scheme_current sub_processor CPMINCORES 100
powercfg -setacvalueindex scheme_current sub_processor CPMAXCORES 100
powercfg -setacvalueindex scheme_current sub_processor CPDPCMIN 100
powercfg -setacvalueindex scheme_current sub_processor CPDPCMAX 100

:: Deshabilitar CPU throttling por temperatura (AGRESIVO)
:: Solo si tienes buena ventilación
reg add "HKLM\SYSTEM\CurrentControlSet\Services\intelppm\Parameters" /v "NoStep" /t REG_DWORD /d 1 /f >nul 2>&1

:: Power throttle OFF
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling" /v "PowerThrottlingOff" /t REG_DWORD /d 1 /f >nul 2>&1

:: Turbo Boost agresivo
powercfg -setacvalueindex scheme_current sub_processor PERFBOOSTMODE 2
powercfg -setacvalueindex scheme_current sub_processor PERFBOOSTPOL 100

powercfg -setactive scheme_current

echo      [OK] CPU States: FORZADOS a máximo

echo  [7/10] Optimizando Registry File I/O...

:: ============================================================
:: REGISTRY I/O - Reducir acceso a disco del registro
:: ============================================================

:: Cache de registro en memoria
