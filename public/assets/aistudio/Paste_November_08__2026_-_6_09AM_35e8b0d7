:: Deshabilitar registro de cambios (reduce I/O)
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Configuration Manager" /v "RegistryQuotaLimit" /t REG_DWORD /d 209715200 /f >nul 2>&1

echo      [OK] Registry I/O optimizado

echo  [8/10] Configurando Thread Affinity por defecto...

:: ============================================================
