echo   * Turbo Boost: AGGRESSIVE
echo   * Core Parking: OFF
echo   * Registry I/O: CACHED
echo   * CS2 Thread Priority: HIGH
echo   * System Integrity: DISABLED
echo   * Event Logs: CLEARED + DISABLED
echo   * Firewall: OFF
