namespace EvoOptimizer.App.ViewModels;

public sealed class DecisionCardViewModel
{
    public required string DecisionId { get; init; }
    public required string SubsystemTag { get; init; }
    public required string Title { get; init; }
    public required string DispositionBadgeText { get; init; }
