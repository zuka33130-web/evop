using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Infrastructure.Services;

public sealed class AdaptiveDecisionEngineService :
    IAdaptiveDecisionEngine,
    IBottleneckDetectionEngine
{
    private readonly IRecoveryRollbackEngine _rollbackEngine;
    private readonly IHistoricalAnalysisEngine _historicalEngine;

    public AdaptiveDecisionEngineService(
        IRecoveryRollbackEngine rollbackEngine,
        IHistoricalAnalysisEngine historicalEngine)
    {
        _rollbackEngine = rollbackEngine;
        _historicalEngine = historicalEngine;
    }

    public AdaptiveEvaluationReport EvaluateSystemState(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        BottleneckAssessment bottleneck = AnalyzeBottlenecks(hardware, telemetry, objective);
        EvoPerformanceScore score = ComputePerformanceScore(hardware, telemetry, objective);
        IReadOnlyList<AdaptiveDecisionItem> rawDecisions = GenerateContextAwareDecisions(hardware, telemetry, objective);

        var enrichedDecisions = new List<AdaptiveDecisionItem>(rawDecisions.Count);
        foreach (var item in rawDecisions)
        {
            bool isApplied = _rollbackEngine.IsDecisionCurrentlyActive(item.DecisionId);
            HistoricalDecisionOutcome? empirical = _historicalEngine.GetEmpiricalOutcome(item.DecisionId, objective);

            if (empirical is not null && empirical.SuppressFutureRecommendation && !isApplied)
            {
                enrichedDecisions.Add(item with
                {
                    Disposition = DecisionDisposition.SuppressedNotBeneficial,
                    IsCurrentlyApplied = false,
                    EmpiricalHistoryNote = empirical.EmpiricalConclusion
                });
            }
            else
            {
                enrichedDecisions.Add(item with
                {
                    IsCurrentlyApplied = isApplied,
                    EmpiricalHistoryNote = empirical?.EmpiricalConclusion
                });
            }
        }

        return new AdaptiveEvaluationReport(
            GeneratedAt: DateTimeOffset.Now,
            ActiveObjective: objective,
            HardwareProfile: hardware,
            Telemetry: telemetry,
            Bottleneck: bottleneck,
            PerformanceScore: score,
            Decisions: enrichedDecisions
        );
    }

    public BottleneckAssessment AnalyzeBottlenecks(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        var candidates = new List<(BottleneckSubsystem Subsystem, int SeverityScore, string Headline, string Explanation)>();

        if (telemetry.IsCpuPowerOrThermalThrottled)
        {
            candidates.Add((
                BottleneckSubsystem.ThermalTelemetryUnverified,
                94,
                $"Estrangulamiento de Frecuencia Detectado ({telemetry.CpuLimitClockMhz} MHz / {telemetry.CpuMaxClockMhz} MHz)",
                $"El kernel de Windows (powrprof) reporta que el techo de frecuencia del procesador está limitado a {telemetry.CpuLimitClockMhz} MHz frente a su base de {telemetry.CpuMaxClockMhz} MHz por políticas térmicas o de potencia."
            ));
        }

        if (telemetry.PhysicalMemoryLoadPercent >= 85.0 || telemetry.CommitChargePercent >= 85.0)
        {
            candidates.Add((
                BottleneckSubsystem.MemoryPhysicalPressure,
                92,
                "Presión Crítica de Memoria y Riesgo de Paginación",
                $"El sistema utiliza el {telemetry.PhysicalMemoryLoadPercent:F0}% de sus {hardware.TotalPhysicalMemoryGb:F1} GB físicos y el {telemetry.CommitChargePercent:F0}% del Commit Charge total."
            ));
        }
        else if (hardware.MemoryTier == MemoryCapacityTier.Constrained_8GBOrLess && telemetry.PhysicalMemoryLoadPercent >= 70.0)
        {
            candidates.Add((
                BottleneckSubsystem.MemoryPhysicalPressure,
                80,
                "Margen Estrecho de RAM en Arquitectura de <= 8 GB",
                $"Con {hardware.TotalPhysicalMemoryGb:F1} GB instalados y {telemetry.PhysicalMemoryAvailableGb:F2} GB libres, conviene contener procesos inactivos antes de abrir cargas pesadas."
            ));
        }

        if (telemetry.CpuTotalUtilizationPercent >= 82.0)
        {
            candidates.Add((
                BottleneckSubsystem.CpuComputeSaturation,
                88,
                "Saturación de Cómputo en Hilos Lógicos de CPU",
                $"La utilización global de los {hardware.LogicalCoreCount} hilos lógicos ({hardware.PhysicalCoreCount} núcleos físicos) alcanza el {telemetry.CpuTotalUtilizationPercent:F1}%."
            ));
        }

        int processThreshold = objective == OptimizationObjective.Gaming ? 180 : 225;
        if (telemetry.TotalRunningProcesses > processThreshold || telemetry.TotalSystemThreads > 3000)
        {
            candidates.Add((
                BottleneckSubsystem.ProcessEcosystemSprawl,
                76,
                "Proliferación de Procesos e Hilos en Segundo Plano",
                $"Se detectan {telemetry.TotalRunningProcesses} procesos y {telemetry.TotalSystemThreads} hilos activos compitiendo por {hardware.CpuL3CacheMb:F1} MB de Caché L3. Ventana protegida: {telemetry.ActiveForegroundProcessName}."
            ));
        }

        if (telemetry.SystemDriveFreePercent < 12.0 || telemetry.SystemDriveFreeGb < 20.0)
        {
            candidates.Add((
                BottleneckSubsystem.StorageSpaceCritical,
                85,
                "Baja Capacidad Libre en Unidad del Sistema",
                $"La unidad {hardware.SystemDriveName} solo dispone de {telemetry.SystemDriveFreeGb:F1} GB libres ({telemetry.SystemDriveFreePercent:F1}%)."
            ));
        }

        string throttleStatus = telemetry.IsCpuPowerOrThermalThrottled
            ? $"THROTTLING ACTIVO ({telemetry.CpuLimitClockMhz}/{telemetry.CpuMaxClockMhz} MHz)"
            : $"SIN THROTTLING ({telemetry.CpuCurrentClockMhz}/{telemetry.CpuMaxClockMhz} MHz)";

        string uncertaintyNotice =
            $"ESTADO DEL SILICIO: {throttleStatus} | Reloj Kernel: {telemetry.CurrentKernelTimerResolutionMs:F3} ms | P99 (1% Low): {telemetry.SchedulerOnePercentLowMs:F3} ms | Caché L3: {hardware.CpuL3CacheMb:F1} MB.";

        if (candidates.Count == 0)
        {
            return new BottleneckAssessment(
                PrimaryBottleneck: BottleneckSubsystem.NoneNominal,
                SecondaryBottleneck: BottleneckSubsystem.NoneNominal,
                DiagnosticConfidencePercent: 93,
                SummaryHeadline: "Operación Nominal de Silicio y Sistema Operativo",
                TechnicalExplanation: $"CPU ({telemetry.CpuTotalUtilizationPercent:F1}% a {telemetry.CpuCurrentClockMhz} MHz), RAM ({telemetry.PhysicalMemoryLoadPercent:F0}%) y P99 1% Low ({telemetry.SchedulerOnePercentLowMs:F3} ms) operan en punto óptimo para '{FormatObjectiveName(objective)}'.",
                UncertaintyNotice: uncertaintyNotice
            );
        }

        var ordered = candidates.OrderByDescending(c => c.SeverityScore).ToList();
        var primary = ordered[0];
        var secondary = ordered.Count > 1 ? ordered[1].Subsystem : BottleneckSubsystem.NoneNominal;

        return new BottleneckAssessment(
            PrimaryBottleneck: primary.Subsystem,
            SecondaryBottleneck: secondary,
            DiagnosticConfidencePercent: primary.SeverityScore,
            SummaryHeadline: primary.Headline,
            TechnicalExplanation: primary.Explanation,
            UncertaintyNotice: uncertaintyNotice
        );
    }

    private static EvoPerformanceScore ComputePerformanceScore(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        double commitPenalty = Math.Max(0, telemetry.CommitChargePercent - 55.0) * 1.1;
        double p99Penalty = Math.Min(14.0, telemetry.SchedulerOnePercentLowMs * 4.2);
        int stabilityScore = (int)Math.Clamp(Math.Round(97.0 - commitPenalty - p99Penalty), 25, 99);
        string stabilityDiag = $"1% Low (P99): {telemetry.SchedulerOnePercentLowMs:F3} ms | 0.1% Low: {telemetry.SchedulerPointOnePercentLowMs:F3} ms";

        double cpuBusyPenalty = telemetry.CpuTotalUtilizationPercent * 0.45;
        double ramHeadroomBonus = Math.Min(12.0, telemetry.PhysicalMemoryAvailableGb * 0.85);
        int performanceScore = (int)Math.Clamp(Math.Round(86.0 - cpuBusyPenalty + ramHeadroomBonus), 20, 99);
        string performanceDiag = $"Frecuencia: {telemetry.CpuCurrentClockMhz} MHz | RAM Libre: {telemetry.PhysicalMemoryAvailableGb:F2} GB";

        double processSprawlPenalty = Math.Max(0, (telemetry.TotalRunningProcesses - 120) * 0.25);
        double topConsumersMb = telemetry.TopMemoryConsumers.Sum(p => p.WorkingSetMb);
        double backgroundFootprintPenalty = hardware.TotalPhysicalMemoryGb > 0
            ? (topConsumersMb / (hardware.TotalPhysicalMemoryGb * 1024.0)) * 32.0
            : 10.0;
        int efficiencyScore = (int)Math.Clamp(Math.Round(98.0 - processSprawlPenalty - backgroundFootprintPenalty), 25, 99);
        string efficiencyDiag = $"{telemetry.TotalRunningProcesses} procesos | Timer: {telemetry.CurrentKernelTimerResolutionMs:F3} ms";

        double storagePenalty = telemetry.SystemDriveFreePercent < 20.0 ? (20.0 - telemetry.SystemDriveFreePercent) * 2.5 : 0.0;
        double throttlePenalty = telemetry.IsCpuPowerOrThermalThrottled ? 18.0 : 0.0;
        int healthScore = (int)Math.Clamp(Math.Round(97.0 - storagePenalty - throttlePenalty), 30, 99);
        string healthDiag = telemetry.IsCpuPowerOrThermalThrottled
            ? $"Límite Frecuencia Activo ({telemetry.CpuLimitClockMhz} MHz)"
            : $"Sin Throttling ({telemetry.CpuLimitClockMhz} MHz Max) | Disco {telemetry.SystemDriveFreePercent:F0}% Libre";

        double weighted = objective switch
        {
            OptimizationObjective.EverydayUse =>
                (stabilityScore * 0.30) + (efficiencyScore * 0.35) + (healthScore * 0.25) + (performanceScore * 0.10),
            OptimizationObjective.Gaming =>
                (stabilityScore * 0.40) + (performanceScore * 0.35) + (efficiencyScore * 0.15) + (healthScore * 0.10),
            OptimizationObjective.MaxPerformance =>
                (performanceScore * 0.45) + (stabilityScore * 0.30) + (efficiencyScore * 0.15) + (healthScore * 0.10),
            _ => (stabilityScore + performanceScore + efficiencyScore + healthScore) / 4.0
        };

        return new EvoPerformanceScore(
            EvaluatedForObjective: objective,
            CompositeWeightedScore: (int)Math.Round(weighted),
            StabilityScore: stabilityScore,
            StabilityDiagnostic: stabilityDiag,
            PerformanceScore: performanceScore,
            PerformanceDiagnostic: performanceDiag,
            EfficiencyScore: efficiencyScore,
            EfficiencyDiagnostic: efficiencyDiag,
            HealthScore: healthScore,
            HealthDiagnostic: healthDiag
        );
    }

    private static IReadOnlyList<AdaptiveDecisionItem> GenerateContextAwareDecisions(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        var decisions = new List<AdaptiveDecisionItem>();

        // 1. BLINDAJE DE INTERRUPCIONES EN CORE-0 (Adaptado al número de núcleos reales del CPU)
        if (hardware.LogicalCoreCount < 8 || objective == OptimizationObjective.EverydayUse)
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "CPU-CORE0-INTERRUPT-SHIELD",
                SubsystemTag: "SILICON TOPOLOGY & DPC SHIELD",
                Title: hardware.LogicalCoreCount < 8
                    ? "Supresión de Aislamiento de Afinidad Core-0 en CPU de Pocos Hilos"
                    : "Aislamiento de Afinidad Core-0 en Reposo (Modo Uso Cotidiano)",
                Disposition: DecisionDisposition.SuppressedNotBeneficial,
                ConfidencePercent: 97,
                RiskLevel: InterventionRiskLevel.ZeroRisk_Informational,
                HardwareContextReason: $"Topología detectada: {hardware.PhysicalCoreCount} núcleos físicos / {hardware.LogicalCoreCount} hilos lógicos ({hardware.CpuL3CacheMb:F1} MB L3).",
                TechnicalRationale: hardware.LogicalCoreCount < 8
                    ? "En procesadores con menos de 8 hilos lógicos, restringir procesos fuera de CPU 0/1 concentra demasiada carga en los núcleos restantes. EVO protege tu CPU rechazando este ajuste."
                    : "En uso de escritorio cotidiano no es necesario restringir máscaras de afinidad de núcleos.",
                ExpectedMeasurableImpact: "Distribución simétrica del planificador de Windows.",
                ValidationCriteria: "Máscaras de afinidad originales intactas.",
                RollbackStrategy: "No se altera ProcessorAffinity."
            ));
        }
        else
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "CPU-CORE0-INTERRUPT-SHIELD",
                SubsystemTag: "SILICON TOPOLOGY & DPC SHIELD",
                Title: $"Blindaje de Interrupciones Core-0 y Prioridad de I/O ({hardware.PhysicalCoreCount}C/{hardware.LogicalCoreCount}T)",
                Disposition: DecisionDisposition.RecommendedIntervention,
                ConfidencePercent: 96,
                RiskLevel: InterventionRiskLevel.LowRisk_SessionReversible,
                HardwareContextReason: $"CPU multinúcleo ({hardware.PhysicalCoreCount} núcleos físicos, {hardware.LogicalCoreCount} hilos, {hardware.CpuL3CacheMb:F1} MB Caché L3).",
                TechnicalRationale: "En Windows, los procesadores lógicos 0 y 1 gestionan la mayor carga de rutinas DPC/ISR del driver gráfico, NVMe y red. Al contar con " + hardware.LogicalCoreCount + " hilos lógicos, EVO desplaza la máscara de afinidad de los procesos pesados de segundo plano hacia los núcleos 2.." + (hardware.LogicalCoreCount - 1) + " y reduce su prioridad de I/O en ntdll.",
                ExpectedMeasurableImpact: "Reducción directa de micro-stuttering (1% y 0.1% Lows) y preservación de Caché L3 para el proceso activo.",
                ValidationCriteria: "Verificación de ProcessorAffinity e IoPriority por PID y Benchmark A/B de 1% Lows.",
                RollbackStrategy: "Restauración exacta de OriginalAffinityMask e IoPriority en cada PID modificado."
            ));
        }

        // 2. RELOJ DEL KERNEL (ntdll!NtSetTimerResolution)
        if (objective == OptimizationObjective.EverydayUse || telemetry.IsCpuPowerOrThermalThrottled)
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "TIMER-KERNEL-HIGH-PRECISION",
