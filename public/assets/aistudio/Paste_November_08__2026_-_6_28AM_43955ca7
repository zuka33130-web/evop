using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Core.Engine;

/// <summary>
/// Motor de inferencia estadística A/B para comparar configuraciones (ej. Línea Base A vs Intervención B).
/// Prohibición estricta de concluir sobre una única corrida: exige K_A >= 2 y K_B >= 2 corridas válidas
/// (recomendado >= 3), valida homogeneidad de contexto y calcula la prueba t de Welch con IC del 95%.
/// </summary>
public sealed class AbStatisticalComparisonEngine : IAbStatisticalComparisonEngine
{
    public const int MinimumRunsPerGroup = 2;

    public AbComparisonStatisticalReport CompareConfigurationRuns(
        string labelA,
        IReadOnlyList<RealFrametimeBenchmarkRun> runsA,
        string labelB,
        IReadOnlyList<RealFrametimeBenchmarkRun> runsB)
    {
        var validA = runsA.Where(r => r.Status == BenchmarkCaptureStatus.ValidCapture && r.OnePercentLowAverageFps.HasValue).ToList();
        var validB = runsB.Where(r => r.Status == BenchmarkCaptureStatus.ValidCapture && r.OnePercentLowAverageFps.HasValue).ToList();

        int kA = validA.Count;
        int kB = validB.Count;

        if (kA < MinimumRunsPerGroup || kB < MinimumRunsPerGroup)
        {
            return new AbComparisonStatisticalReport(
                BaselineLabelA: labelA,
                CandidateLabelB: labelB,
                RunCountA: kA,
                RunCountB: kB,
                Verdict: ComparisonVerdict.Inconclusive,
                VerdictSummary: "Inconclusive — Información insuficiente (se requieren múltiples corridas independientes por grupo).",
                StatisticalJustification: $"Una sola corrida nunca constituye prueba concluyente. Grupo A posee {kA} corridas válidas y Grupo B posee {kB} corridas válidas (mínimo requerido: {MinimumRunsPerGroup} por grupo, recomendado >= 3).",
                ContextComparable: false,
                ContextValidationNotes: "Imposible estimar varianza inter-corrida sin repeticiones independientes.",
                MeanOnePercentLowFpsA: kA > 0 ? validA.Average(r => r.OnePercentLowAverageFps!.Value) : null,
                MeanOnePercentLowFpsB: kB > 0 ? validB.Average(r => r.OnePercentLowAverageFps!.Value) : null,
                DeltaOnePercentLowFps: null,
                DeltaOnePercentLowPercent: null,
                ConfidenceInterval95LowerDeltaFps: null,
                ConfidenceInterval95UpperDeltaFps: null,
                WelchTStatistic: null,
                DegreesOfFreedom: null,
                MeanP99FrametimeMsA: kA > 0 ? validA.Average(r => r.P99FrametimeMs!.Value) : null,
                MeanP99FrametimeMsB: kB > 0 ? validB.Average(r => r.P99FrametimeMs!.Value) : null,
                MeanAverageFpsA: kA > 0 ? validA.Average(r => r.AverageFps!.Value) : null,
                MeanAverageFpsB: kB > 0 ? validB.Average(r => r.AverageFps!.Value) : null
            );
        }

        // Validación de homogeneidad de contexto experimental
        bool sameProcess = validA.All(r => r.TargetProcessName.Equals(validA[0].TargetProcessName, StringComparison.OrdinalIgnoreCase)) &&
                           validB.All(r => r.TargetProcessName.Equals(validA[0].TargetProcessName, StringComparison.OrdinalIgnoreCase));

        double meanDurationA = validA.Average(r => r.CaptureDurationSeconds);
        double meanDurationB = validB.Average(r => r.CaptureDurationSeconds);
        double durationDiffRatio = Math.Abs(meanDurationA - meanDurationB) / Math.Max(1.0, meanDurationA);
        bool comparableDuration = durationDiffRatio <= 0.30;

        bool contextValid = sameProcess && comparableDuration;
        string contextNotes = contextValid
            ? $"Contexto verificado: Proceso '{validA[0].TargetProcessName}', duración media A={meanDurationA:F1}s vs B={meanDurationB:F1}s."
            : $"Advertencia de contexto: Proceso coincidente={sameProcess}, diferencia relativa de duración={durationDiffRatio * 100.0:F1}%.";

        double[] lowFpsA = validA.Select(r => r.OnePercentLowAverageFps!.Value).ToArray();
        double[] lowFpsB = validB.Select(r => r.OnePercentLowAverageFps!.Value).ToArray();

        double meanA = lowFpsA.Average();
        double meanB = lowFpsB.Average();
        double deltaFps = meanB - meanA;
        double deltaPercent = meanA > 0 ? (deltaFps / meanA) * 100.0 : 0.0;

        double varA = CalculateSampleVariance(lowFpsA, meanA);
        double varB = CalculateSampleVariance(lowFpsB, meanB);

        double seSquaredA = varA / kA;
        double seSquaredB = varB / kB;
        double standardErrorDelta = Math.Sqrt(seSquaredA + seSquaredB);

        double df = CalculateWelchDegreesOfFreedom(seSquaredA, kA, seSquaredB, kB);
        double tCritical95 = ApproximateTwoTailedStudentTCritical95(df);

        double ciLower = deltaFps - (tCritical95 * standardErrorDelta);
        double ciUpper = deltaFps + (tCritical95 * standardErrorDelta);
        double tStat = standardErrorDelta > 1e-6 ? deltaFps / standardErrorDelta : 0.0;

        double meanP99A = validA.Average(r => r.P99FrametimeMs!.Value);
        double meanP99B = validB.Average(r => r.P99FrametimeMs!.Value);
        double meanAvgFpsA = validA.Average(r => r.AverageFps!.Value);
        double meanAvgFpsB = validB.Average(r => r.AverageFps!.Value);

        ComparisonVerdict verdict;
        string verdictSummary;

        if (!contextValid)
        {
            verdict = ComparisonVerdict.Inconclusive;
            verdictSummary = "Inconclusive — Las condiciones experimentales entre A y B no son homogéneas.";
        }
        else if (ciLower > 0.0 && deltaPercent >= 1.5)
        {
            verdict = ComparisonVerdict.Improvement;
            verdictSummary = $"Improvement — Mejora estadísticamente significativa en 1% Low FPS (+{deltaFps:F1} FPS / +{deltaPercent:F1}%).";
        }
        else if (ciUpper < 0.0 && deltaPercent <= -1.5)
        {
            verdict = ComparisonVerdict.Regression;
            verdictSummary = $"Regression — Degradación estadísticamente significativa en 1% Low FPS ({deltaFps:F1} FPS / {deltaPercent:F1}%).";
        }
        else if (Math.Abs(deltaPercent) < 1.5 && (ciUpper - ciLower) < (meanA * 0.06))
        {
            verdict = ComparisonVerdict.NoChange;
            verdictSummary = $"NoChange — Diferencia despreciable ({deltaPercent:+0.0;-0.0;0.0}%) dentro del margen de equivalencia.";
        }
        else
        {
            verdict = ComparisonVerdict.Inconclusive;
            verdictSummary = $"Inconclusive — El IC 95% [{ciLower:+0.0;-0.0;0.0}, {ciUpper:+0.0;-0.0;0.0}] FPS cruza el cero (la varianza entre corridas supera el efecto).";
        }

        string justification =
            $"Grupo A (n={kA}): 1% Low = {meanA:F1} FPS (SD={Math.Sqrt(varA):F2}) | " +
            $"Grupo B (n={kB}): 1% Low = {meanB:F1} FPS (SD={Math.Sqrt(varB):F2}) | " +
            $"Δ = {deltaFps:+0.00;-0.00;0.00} FPS ({deltaPercent:+0.0;-0.0;0.0}%), IC 95% [{ciLower:+0.00;-0.00;0.00}, {ciUpper:+0.00;-0.00;0.00}] FPS, t={tStat:F2} (gl={df:F1}).";

        return new AbComparisonStatisticalReport(
            BaselineLabelA: labelA,
            CandidateLabelB: labelB,
            RunCountA: kA,
            RunCountB: kB,
            Verdict: verdict,
            VerdictSummary: verdictSummary,
            StatisticalJustification: justification,
            ContextComparable: contextValid,
            ContextValidationNotes: contextNotes,
            MeanOnePercentLowFpsA: Math.Round(meanA, 1),
            MeanOnePercentLowFpsB: Math.Round(meanB, 1),
            DeltaOnePercentLowFps: Math.Round(deltaFps, 2),
            DeltaOnePercentLowPercent: Math.Round(deltaPercent, 2),
            ConfidenceInterval95LowerDeltaFps: Math.Round(ciLower, 2),
            ConfidenceInterval95UpperDeltaFps: Math.Round(ciUpper, 2),
            WelchTStatistic: Math.Round(tStat, 2),
            DegreesOfFreedom: Math.Round(df, 1),
            MeanP99FrametimeMsA: Math.Round(meanP99A, 3),
            MeanP99FrametimeMsB: Math.Round(meanP99B, 3),
            MeanAverageFpsA: Math.Round(meanAvgFpsA, 1),
            MeanAverageFpsB: Math.Round(meanAvgFpsB, 1)
        );
    }

    private static double CalculateSampleVariance(double[] values, double mean)
    {
        if (values.Length <= 1) return 0.0;
        double sumSq = 0.0;
        foreach (double v in values)
        {
            double d = v - mean;
            sumSq += d * d;
        }
        return sumSq / (values.Length - 1);
    }

    private static double CalculateWelchDegreesOfFreedom(double seSqA, int nA, double seSqB, int nB)
    {
        double numerator = (seSqA + seSqB) * (seSqA + seSqB);
        double denomA = nA > 1 ? (seSqA * seSqA) / (nA - 1) : 0.0;
        double denomB = nB > 1 ? (seSqB * seSqB) / (nB - 1) : 0.0;
        double denominator = denomA + denomB;

        if (denominator <= 1e-12) return Math.Max(1.0, (nA + nB) - 2.0);
        return Math.Max(1.0, numerator / denominator);
    }

    private static double ApproximateTwoTailedStudentTCritical95(double df)
    {
        int roundedDf = (int)Math.Clamp(Math.Round(df), 1, 120);
        return roundedDf switch
        {
            1 => 12.706,
            2 => 4.303,
            3 => 3.182,
            4 => 2.776,
            5 => 2.571,
            6 => 2.447,
            7 => 2.365,
            8 => 2.306,
            9 => 2.262,
            10 => 2.228,
            <= 15 => 2.131,
            <= 20 => 2.086,
            <= 30 => 2.042,
            <= 60 => 2.000,
            _ => 1.960
        };
    }
}
