namespace EvoOptimizer.Infrastructure.Services;

public sealed class WindowsOptimizationAndRollbackService :
    IOptimizationEngine,
    IRecoveryRollbackEngine
{
    private static readonly HashSet<string> ProtectedSystemProcesses = new(StringComparer.OrdinalIgnoreCase)
    {
        "System", "Idle", "Registry", "Memory Compression", "smss", "csrss", "wininit",
        "services", "lsass", "svchost", "fontdrvhost", "dwm", "explorer", "audiodg",
        "spoolsv", "MsMpEng", "SecurityHealthService", "sihost", "taskhostw",
        "StartMenuExperienceHost", "ShellExperienceHost", "SearchHost", "ctfmon",
        "conhost", "WindowsTerminal", "devenv", "dotnet", "EvoOptimizer.App"
    };

    private readonly ILiveTelemetryEngine _telemetryEngine;
    private readonly IHistoricalAnalysisEngine _historicalEngine;
    private readonly List<InterventionTransactionRecord> _transactions = [];

    private bool _isKernelTimerResolutionLockedByEvo;
    private uint _appliedTimerResolution100Ns;

    public WindowsOptimizationAndRollbackService(
        ILiveTelemetryEngine telemetryEngine,
        IHistoricalAnalysisEngine historicalEngine)
    {
        _telemetryEngine = telemetryEngine;
        _historicalEngine = historicalEngine;
    }

    public bool CanExecuteIntervention(AdaptiveDecisionItem decision, out string preflightReason)
    {
        if (decision.Disposition != DecisionDisposition.RecommendedIntervention)
        {
            preflightReason = "La decisión no está marcada como recomendada para la configuración actual.";
            return false;
        }

        if (IsDecisionCurrentlyActive(decision.DecisionId))
        {
            preflightReason = "Esta optimización ya se encuentra activa y monitorizada.";
            return false;
        }

        preflightReason = "Pre-condiciones verificadas.";
        return true;
    }

    public InterventionTransactionRecord ExecuteAndValidateIntervention(
        AdaptiveDecisionItem decision,
        OptimizationObjective objective,
        HardwareSystemProfile hardware)
    {
        SystemTelemetrySnapshot beforeSnap = _telemetryEngine.CaptureSnapshot();
        int beforeScore = EstimateQuickCompositeScore(beforeSnap);

        int currentEvoPid = Environment.ProcessId;
        int foregroundPid = beforeSnap.ActiveForegroundPid;

        var rollbackTokens = new List<ProcessRollbackToken>();
        bool timerAdjustedInThisTx = false;

        if (decision.DecisionId == "MEM-ADAPTIVE-CONTAINMENT")
        {
            ExecuteSelectiveMemoryContainment(currentEvoPid, foregroundPid, rollbackTokens);
        }
        else if (decision.DecisionId is "GPU-UMA-BANDWIDTH-GUARD" or "GPU-DISCRETE-QUEUE-ISOLATION")
        {
            ExecuteBackgroundGraphicsAndQueueContainment(currentEvoPid, foregroundPid, rollbackTokens);
        }
        else if (decision.DecisionId.StartsWith("PROC-SCHEDULER-", StringComparison.OrdinalIgnoreCase))
        {
            ExecuteAdaptiveProcessSchedulerGovernance(currentEvoPid, foregroundPid, objective, rollbackTokens);
        }
        else if (decision.DecisionId == "CPU-CORE0-INTERRUPT-SHIELD")
        {
            ExecuteCoreZeroInterruptShielding(currentEvoPid, foregroundPid, hardware.LogicalCoreCount, rollbackTokens);
        }
        else if (decision.DecisionId == "TIMER-KERNEL-HIGH-PRECISION")
        {
            timerAdjustedInThisTx = ExecuteKernelTimerPrecisionAdjustment(rollbackTokens);
        }

        Thread.Sleep(120);

        SystemTelemetrySnapshot afterSnap = _telemetryEngine.CaptureSnapshot();
        int afterScore = EstimateQuickCompositeScore(afterSnap);

        double freedMemoryMb = Math.Max(0.0, (afterSnap.PhysicalMemoryAvailableGb - beforeSnap.PhysicalMemoryAvailableGb) * 1024.0);
        double cpuDelta = afterSnap.CpuTotalUtilizationPercent - beforeSnap.CpuTotalUtilizationPercent;
        int scoreDelta = afterScore - beforeScore;

        InterventionExecutionState finalState;
        string summary;

        bool regressionDetected = scoreDelta <= -5 && freedMemoryMb < 10.0 && !timerAdjustedInThisTx;

        if (regressionDetected && rollbackTokens.Count > 0)
        {
            RestoreProcessTokens(rollbackTokens, decision.DecisionId);
            finalState = InterventionExecutionState.AutoRolledBackRegression;
            summary = $"AUTO-REVERTIDO POR REGRESIÓN: No se observó mejora neta (Δ Score: {scoreDelta}). Se restauró el estado original.";
        }
        else if (timerAdjustedInThisTx)
        {
            finalState = InterventionExecutionState.ValidatedEffective;
            summary = $"TIMER KERNEL SINCRONIZADO: Resolución de reloj pasó de {beforeSnap.CurrentKernelTimerResolutionMs:F3} ms a {afterSnap.CurrentKernelTimerResolutionMs:F3} ms | P99 (1% Low): {afterSnap.SchedulerOnePercentLowMs:F3} ms.";
        }
        else if (decision.DecisionId == "CPU-CORE0-INTERRUPT-SHIELD" && rollbackTokens.Count > 0)
        {
            finalState = InterventionExecutionState.ValidatedEffective;
            summary = $"BLINDAJE CORE-0 ACTIVO: {rollbackTokens.Count} procesos de fondo desplazados fuera de CPU 0/1 e I/O en prioridad baja | P99 (1% Low): {afterSnap.SchedulerOnePercentLowMs:F3} ms.";
        }
        else if (rollbackTokens.Count > 0 && (freedMemoryMb >= 10.0 || scoreDelta >= 0 || cpuDelta <= 1.5))
        {
            finalState = InterventionExecutionState.ValidatedEffective;
            summary = $"VALIDADO CON ÉXITO: {rollbackTokens.Count} procesos contenidos (CPU + I/O + EcoQoS) | RAM Liberada: +{freedMemoryMb:F0} MB | P99: {afterSnap.SchedulerOnePercentLowMs:F3} ms.";
        }
        else
        {
            finalState = InterventionExecutionState.AppliedMinimalGain;
            summary = $"APLICADO (IMPACTO LEVE): {rollbackTokens.Count} procesos ajustados | RAM Liberada: +{freedMemoryMb:F0} MB | Sistema estable.";
        }

        var record = new InterventionTransactionRecord(
            TransactionId: Guid.NewGuid(),
            DecisionId: decision.DecisionId,
            DecisionTitle: decision.Title,
            Objective: objective,
            ExecutedAt: DateTimeOffset.Now,
            ExecutionState: finalState,
            TouchedProcessCount: rollbackTokens.Count,
            BeforeAvailableRamGb: beforeSnap.PhysicalMemoryAvailableGb,
            AfterAvailableRamGb: afterSnap.PhysicalMemoryAvailableGb,
            FreedMemoryMb: Math.Round(freedMemoryMb, 1),
            BeforeCpuPercent: beforeSnap.CpuTotalUtilizationPercent,
            AfterCpuPercent: afterSnap.CpuTotalUtilizationPercent,
            BeforeJitterMs: beforeSnap.SchedulerOnePercentLowMs,
            AfterJitterMs: afterSnap.SchedulerOnePercentLowMs,
            BeforeCompositeScore: beforeScore,
            AfterCompositeScore: afterScore,
            ValidationSummary: summary,
            RollbackTokens: rollbackTokens
        );

        _transactions.Insert(0, record);
        _historicalEngine.RecordEmpiricalOutcome(record);

        return record;
    }

    public IReadOnlyList<InterventionTransactionRecord> GetTransactionHistory() => _transactions.AsReadOnly();

    public bool IsDecisionCurrentlyActive(string decisionId)
    {
        return _transactions.Any(t => t.DecisionId == decisionId && t.IsCurrentlyActive);
    }

    public bool RevertTransactionByDecisionId(string decisionId, out string rollbackMessage)
    {
        int idx = _transactions.FindIndex(t => t.DecisionId == decisionId && t.IsCurrentlyActive);
        if (idx < 0)
        {
            rollbackMessage = "No hay ninguna transacción activa para este identificador.";
            return false;
        }

        var current = _transactions[idx];
        int restoredCount = RestoreProcessTokens(current.RollbackTokens, current.DecisionId);

        _transactions[idx] = current with
        {
            ExecutionState = InterventionExecutionState.RevertedByUser,
            ValidationSummary = $"REVERTIDO POR EL USUARIO: Se restauró la configuración previa ({restoredCount} tokens revertidos)."
        };

        rollbackMessage = $"Reversión completada ({restoredCount} elementos restaurados).";
        return true;
    }

    public int RevertAllActiveTransactions()
    {
        int totalRestoredTransactions = 0;

        for (int i = 0; i < _transactions.Count; i++)
        {
            if (_transactions[i].IsCurrentlyActive)
            {
                int restoredProcs = RestoreProcessTokens(_transactions[i].RollbackTokens, _transactions[i].DecisionId);
                _transactions[i] = _transactions[i] with
                {
                    ExecutionState = InterventionExecutionState.RevertedByUser,
                    ValidationSummary = $"REVERTIDO GLOBALMENTE: {restoredProcs} elementos devueltos a su estado previo."
                };
                totalRestoredTransactions++;
            }
        }

        return totalRestoredTransactions;
    }

    /// <summary>
    /// Desplaza la afinidad de procesos pesados en segundo plano fuera de los hilos lógicos 0 y 1
    /// (donde el kernel de Windows despacha interrupciones DPC/ISR críticas de GPU, Red y USB).
    /// </summary>
    private static void ExecuteCoreZeroInterruptShielding(
        int currentEvoPid,
        int foregroundPid,
        int logicalCoreCount,
        List<ProcessRollbackToken> rollbackTokens)
    {
        if (logicalCoreCount < 8) return;

        int cappedCores = Math.Min(62, logicalCoreCount);
        long allCoresMask = (1L << cappedCores) - 1L;
        // Excluir CPU 0 y CPU 1 (bits 0 y 1 -> ~0x3L)
        long shieldedBackgroundMask = allCoresMask & ~0x3L;

        if (shieldedBackgroundMask == 0) return;

        Process[] processes = Process.GetProcesses();
        foreach (var proc in processes)
        {
            try
            {
                if (!IsCandidateBackgroundProcess(proc, currentEvoPid, foregroundPid))
                    continue;

                double wsMb = proc.WorkingSet64 / (1024.0 * 1024.0);
                int threads = proc.Threads.Count;
                if (wsMb < 45.0 && threads < 10)
                    continue;

                long originalAffinity = proc.ProcessorAffinity;
                int originalPriority = (int)proc.PriorityClass;
                int originalIoPrio = QueryProcessIoPriority(proc.Handle);

                // Aplicar máscara sin CPU 0/1 y reducir prioridad de I/O para no saturar NVMe
                proc.ProcessorAffinity = (nint)shieldedBackgroundMask;
                bool ioModified = TrySetProcessIoPriority(proc.Handle, ioPriority: 1); // 1 = Low I/O Priority

                rollbackTokens.Add(new ProcessRollbackToken(
                    ProcessId: proc.Id,
                    ProcessName: proc.ProcessName,
                    OriginalPriorityClassValue: originalPriority,
                    OriginalAffinityMask: originalAffinity,
                    AffinityModified: true,
                    OriginalIoPriority: originalIoPrio,
                    IoPriorityModified: ioModified,
                    EcoQosApplied: false,
                    WorkingSetBeforeMb: Math.Round(wsMb, 1)
                ));
            }
            catch { }
            finally
            {
                proc.Dispose();
            }
        }
    }

    private bool ExecuteKernelTimerPrecisionAdjustment(List<ProcessRollbackToken> rollbackTokens)
    {
        try
        {
            int status = Win32NativeMethods.NtQueryTimerResolution(
                out _,
                out uint minRes100Ns,
                out uint currentRes100Ns);

            if (status == 0)
            {
                uint target100Ns = Math.Max(minRes100Ns, 5_000u);
                int setStatus = Win32NativeMethods.NtSetTimerResolution(target100Ns, setResolution: true, out _);
                if (setStatus == 0)
                {
                    _isKernelTimerResolutionLockedByEvo = true;
                    _appliedTimerResolution100Ns = target100Ns;

                    rollbackTokens.Add(new ProcessRollbackToken(
                        ProcessId: Environment.ProcessId,
                        ProcessName: "ntdll!KernelTimerResolution",
                        OriginalPriorityClassValue: (int)currentRes100Ns,
                        OriginalAffinityMask: 0,
                        AffinityModified: false,
                        OriginalIoPriority: 2,
                        IoPriorityModified: false,
                        EcoQosApplied: false,
                        WorkingSetBeforeMb: currentRes100Ns / 10_000.0
                    ));
                    return true;
                }
            }
        }
        catch { }

        return false;
    }

    private static void ExecuteSelectiveMemoryContainment(
        int currentEvoPid,
        int foregroundPid,
        List<ProcessRollbackToken> rollbackTokens)
    {
        Process[] processes = Process.GetProcesses();
        foreach (var proc in processes)
        {
            try
            {
                if (!IsCandidateBackgroundProcess(proc, currentEvoPid, foregroundPid))
                    continue;

                double wsMb = proc.WorkingSet64 / (1024.0 * 1024.0);
                if (wsMb < 45.0)
                    continue;

                int originalPriority = (int)proc.PriorityClass;
                bool trimmed = Win32NativeMethods.EmptyWorkingSet(proc.Handle);

                if (trimmed)
                {
                    rollbackTokens.Add(new ProcessRollbackToken(
                        ProcessId: proc.Id,
                        ProcessName: proc.ProcessName,
                        OriginalPriorityClassValue: originalPriority,
                        OriginalAffinityMask: 0,
                        AffinityModified: false,
                        OriginalIoPriority: 2,
                        IoPriorityModified: false,
                        EcoQosApplied: false,
                        WorkingSetBeforeMb: Math.Round(wsMb, 1)
                    ));
                }
            }
            catch { }
            finally
            {
                proc.Dispose();
            }
        }
    }

    private static void ExecuteBackgroundGraphicsAndQueueContainment(
        int currentEvoPid,
        int foregroundPid,
        List<ProcessRollbackToken> rollbackTokens)
    {
        Process[] processes = Process.GetProcesses();
        foreach (var proc in processes)
        {
            try
            {
                if (!IsCandidateBackgroundProcess(proc, currentEvoPid, foregroundPid))
                    continue;

                double wsMb = proc.WorkingSet64 / (1024.0 * 1024.0);
                if (wsMb < 60.0)
                    continue;

                ProcessPriorityClass currentPrio = proc.PriorityClass;
                if (currentPrio == ProcessPriorityClass.Normal)
                {
                    int origIo = QueryProcessIoPriority(proc.Handle);
                    proc.PriorityClass = ProcessPriorityClass.BelowNormal;
                    bool ecoApplied = TrySetProcessEcoQos(proc.Handle, enableEcoQos: true);
                    bool ioMod = TrySetProcessIoPriority(proc.Handle, ioPriority: 1);
                    _ = Win32NativeMethods.EmptyWorkingSet(proc.Handle);

                    rollbackTokens.Add(new ProcessRollbackToken(
                        ProcessId: proc.Id,
                        ProcessName: proc.ProcessName,
                        OriginalPriorityClassValue: (int)currentPrio,
                        OriginalAffinityMask: 0,
                        AffinityModified: false,
                        OriginalIoPriority: origIo,
                        IoPriorityModified: ioMod,
                        EcoQosApplied: ecoApplied,
                        WorkingSetBeforeMb: Math.Round(wsMb, 1)
                    ));
                }
            }
            catch { }
            finally
            {
                proc.Dispose();
            }
        }
    }

    private static void ExecuteAdaptiveProcessSchedulerGovernance(
        int currentEvoPid,
        int foregroundPid,
        OptimizationObjective objective,
        List<ProcessRollbackToken> rollbackTokens)
    {
        Process[] processes = Process.GetProcesses();
        foreach (var proc in processes)
        {
            try
            {
                if (!IsCandidateBackgroundProcess(proc, currentEvoPid, foregroundPid))
                    continue;

                int threads = proc.Threads.Count;
                double wsMb = proc.WorkingSet64 / (1024.0 * 1024.0);

                if (threads < 12 && wsMb < 50.0)
                    continue;

                ProcessPriorityClass currentPrio = proc.PriorityClass;
                if (currentPrio is ProcessPriorityClass.Normal or ProcessPriorityClass.AboveNormal)
                {
                    int origIo = QueryProcessIoPriority(proc.Handle);
                    proc.PriorityClass = ProcessPriorityClass.BelowNormal;
                    bool ecoApplied = TrySetProcessEcoQos(proc.Handle, enableEcoQos: true);
                    bool ioMod = TrySetProcessIoPriority(proc.Handle, ioPriority: 1);

                    if (objective != OptimizationObjective.EverydayUse && wsMb > 80.0)
                    {
                        _ = Win32NativeMethods.EmptyWorkingSet(proc.Handle);
                    }

                    rollbackTokens.Add(new ProcessRollbackToken(
                        ProcessId: proc.Id,
                        ProcessName: proc.ProcessName,
                        OriginalPriorityClassValue: (int)currentPrio,
                        OriginalAffinityMask: 0,
                        AffinityModified: false,
                        OriginalIoPriority: origIo,
                        IoPriorityModified: ioMod,
                        EcoQosApplied: ecoApplied,
                        WorkingSetBeforeMb: Math.Round(wsMb, 1)
                    ));
                }
            }
            catch { }
            finally
            {
                proc.Dispose();
            }
        }
    }

    private static bool IsCandidateBackgroundProcess(Process proc, int currentEvoPid, int foregroundPid)
    {
        if (proc.Id <= 4 || proc.Id == currentEvoPid || proc.Id == foregroundPid)
            return false;

        if (ProtectedSystemProcesses.Contains(proc.ProcessName))
            return false;

        return true;
    }

    private int RestoreProcessTokens(IReadOnlyList<ProcessRollbackToken> tokens, string decisionId)
    {
        if (decisionId == "TIMER-KERNEL-HIGH-PRECISION" && _isKernelTimerResolutionLockedByEvo)
        {
            try
            {
                _ = Win32NativeMethods.NtSetTimerResolution(_appliedTimerResolution100Ns, setResolution: false, out _);
                _isKernelTimerResolutionLockedByEvo = false;
                return 1;
            }
            catch
            {
                return 0;
            }
        }

        int restored = 0;
        foreach (var token in tokens)
        {
            try
            {
                using var proc = Process.GetProcessById(token.ProcessId);
                if (!proc.ProcessName.Equals(token.ProcessName, StringComparison.OrdinalIgnoreCase))
                    continue;

                proc.PriorityClass = (ProcessPriorityClass)token.OriginalPriorityClassValue;

                if (token.AffinityModified && token.OriginalAffinityMask != 0)
                {
                    proc.ProcessorAffinity = (nint)token.OriginalAffinityMask;
                }

                if (token.IoPriorityModified)
                {
                    _ = TrySetProcessIoPriority(proc.Handle, token.OriginalIoPriority);
                }

                if (token.EcoQosApplied)
                {
                    _ = TrySetProcessEcoQos(proc.Handle, enableEcoQos: false);
                }

                restored++;
            }
            catch { }
        }

        return restored;
    }

    private static int QueryProcessIoPriority(nint processHandle)
    {
        try
        {
            int status = Win32NativeMethods.NtQueryInformationProcess(
                processHandle,
                Win32NativeMethods.ProcessIoPriorityClass,
                out int ioPrio,
                sizeof(int),
                out _);

            if (status == 0) return ioPrio;
        }
        catch { }

        return 2; // 2 = IoPriorityNormal en Windows
    }

    private static bool TrySetProcessIoPriority(nint processHandle, int ioPriority)
    {
        try
        {
            int status = Win32NativeMethods.NtSetInformationProcess(
                processHandle,
                Win32NativeMethods.ProcessIoPriorityClass,
                ref ioPriority,
                sizeof(int));

            return status == 0;
        }
        catch
        {
            return false;
        }
    }

    private static bool TrySetProcessEcoQos(nint processHandle, bool enableEcoQos)
    {
        try
        {
            var state = new Win32NativeMethods.PROCESS_POWER_THROTTLING_STATE
            {
                Version = Win32NativeMethods.PROCESS_POWER_THROTTLING_CURRENT_VERSION,
                ControlMask = Win32NativeMethods.PROCESS_POWER_THROTTLING_EXECUTION_SPEED,
                StateMask = enableEcoQos ? Win32NativeMethods.PROCESS_POWER_THROTTLING_EXECUTION_SPEED : 0u
            };

            return Win32NativeMethods.SetProcessInformation(
                processHandle,
                Win32NativeMethods.ProcessPowerThrottlingInformationClass,
                ref state,
                Marshal.SizeOf<Win32NativeMethods.PROCESS_POWER_THROTTLING_STATE>());
        }
        catch
        {
            return false;
        }
    }

    private static int EstimateQuickCompositeScore(SystemTelemetrySnapshot telemetry)
    {
        double commitPenalty = Math.Max(0, telemetry.CommitChargePercent - 55.0) * 1.1;
        double cpuBusyPenalty = telemetry.CpuTotalUtilizationPercent * 0.45;
        double p99Penalty = Math.Min(12.0, telemetry.SchedulerOnePercentLowMs * 4.5);
        double ramBonus = Math.Min(14.0, telemetry.PhysicalMemoryAvailableGb * 1.1);
        double raw = 89.0 - (commitPenalty * 0.35) - (cpuBusyPenalty * 0.35) - p99Penalty + ramBonus;
        return (int)Math.Clamp(Math.Round(raw), 25, 99);
    }
