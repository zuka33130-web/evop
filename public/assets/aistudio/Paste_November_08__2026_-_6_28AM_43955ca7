using EvoOptimizer.Core.Engine;
using EvoOptimizer.Core.Models;
using Xunit;

namespace EvoOptimizer.Tests;

public sealed class FrametimeMathCalculatorTests
{
    [Fact]
    public void ComputeMetrics_WhenEmptySamples_ReturnsInsufficientInformation()
    {
        var result = FrametimeMathCalculator.ComputeMetricsFromSamples(
            "TestEmpty", "cs2.exe", "Empty", [], 140, 8.5);

        Assert.Equal(BenchmarkCaptureStatus.InsufficientSampleCount, result.Status);
        Assert.Null(result.AverageFps);
        Assert.Null(result.OnePercentLowAverageFps);
        Assert.Null(result.PointOnePercentLowAverageFps);
        Assert.Contains("Información insuficiente", result.StatusExplanation);
    }

    [Fact]
    public void ComputeMetrics_WhenValid150Frames_ComputesOnePercentLow_ButBlocksPointOnePercentLow()
    {
        var samples = new List<FramePresentationSample>();
        double t = 0.0;

        // 3 segundos de warmup + 300 cuadros válidos (menos de 1000 para probar la compuerta de 0.1% low)
        for (int i = 0; i < 400; i++)
        {
            double ftMs = (i % 100 == 0) ? 20.0 : 5.0; // 99% de cuadros a 5ms (200 FPS), 1% a 20ms (50 FPS)
            t += ftMs / 1000.0;
            samples.Add(new FramePresentationSample(i, t, ftMs, 0.5, 4.2, ftMs, IsDropped: false, "Hardware: Independent Flip"));
        }

        var result = FrametimeMathCalculator.ComputeMetricsFromSamples(
            "GroupA", "cs2.exe", "Mirage", samples, 130, 9.2, warmupSeconds: 0.5);

        Assert.Equal(BenchmarkCaptureStatus.ValidCapture, result.Status);
        Assert.NotNull(result.AverageFps);
        Assert.NotNull(result.OnePercentLowAverageFps);
        Assert.Equal(50.0, result.OnePercentLowPercentileFps!.Value, precision: 1);

        // Como N < 1000, el 0.1% low debe ser null con aviso explícito
        Assert.Null(result.PointOnePercentLowAverageFps);
        Assert.Contains("Información insuficiente para 0.1% low", result.PointOnePercentLowNotice);
    }

    [Fact]
    public void ComputeMetrics_When1200ValidFrames_ComputesPointOnePercentLowCorrectly()
    {
        var samples = new List<FramePresentationSample>();
        double t = 0.0;

        for (int i = 0; i < 1200; i++)
        {
            double ftMs = (i == 1199) ? 25.0 : 5.0;
            t += ftMs / 1000.0;
            samples.Add(new FramePresentationSample(i, t, ftMs, 0.4, 4.0, ftMs, IsDropped: false, "Flip"));
        }

        var result = FrametimeMathCalculator.ComputeMetricsFromSamples(
            "GroupA", "cs2.exe", "Dust2", samples, 120, 10.0, warmupSeconds: 0.0);

        Assert.Equal(BenchmarkCaptureStatus.ValidCapture, result.Status);
        Assert.Equal(1200, result.ValidEvaluatedFrames);
        Assert.NotNull(result.PointOnePercentLowAverageFps);
        Assert.NotNull(result.P99Point9FrametimeMs);
    }
}
