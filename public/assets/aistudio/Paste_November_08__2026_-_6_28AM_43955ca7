namespace EvoOptimizer.Tests;

public sealed class AbStatisticalComparisonEngineTests
{
    [Fact]
    public void CompareConfigurationRuns_WhenSingleRunPerGroup_AlwaysReturnsInconclusive()
    {
        var engine = new AbStatisticalComparisonEngine();
        var runA = CreateSyntheticValidRun("A", "cs2.exe", onePercentLowFps: 110.0, p99Ms: 9.1, avgFps: 185.0);
        var runB = CreateSyntheticValidRun("B", "cs2.exe", onePercentLowFps: 145.0, p99Ms: 6.9, avgFps: 195.0);

        var report = engine.CompareConfigurationRuns("Baseline A", [runA], "Candidate B", [runB]);

        Assert.Equal(ComparisonVerdict.Inconclusive, report.Verdict);
        Assert.Contains("Una sola corrida nunca constituye prueba concluyente", report.StatisticalJustification);
    }

    [Fact]
    public void CompareConfigurationRuns_WhenConsistentMultiRunImprovement_ReturnsImprovement()
    {
        var engine = new AbStatisticalComparisonEngine();

        var runsA = new[]
        {
            CreateSyntheticValidRun("A", "cs2.exe", 112.0, 8.9, 178.0),
            CreateSyntheticValidRun("A", "cs2.exe", 114.0, 8.7, 180.0),
            CreateSyntheticValidRun("A", "cs2.exe", 111.5, 9.0, 177.0)
        };

        var runsB = new[]
        {
            CreateSyntheticValidRun("B", "cs2.exe", 129.0, 7.7, 188.0),
            CreateSyntheticValidRun("B", "cs2.exe", 131.0, 7.6, 190.0),
            CreateSyntheticValidRun("B", "cs2.exe", 128.5, 7.8, 187.5)
        };

        var report = engine.CompareConfigurationRuns("Baseline A", runsA, "Candidate B", runsB);

        Assert.Equal(ComparisonVerdict.Improvement, report.Verdict);
        Assert.True(report.ConfidenceInterval95LowerDeltaFps > 0);
    }

    private static RealFrametimeBenchmarkRun CreateSyntheticValidRun(
