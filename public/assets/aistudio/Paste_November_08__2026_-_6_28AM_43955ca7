        ISystemIntelligenceEngine systemEngine,
        ILiveTelemetryEngine telemetryEngine,
        IAdaptiveDecisionEngine legacyDecisionEngine,
        IHistoricalAnalysisEngine historicalEngine,
        IHybridSiliconAndCs2ProbeService hybridCs2Probe,
        IPresentMonBenchmarkService presentMonService,
        IAbStatisticalComparisonEngine abEngine,
        ISafeTransactionalInterventionService safeInterventionService,
        IWindowsInternalsCatalogService internalsCatalogService,
        EvidenceBasedAdaptiveEngine evidenceAdaptiveEngine)
    {
        _hardwareEngine = hardwareEngine;
        _systemEngine = systemEngine;
        _telemetryEngine = telemetryEngine;
        _legacyDecisionEngine = legacyDecisionEngine;
        _historicalEngine = historicalEngine;
        _hybridCs2Probe = hybridCs2Probe;
        _presentMonService = presentMonService;
        _abEngine = abEngine;
        _safeInterventionService = safeInterventionService;
        _internalsCatalogService = internalsCatalogService;
        _evidenceAdaptiveEngine = evidenceAdaptiveEngine;

        _hardwareProfile = _hardwareEngine.InspectHardwareProfile();
        _hybridTopology = _hybridCs2Probe.InspectHybridTopology();
        _kernelProfile = _systemEngine.InspectKernelAndGamingProfile();

        foreach (var entry in _internalsCatalogService.GetAuditedMechanismsCatalog())
        {
            AuditedInternalsCatalog.Add(entry);
        }

        for (int i = 0; i < MaxHistorySamples; i++)
        {
            _cpuHistory.Add(0);
            _ramHistory.Add(0);
        }

        CaptureLiveGroupACommand = new RelayCommand(async () => await ExecuteLiveCaptureAsync(isGroupA: true));
        CaptureLiveGroupBCommand = new RelayCommand(async () => await ExecuteLiveCaptureAsync(isGroupA: false));
        ImportPresentMonCsvToACommand = new RelayCommand(() => ExecuteImportPresentMonCsv(isGroupA: true));
        ImportPresentMonCsvToBCommand = new RelayCommand(() => ExecuteImportPresentMonCsv(isGroupA: false));
        ClearAbRunsCommand = new RelayCommand(ExecuteClearAbRuns);
        VerifyAllExternalDriftCommand = new RelayCommand(ExecuteVerifyExternalDrift);
        RevertAllSafeOperationsCommand = new RelayCommand(ExecuteRevertAllOperations);
        ExportAuditJsonCommand = new RelayCommand(ExecuteExportAuditJson);

        ExecuteTelemetryCycle(forceRefreshRecommendations: true);

        _telemetryTimer = new DispatcherTimer(DispatcherPriority.Background)
        {
            Interval = TimeSpan.FromSeconds(1.0)
        };
        _telemetryTimer.Tick += (_, _) => ExecuteTelemetryCycle(forceRefreshRecommendations: false);
        _telemetryTimer.Start();
    }

