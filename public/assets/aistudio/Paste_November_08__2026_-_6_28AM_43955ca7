namespace EvoOptimizer.Core.Models;

/// <summary>
/// Escenario objetivo elegido por el usuario. El motor adaptativo traduce este objetivo
/// en estrategias específicas según las capacidades reales del hardware.
/// </summary>
public enum OptimizationObjective
{
    EverydayUse = 0,        // Prioriza eficiencia, baja carga de fondo, salud térmica y estabilidad
    Gaming = 1,             // Prioriza consistencia de frametime (1% lows), latencia de despacho y presión de RAM
    MaxPerformance = 2      // Prioriza rendimiento bruto de cómputo, disponibilidad de hilos e I/O
}

/// <summary>
/// Clasificación real de la capacidad de memoria instalada para evitar aplicar
/// políticas universales dañinas.
/// </summary>
public enum MemoryCapacityTier
{
    Constrained_8GBOrLess,  // Requiere contención estricta de procesos y vigilancia de paginación
    Balanced_12To16GB,      // Requiere gestión moderada bajo cargas de gaming pesado
    Abundant_32GBPlus       // Prohibido vaciar Standby List agresivamente; se prioriza caché en RAM
}

public enum GpuArchitectureTier
{
    UnknownOrBasic,
    IntegratedSharedMemory, // Usa RAM del sistema como VRAM: crítico proteger ancho de banda y capacidad RAM
    DedicatedDiscrete       // Posee VRAM propia dedicada
}

public enum SensorCalibrationState
{
    CalibratedRealTime,     // Medición directa verificada desde el SO / Kernel
    EstimatedFromCounters,  // Derivado de contadores secundarios del sistema
    ProviderNotAttached     // Sensor aún no conectado (ej. Ring-0 térmico o ETW en reposo); no se inventan datos
}

public enum BottleneckSubsystem
{
    NoneNominal,
    CpuComputeSaturation,
    MemoryPhysicalPressure,
    MemoryCommitExhaustion,
    StorageSpaceCritical,
    ProcessEcosystemSprawl,
    ThermalTelemetryUnverified
}

public enum DecisionDisposition
{
    RecommendedIntervention,    // Ajuste propuesto y compatible con este hardware
    SuppressedNotBeneficial,    // Ajuste genérico RECHAZADO explícitamente porque dañaría o no ayudaría a este PC
    LockedBySensorUncertainty,  // Ajuste bloqueado por seguridad hasta tener telemetría verificada (ej. térmica)
    SystemAlreadyOptimal        // El subsistema ya opera en su punto ideal para el escenario elegido
}

public enum InterventionRiskLevel
{
    ZeroRisk_Informational,
    LowRisk_SessionReversible,
    ModerateRisk_TransactionalState
}
