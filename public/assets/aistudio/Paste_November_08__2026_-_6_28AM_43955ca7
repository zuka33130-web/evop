namespace EvoOptimizer.Infrastructure.Services;

public sealed class WindowsLiveTelemetryService :
    ILiveTelemetryEngine,
    ICpuIntelligenceEngine,
    IProcessIntelligenceEngine,
    IThermalIntelligenceEngine
{
    private readonly IStorageIntelligenceEngine _storageEngine;
    private readonly IGamingIntelligenceEngine _gamingEngine;
    private readonly IBenchmarkFrametimeEngine _frametimeEngine;

    private ulong _previousIdleTicks;
    private ulong _previousTotalTicks;
    private double _lastCpuPercent;

    private DateTimeOffset _lastProcessAuditTime = DateTimeOffset.MinValue;
    private int _cachedProcessCount;
    private int _cachedThreadCount;
    private IReadOnlyList<ProcessResourceSample> _cachedTopProcesses = [];

    public WindowsLiveTelemetryService(
        IStorageIntelligenceEngine storageEngine,
        IGamingIntelligenceEngine gamingEngine,
        IBenchmarkFrametimeEngine frametimeEngine)
    {
        _storageEngine = storageEngine;
        _gamingEngine = gamingEngine;
        _frametimeEngine = frametimeEngine;
        _ = MeasureCpuUtilizationPercent();
    }

    public SystemTelemetrySnapshot CaptureSnapshot()
    {
        double cpuPercent = MeasureCpuUtilizationPercent();
        var (currentMhz, maxMhz, limitMhz, isThrottled) = ProbeCpuFrequencyAndThrottling();

        var memStatus = Win32NativeMethods.MEMORYSTATUSEX.Create();
        double totalPhysGb = 0;
        double availPhysGb = 0;
        double usedPhysGb = 0;
        double memLoadPercent = 0;
        double commitTotalGb = 0;
        double commitLimitGb = 0;
        double commitPercent = 0;

        if (Win32NativeMethods.GlobalMemoryStatusEx(ref memStatus))
        {
            const double bytesToGb = 1024.0 * 1024.0 * 1024.0;
            totalPhysGb = memStatus.ullTotalPhys / bytesToGb;
            availPhysGb = memStatus.ullAvailPhys / bytesToGb;
            usedPhysGb = Math.Max(0, totalPhysGb - availPhysGb);
            memLoadPercent = memStatus.dwMemoryLoad;

            commitLimitGb = memStatus.ullTotalPageFile / bytesToGb;
            double availCommitGb = memStatus.ullAvailPageFile / bytesToGb;
            commitTotalGb = Math.Max(0, commitLimitGb - availCommitGb);
            commitPercent = commitLimitGb > 0 ? (commitTotalGb / commitLimitGb) * 100.0 : 0.0;
        }

        var (_, _, _, freeDriveGb, freeDrivePercent) = _storageEngine.InspectSystemVolume();
        var (procCount, threadCount, topConsumers) = InspectProcessEcosystem(5);
        var (thermalState, packageTemp) = ProbeThermalState();
        var (frametimeState, meanJitterMs, p99OnePercentLowMs, p999PointOnePercentLowMs) = _frametimeEngine.MeasureSchedulerStability();
        var (_, _, currentTimerResMs) = WindowsHardwareIntelligenceService.QueryKernelTimerResolutionMs();
        var (fgPid, fgName, isHeavyWorkload) = _gamingEngine.InspectForegroundWorkload();

        return new SystemTelemetrySnapshot(
            Timestamp: DateTimeOffset.Now,
            CpuTotalUtilizationPercent: Math.Round(cpuPercent, 1),
            CpuCurrentClockMhz: currentMhz,
            CpuMaxClockMhz: maxMhz,
            CpuLimitClockMhz: limitMhz,
            IsCpuPowerOrThermalThrottled: isThrottled,
            PhysicalMemoryUsedGb: Math.Round(usedPhysGb, 2),
            PhysicalMemoryAvailableGb: Math.Round(availPhysGb, 2),
            PhysicalMemoryLoadPercent: Math.Round(memLoadPercent, 1),
            CommitChargeTotalGb: Math.Round(commitTotalGb, 2),
            CommitChargeLimitGb: Math.Round(commitLimitGb, 2),
            CommitChargePercent: Math.Round(commitPercent, 1),
            SystemDriveFreeGb: Math.Round(freeDriveGb, 1),
            SystemDriveFreePercent: Math.Round(freeDrivePercent, 1),
            TotalRunningProcesses: procCount,
            TotalSystemThreads: threadCount,
            TopMemoryConsumers: topConsumers,
            ThermalSensorState: thermalState,
            CpuPackageTempCelsius: packageTemp,
            FrametimeSensorState: frametimeState,
            SchedulerTimerJitterMs: meanJitterMs,
            SchedulerOnePercentLowMs: p99OnePercentLowMs,
            SchedulerPointOnePercentLowMs: p999PointOnePercentLowMs,
            CurrentKernelTimerResolutionMs: currentTimerResMs,
            ActiveForegroundPid: fgPid,
            ActiveForegroundProcessName: fgName,
            IsHeavyForegroundWorkloadDetected: isHeavyWorkload
        );
