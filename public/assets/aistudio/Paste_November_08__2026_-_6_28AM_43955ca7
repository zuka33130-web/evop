        if (_selectedObjective == OptimizationObjective.EverydayUse)
        {
            if (_rollbackEngine.IsDecisionCurrentlyActive("TIMER-KERNEL-HIGH-PRECISION"))
                _ = _rollbackEngine.RevertTransactionByDecisionId("TIMER-KERNEL-HIGH-PRECISION", out _);

            if (_rollbackEngine.IsDecisionCurrentlyActive("CPU-CORE0-INTERRUPT-SHIELD"))
                _ = _rollbackEngine.RevertTransactionByDecisionId("CPU-CORE0-INTERRUPT-SHIELD", out _);

