using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Core.Engine;

/// <summary>
/// Motor de razonamiento adaptativo basado en evidencia real.
/// - No emite porcentajes de confianza arbitrarios.
/// - Responde "Información insuficiente" cuando no existen mediciones verificables.
/// - Calibrado para arquitecturas híbridas (Intel Core i3-1220P: 2 P-Cores + 8 E-Cores, Intel UHD UMA).
/// </summary>
public sealed class EvidenceBasedAdaptiveEngine
{
    public IReadOnlyList<EvidenceBasedRecommendation> EvaluateRecommendations(
        HardwareSystemProfile hardware,
        HybridCpuTopologyProfile hybridTopology,
        SystemTelemetrySnapshot systemTelemetry,
        Cs2ProcessTelemetry cs2Telemetry,
        IReadOnlyList<ProcessIdentity> controllableBackgroundProcesses,
        RealFrametimeBenchmarkRun? latestBenchmarkRun,
        IReadOnlyList<HistoricalDecisionOutcome> empiricalHistory)
    {
        var list = new List<EvidenceBasedRecommendation>();

        // 1. EVALUACIÓN DE TELEMETRÍA EN JUEGO (CS2)
        if (!cs2Telemetry.IsRunning && (latestBenchmarkRun is null || latestBenchmarkRun.Status != BenchmarkCaptureStatus.ValidCapture))
        {
            list.Add(new EvidenceBasedRecommendation(
                RecommendationId: "DIAG-CS2-NOT-RUNNING",
                Title: "Información insuficiente para diagnóstico de frametime en CS2",
                TargetSubsystem: "PRESENTMON / CS2 TELEMETRY",
                EvidenceState: EvidenceSufficiencyState.InsufficientInformation,
                EvidenceStatement: "Información insuficiente: Counter-Strike 2 (cs2.exe) no está en ejecución ni existe una captura PresentMon válida cargada.",
                BottleneckDiagnosis: "Sin telemetría de presentación activa no se puede determinar si la limitación reside en los 64 EUs de la Intel UHD Graphics o en los 2 P-Cores del i3-1220P.",
                ProposedMechanism: "Ninguna modificación (solo monitoreo pasivo).",
                TargetResourceDescription: "Proceso cs2.exe (Inactivo)",
                TargetProcessIdentity: null,
                RequiresExplicitUserConsent: false,
                IsReversible: true,
                VerificationProtocol: "Inicie Counter-Strike 2 o importe un registro CSV de PresentMon para habilitar el análisis.",
                RollbackProtocol: "N/A (Sin cambios aplicados)"
            ));
        }
        else if (latestBenchmarkRun is { Status: BenchmarkCaptureStatus.ValidCapture })
        {
            bool gpuBound = latestBenchmarkRun.GpuBusyRatioPercent is >= 88.0;
            string bottleneckDiag = gpuBound
                ? $"Limitación primaria en iGPU Intel UHD Graphics (GPU Busy = {latestBenchmarkRun.GpuBusyRatioPercent:F1}%, P99 = {latestBenchmarkRun.P99FrametimeMs:F2} ms, 1% Low = {latestBenchmarkRun.OnePercentLowAverageFps:F1} FPS)."
                : $"Limitación de planificación de CPU / Memoria compartida UMA (P99 = {latestBenchmarkRun.P99FrametimeMs:F2} ms, Stutters = {latestBenchmarkRun.StutterSpikeCount}, 1% Low = {latestBenchmarkRun.OnePercentLowAverageFps:F1} FPS).";

            list.Add(new EvidenceBasedRecommendation(
                RecommendationId: "DIAG-CS2-FRAMETIME-EVIDENCE",
                Title: $"Diagnóstico Empírico CS2: {latestBenchmarkRun.AverageFps:F1} FPS Avg | {latestBenchmarkRun.OnePercentLowAverageFps:F1} FPS 1% Low",
                TargetSubsystem: "BENCHMARK ENGINE",
                EvidenceState: EvidenceSufficiencyState.EmpiricalEvidenceAvailable,
                EvidenceStatement: $"Muestra verificada: N = {latestBenchmarkRun.ValidEvaluatedFrames} cuadros válidos en {latestBenchmarkRun.CaptureDurationSeconds:F1} s (Mediana = {latestBenchmarkRun.MedianFrametimeMs:F2} ms, P99 = {latestBenchmarkRun.P99FrametimeMs:F2} ms, IQR = {latestBenchmarkRun.InterquartileRangeMs:F2} ms).",
                BottleneckDiagnosis: bottleneckDiag,
                ProposedMechanism: "Auditoría de línea base para comparación A/B multi-corrida.",
                TargetResourceDescription: $"{latestBenchmarkRun.TargetProcessName}",
                TargetProcessIdentity: cs2Telemetry.Identity,
                RequiresExplicitUserConsent: false,
                IsReversible: true,
                VerificationProtocol: "Ejecutar al menos 3 corridas en estado A y 3 corridas en estado B.",
                RollbackProtocol: "N/A"
            ));
        }

        // 2. TOPOLOGÍA HÍBRIDA (2 P-CORES + 8 E-CORES EN INTEL CORE i3-1220P)
        if (hybridTopology.IsHybridArchitecture && hybridTopology.ECoreLogicalProcessors.Count > 0)
        {
            ProcessIdentity? candidateBg = controllableBackgroundProcesses.FirstOrDefault();

            if (candidateBg is not null)
            {
                bool provenIneffective = empiricalHistory.Any(h =>
                    h.DecisionId == "HYBRID-CPUSETS-ECORE-STEER" && h.SuppressFutureRecommendation);

                list.Add(new EvidenceBasedRecommendation(
                    RecommendationId: "HYBRID-CPUSETS-ECORE-STEER",
                    Title: $"Asignación de CPU Sets (E-Cores) para Proceso Secundario: {candidateBg.ProcessName} (PID {candidateBg.ProcessId})",
                    TargetSubsystem: "HYBRID TOPOLOGY (CPU SETS)",
                    EvidenceState: provenIneffective
                        ? EvidenceSufficiencyState.PreviouslyProvenIneffective
                        : EvidenceSufficiencyState.EmpiricalEvidenceAvailable,
                    EvidenceStatement: $"Arquitectura híbrida detectada: {hybridTopology.PCoreLogicalProcessors.Count} hilos P-Core y {hybridTopology.ECoreLogicalProcessors.Count} hilos E-Core. Proceso secundario detectado: {candidateBg.ProcessName} (PID {candidateBg.ProcessId}).",
                    BottleneckDiagnosis: "En el Intel Core i3-1220P solo existen 2 P-Cores físicos (4 hilos). Si un proceso secundario se planifica en los P-Cores, interrumpe los hilos críticos de CS2.",
                    ProposedMechanism: "kernel32.dll!SetProcessDefaultCpuSets hacia los IDs de E-Cores (EfficiencyClass = 0), sin usar afinidad dura ni excluir CPU0/CPU1 de CS2.",
                    TargetResourceDescription: $"{candidateBg.ProcessName} (PID {candidateBg.ProcessId})",
                    TargetProcessIdentity: candidateBg,
                    RequiresExplicitUserConsent: true,
                    IsReversible: true,
                    VerificationProtocol: "Verificar GetProcessDefaultCpuSets y comparar P99 MsBetweenPresents en prueba A/B.",
                    RollbackProtocol: "Invocar SetProcessDefaultCpuSets(hProcess, null, 0) verificando PID y CreationTimeUtcTicks."
                ));
            }
            else
            {
                list.Add(new EvidenceBasedRecommendation(
                    RecommendationId: "HYBRID-CPUSETS-NO-TARGET",
                    Title: "Información insuficiente sobre procesos secundarios candidatos para CPU Sets",
                    TargetSubsystem: "HYBRID TOPOLOGY (CPU SETS)",
                    EvidenceState: EvidenceSufficiencyState.InsufficientInformation,
                    EvidenceStatement: $"Información insuficiente: Topología híbrida activa ({hybridTopology.PCoreLogicalProcessors.Count} P-Threads / {hybridTopology.ECoreLogicalProcessors.Count} E-Threads), pero no hay procesos secundarios pesados de usuario elegibles.",
                    BottleneckDiagnosis: "No se justifica modificar CPU Sets cuando no existen procesos secundarios compitiendo por los 2 P-Cores.",
                    ProposedMechanism: "Ninguno.",
                    TargetResourceDescription: "Sin proceso secundario objetivo",
                    TargetProcessIdentity: null,
                    RequiresExplicitUserConsent: true,
                    IsReversible: true,
                    VerificationProtocol: "N/A",
                    RollbackProtocol: "N/A"
                ));
            }
        }

        // 3. ECOQOS Y PRIORIDAD EN PROCESO SECUNDARIO INDIVIDUAL
        ProcessIdentity? ecoCandidate = controllableBackgroundProcesses.FirstOrDefault();
        if (ecoCandidate is not null)
        {
            list.Add(new EvidenceBasedRecommendation(
                RecommendationId: "PROC-SINGLE-ECOQOS-CONTAINMENT",
                Title: $"Activar EcoQoS y Prioridad BelowNormal en {ecoCandidate.ProcessName} (PID {ecoCandidate.ProcessId})",
                TargetSubsystem: "PROCESS POWER & SCHEDULER",
                EvidenceState: EvidenceSufficiencyState.EmpiricalEvidenceAvailable,
                EvidenceStatement: $"Proceso secundario activo verificado: {ecoCandidate.ProcessName} (PID {ecoCandidate.ProcessId}) en sistema con GPU integrada UMA (presupuesto PL1 compartido).",
                BottleneckDiagnosis: "En el ASUS PN64 (i3-1220P + Intel UHD), cada vatio consumido por procesos de fondo en estados P altos reduce el margen térmico/eléctrico de la iGPU integrada.",
                ProposedMechanism: "SetProcessInformation(ProcessPowerThrottling = EcoQoS) + SetPriorityClass(BELOW_NORMAL_PRIORITY_CLASS) exclusivamente sobre este proceso.",
                TargetResourceDescription: $"{ecoCandidate.ProcessName} (PID {ecoCandidate.ProcessId})",
                TargetProcessIdentity: ecoCandidate,
                RequiresExplicitUserConsent: true,
                IsReversible: true,
                VerificationProtocol: "Comprobar estado previo/posterior y validar impacto mediante comparación A/B.",
                RollbackProtocol: "Restaurar PriorityClass original y desactivar máscara EcoQoS validando identidad PID + CreationTime."
            ));
        }

        return list;
    }
}
