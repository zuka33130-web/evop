    public required string ValidationCriteria { get; init; }
    public required string RollbackStrategy { get; init; }
}

public sealed class DashboardViewModel : INotifyPropertyChanged
{
    private const int MaxHistorySamples = 60;

    private readonly IHardwareIntelligenceEngine _hardwareEngine;
    private readonly ILiveTelemetryEngine _telemetryEngine;
    private readonly IAdaptiveDecisionEngine _decisionEngine;
    private readonly DispatcherTimer _telemetryTimer;

    private readonly List<double> _cpuHistory = new(MaxHistorySamples);
    private readonly List<double> _ramHistory = new(MaxHistorySamples);

    private HardwareSystemProfile _hardwareProfile;
    private OptimizationObjective _selectedObjective = OptimizationObjective.Gaming;

    private double _cpuUtilizationPercent;
    private double _ramLoadPercent;
    private string _ramUsageDetailText = string.Empty;
    private double _commitLoadPercent;
    private string _commitUsageDetailText = string.Empty;
    private double _driveFreePercent;
    private string _driveDetailText = string.Empty;
    private string _processEcosystemText = string.Empty;
    private string _thermalStatusText = string.Empty;
    private string _frametimeStatusText = string.Empty;

    private int _compositeScore;
    private int _stabilityScore;
    private string _stabilityDiag = string.Empty;
    private int _performanceScore;
    private string _performanceDiag = string.Empty;
    private int _efficiencyScore;
    private string _efficiencyDiag = string.Empty;
    private int _healthScore;
    private string _healthDiag = string.Empty;

    private string _bottleneckHeadline = string.Empty;
    private string _bottleneckExplanation = string.Empty;
    private string _bottleneckConfidenceText = string.Empty;
    private string _uncertaintyNotice = string.Empty;
    private Brush _bottleneckAccentBrush = new SolidColorBrush(Color.FromRgb(0, 229, 255));

    private PointCollection _cpuGraphPoints = [];
    private PointCollection _ramGraphPoints = [];
    private double _graphCanvasWidth = 520;
    private double _graphCanvasHeight = 140;

    public event PropertyChangedEventHandler? PropertyChanged;

    public ObservableCollection<DecisionCardViewModel> AdaptiveDecisions { get; } = [];
    public ObservableCollection<ProcessResourceSample> TopMemoryProcesses { get; } = [];

    public ICommand SelectEverydayObjectiveCommand { get; }
    public ICommand SelectGamingObjectiveCommand { get; }
    public ICommand SelectMaxPerformanceObjectiveCommand { get; }
    public ICommand ForceEvaluateCommand { get; }

    public DashboardViewModel(
        IHardwareIntelligenceEngine hardwareEngine,
        ILiveTelemetryEngine telemetryEngine,
        IAdaptiveDecisionEngine decisionEngine)
    {
        _hardwareEngine = hardwareEngine;
        _telemetryEngine = telemetryEngine;
        _decisionEngine = decisionEngine;

        _hardwareProfile = _hardwareEngine.InspectHardwareProfile();

        // Pre-llenar búfer de gráfico con 0 para renderizado suave desde el segundo 1
        for (int i = 0; i < MaxHistorySamples; i++)
        {
            _cpuHistory.Add(0);
            _ramHistory.Add(0);
        }

        SelectEverydayObjectiveCommand = new RelayCommand(() => SetObjective(OptimizationObjective.EverydayUse));
        SelectGamingObjectiveCommand = new RelayCommand(() => SetObjective(OptimizationObjective.Gaming));
        SelectMaxPerformanceObjectiveCommand = new RelayCommand(() => SetObjective(OptimizationObjective.MaxPerformance));
        ForceEvaluateCommand = new RelayCommand(ExecuteTelemetryAndDecisionCycle);

        // Primer ciclo inmediato
        ExecuteTelemetryAndDecisionCycle();

        // Ciclo continuo de telemetría real cada 1 segundo
        _telemetryTimer = new DispatcherTimer(DispatcherPriority.Background)
        {
            Interval = TimeSpan.FromSeconds(1.0)
        };
        _telemetryTimer.Tick += (_, _) => ExecuteTelemetryAndDecisionCycle();
        _telemetryTimer.Start();
    }

    // Propiedades de Hardware Awareness
    public string MachineAndOsText => $"{_hardwareProfile.MachineName}  |  {_hardwareProfile.OsVersionBuild}";
    public string CpuModelName => _hardwareProfile.CpuModelName;
    public string CpuTopologyBadge => $"{_hardwareProfile.LogicalCoreCount} Hilos Lógicos";
    public string RamInstalledBadge => $"{_hardwareProfile.TotalPhysicalMemoryGb:F1} GB ({FormatMemoryTier(_hardwareProfile.MemoryTier)})";
    public string GpuModelName => _hardwareProfile.PrimaryGpuName;
    public string GpuTierBadge => _hardwareProfile.GpuTier == GpuArchitectureTier.IntegratedSharedMemory
        ? "UMA Integrada (Memoria Compartida)"
        : $"Dedicada ({_hardwareProfile.ReportedGpuMemoryGb:F1} GB VRAM)";
    public string PowerSchemeName => _hardwareProfile.ActivePowerSchemeName;

    // Estado de Botones de Escenario Objetivo
    public string ActiveObjectiveLabel => _selectedObjective switch
    {
        OptimizationObjective.EverydayUse => "ESCENARIO ACTIVO: USO COTIDIANO (EFICIENCIA Y ESTABILIDAD)",
        OptimizationObjective.Gaming => "ESCENARIO ACTIVO: GAMING COMPETITIVO (CONSISTENCIA 1% LOWS)",
        OptimizationObjective.MaxPerformance => "ESCENARIO ACTIVO: MÁXIMO RENDIMIENTO (CÓMPUTO Y THROUGHPUT)",
        _ => string.Empty
    };

    public Brush EverydayButtonBorder => GetObjectiveBorderBrush(OptimizationObjective.EverydayUse);
    public Brush GamingButtonBorder => GetObjectiveBorderBrush(OptimizationObjective.Gaming);
    public Brush MaxPerfButtonBorder => GetObjectiveBorderBrush(OptimizationObjective.MaxPerformance);

    public Brush EverydayButtonForeground => GetObjectiveForegroundBrush(OptimizationObjective.EverydayUse);
    public Brush GamingButtonForeground => GetObjectiveForegroundBrush(OptimizationObjective.Gaming);
    public Brush MaxPerfButtonForeground => GetObjectiveForegroundBrush(OptimizationObjective.MaxPerformance);

    // Métricas en Tiempo Real
    public double CpuUtilizationPercent { get => _cpuUtilizationPercent; private set => SetField(ref _cpuUtilizationPercent, value); }
    public double RamLoadPercent { get => _ramLoadPercent; private set => SetField(ref _ramLoadPercent, value); }
    public string RamUsageDetailText { get => _ramUsageDetailText; private set => SetField(ref _ramUsageDetailText, value); }
    public double CommitLoadPercent { get => _commitLoadPercent; private set => SetField(ref _commitLoadPercent, value); }
    public string CommitUsageDetailText { get => _commitUsageDetailText; private set => SetField(ref _commitUsageDetailText, value); }
    public double DriveFreePercent { get => _driveFreePercent; private set => SetField(ref _driveFreePercent, value); }
    public string DriveDetailText { get => _driveDetailText; private set => SetField(ref _driveDetailText, value); }
    public string ProcessEcosystemText { get => _processEcosystemText; private set => SetField(ref _processEcosystemText, value); }
    public string ThermalStatusText { get => _thermalStatusText; private set => SetField(ref _thermalStatusText, value); }
    public string FrametimeStatusText { get => _frametimeStatusText; private set => SetField(ref _frametimeStatusText, value); }

    // EVO Performance Score (4 Dimensiones)
    public int CompositeScore { get => _compositeScore; private set => SetField(ref _compositeScore, value); }
    public int StabilityScore { get => _stabilityScore; private set => SetField(ref _stabilityScore, value); }
    public string StabilityDiag { get => _stabilityDiag; private set => SetField(ref _stabilityDiag, value); }
    public int PerformanceScore { get => _performanceScore; private set => SetField(ref _performanceScore, value); }
    public string PerformanceDiag { get => _performanceDiag; private set => SetField(ref _performanceDiag, value); }
    public int EfficiencyScore { get => _efficiencyScore; private set => SetField(ref _efficiencyScore, value); }
    public string EfficiencyDiag { get => _efficiencyDiag; private set => SetField(ref _efficiencyDiag, value); }
    public int HealthScore { get => _healthScore; private set => SetField(ref _healthScore, value); }
    public string HealthDiag { get => _healthDiag; private set => SetField(ref _healthDiag, value); }

    // Diagnóstico de Cuellos de Botella e Incertidumbre
    public string BottleneckHeadline { get => _bottleneckHeadline; private set => SetField(ref _bottleneckHeadline, value); }
    public string BottleneckExplanation { get => _bottleneckExplanation; private set => SetField(ref _bottleneckExplanation, value); }
    public string BottleneckConfidenceText { get => _bottleneckConfidenceText; private set => SetField(ref _bottleneckConfidenceText, value); }
    public string UncertaintyNotice { get => _uncertaintyNotice; private set => SetField(ref _uncertaintyNotice, value); }
    public Brush BottleneckAccentBrush { get => _bottleneckAccentBrush; private set => SetField(ref _bottleneckAccentBrush, value); }

    // Puntos de Gráfico en Tiempo Real
    public PointCollection CpuGraphPoints { get => _cpuGraphPoints; private set => SetField(ref _cpuGraphPoints, value); }
    public PointCollection RamGraphPoints { get => _ramGraphPoints; private set => SetField(ref _ramGraphPoints, value); }

    public void UpdateGraphViewportSize(double width, double height)
    {
        if (width > 50 && height > 30)
        {
            _graphCanvasWidth = width;
            _graphCanvasHeight = height;
            RebuildWaveformPolylines();
        }
    }

    private void SetObjective(OptimizationObjective objective)
    {
        if (_selectedObjective == objective) return;
        _selectedObjective = objective;

        OnPropertyChanged(nameof(ActiveObjectiveLabel));
        OnPropertyChanged(nameof(EverydayButtonBorder));
        OnPropertyChanged(nameof(GamingButtonBorder));
        OnPropertyChanged(nameof(MaxPerfButtonBorder));
        OnPropertyChanged(nameof(EverydayButtonForeground));
        OnPropertyChanged(nameof(GamingButtonForeground));
        OnPropertyChanged(nameof(MaxPerfButtonForeground));

        ExecuteTelemetryAndDecisionCycle();
    }

    private void ExecuteTelemetryAndDecisionCycle()
    {
        SystemTelemetrySnapshot snapshot = _telemetryEngine.CaptureSnapshot();
        AdaptiveEvaluationReport report = _decisionEngine.EvaluateSystemState(_hardwareProfile, snapshot, _selectedObjective);

        // Actualizar métricas en vivo
        CpuUtilizationPercent = snapshot.CpuTotalUtilizationPercent;
        RamLoadPercent = snapshot.PhysicalMemoryLoadPercent;
        RamUsageDetailText = $"{snapshot.PhysicalMemoryUsedGb:F2} / {_hardwareProfile.TotalPhysicalMemoryGb:F1} GB ({snapshot.PhysicalMemoryAvailableGb:F2} GB Libres)";

        CommitLoadPercent = snapshot.CommitChargePercent;
        CommitUsageDetailText = $"{snapshot.CommitChargeTotalGb:F2} / {snapshot.CommitChargeLimitGb:F1} GB Commit Total";

        DriveFreePercent = snapshot.SystemDriveFreePercent;
        DriveDetailText = $"Unidad {_hardwareProfile.SystemDriveName} ({_hardwareProfile.SystemDriveFormat}) — {snapshot.SystemDriveFreeGb:F1} GB Libres de {_hardwareProfile.SystemDriveTotalGb:F0} GB";

        ProcessEcosystemText = $"{snapshot.TotalRunningProcesses} Procesos  |  {snapshot.TotalSystemThreads} Hilos";

        ThermalStatusText = snapshot.ThermalSensorState == SensorCalibrationState.ProviderNotAttached
            ? "PROVEEDOR RING-0 NO ADJUNTO (Guardia Activa)"
            : $"{snapshot.CpuPackageTempCelsius:F1} °C";

        FrametimeStatusText = snapshot.FrametimeSensorState == SensorCalibrationState.ProviderNotAttached
            ? "EN ESPERA DE SESIÓN 3D (ETW Standby)"
            : $"{snapshot.CurrentFrametimeMs:F2} ms (1% Low: {snapshot.FrametimeOnePercentLowMs:F2} ms)";

        // Actualizar historial para gráfico en tiempo real
        if (_cpuHistory.Count >= MaxHistorySamples) _cpuHistory.RemoveAt(0);
        if (_ramHistory.Count >= MaxHistorySamples) _ramHistory.RemoveAt(0);
        _cpuHistory.Add(snapshot.CpuTotalUtilizationPercent);
        _ramHistory.Add(snapshot.PhysicalMemoryLoadPercent);
        RebuildWaveformPolylines();

        // Actualizar Top Procesos
        TopMemoryProcesses.Clear();
        foreach (var proc in snapshot.TopMemoryConsumers)
        {
            TopMemoryProcesses.Add(proc);
        }

        // Actualizar EVO Performance Score
        CompositeScore = report.PerformanceScore.CompositeWeightedScore;
        StabilityScore = report.PerformanceScore.StabilityScore;
        StabilityDiag = report.PerformanceScore.StabilityDiagnostic;
        PerformanceScore = report.PerformanceScore.PerformanceScore;
        PerformanceDiag = report.PerformanceScore.PerformanceDiagnostic;
        EfficiencyScore = report.PerformanceScore.EfficiencyScore;
        EfficiencyDiag = report.PerformanceScore.EfficiencyDiagnostic;
