using System.Diagnostics;
using System.Runtime.InteropServices;
using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;
using EvoOptimizer.Infrastructure.Native;

namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// Descubre la topología híbrida real del procesador (P-Cores vs E-Cores mediante GetSystemCpuSetInformation)
/// e inspecciona de forma aislada la telemetría del proceso Counter-Strike 2 (cs2.exe).
/// </summary>
public sealed class HybridSiliconAndCs2ProbeService : IHybridSiliconAndCs2ProbeService
{
    private static readonly HashSet<string> ExcludedCriticalProcesses = new(StringComparer.OrdinalIgnoreCase)
    {
        "System", "Idle", "Registry", "Memory Compression", "smss", "csrss", "wininit",
        "services", "lsass", "svchost", "fontdrvhost", "dwm", "explorer", "audiodg",
        "spoolsv", "MsMpEng", "SecurityHealthService", "sihost", "taskhostw",
        "StartMenuExperienceHost", "ShellExperienceHost", "SearchHost", "ctfmon",
        "conhost", "WindowsTerminal", "devenv", "dotnet", "EvoOptimizer.App", "cs2", "steam"
    };

    private readonly IHardwareIntelligenceEngine _hardwareEngine;
    private HybridCpuTopologyProfile? _cachedHybridTopology;

    public HybridSiliconAndCs2ProbeService(IHardwareIntelligenceEngine hardwareEngine)
    {
        _hardwareEngine = hardwareEngine;
    }

    public HybridCpuTopologyProfile InspectHybridTopology()
    {
        if (_cachedHybridTopology is not null)
        {
            return _cachedHybridTopology;
        }

        HardwareSystemProfile baseHw = _hardwareEngine.InspectHardwareProfile();
        var cpuSets = new List<LogicalProcessorCpuSetInfo>();

        try
        {
            _ = Win32NativeMethods.GetSystemCpuSetInformation(nint.Zero, 0, out uint requiredBytes, nint.Zero, 0);
            if (requiredBytes > 0)
            {
                nint buffer = Marshal.AllocHGlobal((int)requiredBytes);
                try
                {
                    if (Win32NativeMethods.GetSystemCpuSetInformation(buffer, requiredBytes, out uint returnedBytes, nint.Zero, 0))
                    {
                        int offset = 0;
                        while (offset < returnedBytes)
                        {
                            var info = Marshal.PtrToStructure<Win32NativeMethods.SYSTEM_CPU_SET_INFORMATION>(buffer + offset);
                            if (info.Size == 0) break;

                            cpuSets.Add(new LogicalProcessorCpuSetInfo(
                                LogicalProcessorIndex: info.LogicalProcessorIndex,
                                PhysicalCoreIndex: info.CoreIndex,
                                CpuSetId: info.Id,
                                EfficiencyClass: info.EfficiencyClass,
                                CoreClass: CoreArchitectureClass.SymmetricOrUnknown,
                                LastLevelCacheIndex: info.LastLevelCacheIndex
                            ));

                            offset += (int)info.Size;
                        }
                    }
                }
                finally
                {
                    Marshal.FreeHGlobal(buffer);
                }
            }
        }
        catch { }

        byte minEff = cpuSets.Count > 0 ? cpuSets.Min(c => c.EfficiencyClass) : (byte)0;
        byte maxEff = cpuSets.Count > 0 ? cpuSets.Max(c => c.EfficiencyClass) : (byte)0;
        bool isHybrid = maxEff > minEff;

        var classified = cpuSets.Select(c =>
        {
            CoreArchitectureClass cls = !isHybrid
                ? CoreArchitectureClass.SymmetricOrUnknown
                : (c.EfficiencyClass == maxEff ? CoreArchitectureClass.PerformanceCore : CoreArchitectureClass.EfficientCore);

            return c with { CoreClass = cls };
        }).OrderBy(c => c.LogicalProcessorIndex).ToList();

        var pCores = classified.Where(c => c.CoreClass is CoreArchitectureClass.PerformanceCore or CoreArchitectureClass.SymmetricOrUnknown).ToList();
        var eCores = classified.Where(c => c.CoreClass == CoreArchitectureClass.EfficientCore).ToList();

        _cachedHybridTopology = new HybridCpuTopologyProfile(
            CpuModelName: baseHw.CpuModelName,
            TotalPhysicalCores: baseHw.PhysicalCoreCount,
            TotalLogicalProcessors: baseHw.LogicalCoreCount,
            IsHybridArchitecture: isHybrid,
            PCoreLogicalProcessors: pCores,
            ECoreLogicalProcessors: eCores,
            L2CacheTotalMb: baseHw.CpuL2CacheMb,
            L3CacheTotalMb: baseHw.CpuL3CacheMb
        );

        return _cachedHybridTopology;
    }

    public Cs2ProcessTelemetry InspectCs2Process()
    {
        Process[] cs2Procs = Process.GetProcessesByName("cs2");
        if (cs2Procs.Length == 0)
        {
            return new Cs2ProcessTelemetry(
                IsRunning: false,
                Identity: null,
                IsForegroundWindow: false,
                WorkingSetMb: 0,
                PrivateCommitMb: 0,
                ThreadCount: 0,
                CurrentPriorityClass: "Inactivo",
                IsEcoQosEnabled: false,
                AssignedCpuSetIds: [],
                SampledAt: DateTimeOffset.Now
            );
        }

        Process cs2 = cs2Procs[0];
        try
        {
            ProcessIdentity? identity = ExtractProcessIdentity(cs2);
            nint fgHwnd = Win32NativeMethods.GetForegroundWindow();
            _ = Win32NativeMethods.GetWindowThreadProcessId(fgHwnd, out uint fgPid);
            bool isFg = fgPid == (uint)cs2.Id;

            double wsMb = Math.Round(cs2.WorkingSet64 / (1024.0 * 1024.0), 1);
            double privMb = Math.Round(cs2.PrivateMemorySize64 / (1024.0 * 1024.0), 1);
            int threads = cs2.Threads.Count;
            string prio = cs2.PriorityClass.ToString();
            uint[] cpuSets = QueryProcessAssignedCpuSets(cs2.Handle);

            return new Cs2ProcessTelemetry(
                IsRunning: true,
                Identity: identity,
                IsForegroundWindow: isFg,
                WorkingSetMb: wsMb,
                PrivateCommitMb: privMb,
                ThreadCount: threads,
                CurrentPriorityClass: prio,
                IsEcoQosEnabled: false,
                AssignedCpuSetIds: cpuSets,
                SampledAt: DateTimeOffset.Now
            );
        }
        catch
        {
            return new Cs2ProcessTelemetry(
                IsRunning: true,
                Identity: new ProcessIdentity(cs2.Id, 0, "cs2", "cs2.exe"),
                IsForegroundWindow: false,
                WorkingSetMb: Math.Round(cs2.WorkingSet64 / (1024.0 * 1024.0), 1),
                PrivateCommitMb: 0,
                ThreadCount: cs2.Threads.Count,
                CurrentPriorityClass: "Protegido",
                IsEcoQosEnabled: false,
                AssignedCpuSetIds: [],
                SampledAt: DateTimeOffset.Now
            );
        }
        finally
        {
            foreach (var p in cs2Procs) p.Dispose();
        }
    }

    public IReadOnlyList<ProcessIdentity> EnumerateControllableBackgroundProcesses()
    {
        var result = new List<(ProcessIdentity Identity, double WorkingSetMb)>();
        int selfPid = Environment.ProcessId;
        nint fgHwnd = Win32NativeMethods.GetForegroundWindow();
        _ = Win32NativeMethods.GetWindowThreadProcessId(fgHwnd, out uint fgPid);

        Process[] all = Process.GetProcesses();
        foreach (var proc in all)
        {
            try
            {
                if (proc.Id <= 4 || proc.Id == selfPid || proc.Id == (int)fgPid)
                    continue;

                if (ExcludedCriticalProcesses.Contains(proc.ProcessName))
                    continue;

                double wsMb = proc.WorkingSet64 / (1024.0 * 1024.0);
                if (wsMb < 50.0)
                    continue;

                ProcessIdentity? id = ExtractProcessIdentity(proc);
                if (id is not null)
                {
                    result.Add((id, wsMb));
                }
            }
            catch { }
            finally
            {
                proc.Dispose();
            }
        }

        return result
            .OrderByDescending(x => x.WorkingSetMb)
            .Take(10)
            .Select(x => x.Identity)
            .ToList();
    }

    public ProcessIdentity? CaptureProcessIdentity(int pid)
    {
        try
        {
            using var proc = Process.GetProcessById(pid);
            return ExtractProcessIdentity(proc);
        }
        catch
        {
            return null;
        }
    }

    public bool VerifyProcessIdentityStillMatches(ProcessIdentity expectedIdentity)
    {
        try
        {
            using var proc = Process.GetProcessById(expectedIdentity.ProcessId);
            long currentStartTicks = proc.StartTime.ToUniversalTime().Ticks;
            return currentStartTicks == expectedIdentity.CreationTimeUtcTicks &&
                   proc.ProcessName.Equals(expectedIdentity.ProcessName, StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private static ProcessIdentity? ExtractProcessIdentity(Process proc)
    {
        try
        {
            long startTicks = proc.StartTime.ToUniversalTime().Ticks;
            string path = string.Empty;
            try
            {
                path = proc.MainModule?.FileName ?? proc.ProcessName;
            }
            catch
            {
                path = proc.ProcessName;
            }

            return new ProcessIdentity(
                ProcessId: proc.Id,
                CreationTimeUtcTicks: startTicks,
                ProcessName: proc.ProcessName,
                ExecutablePath: path
            );
        }
        catch
        {
            return null;
        }
    }

    public static uint[] QueryProcessAssignedCpuSets(nint processHandle)
    {
        try
        {
            _ = Win32NativeMethods.GetProcessDefaultCpuSets(processHandle, null, 0, out uint requiredCount);
            if (requiredCount == 0) return [];

            uint[] ids = new uint[requiredCount];
            if (Win32NativeMethods.GetProcessDefaultCpuSets(processHandle, ids, requiredCount, out uint actualCount))
            {
                return ids.Take((int)actualCount).ToArray();
            }
        }
        catch { }

        return [];
    }
}
