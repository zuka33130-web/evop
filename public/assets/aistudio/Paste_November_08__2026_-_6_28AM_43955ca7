using System.IO;
using System.Text.Json;
using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// Motor 16: Historical Analysis Engine.
/// Almacena en disco los resultados medibles de cada optimización.
/// Si un ajuste no produce beneficios reales o provoca regresiones en este PC,
/// EVO aprende y deja de recomendarlo para ese escenario.
/// </summary>
public sealed class HistoricalAnalysisService : IHistoricalAnalysisEngine
{
    private readonly string _storageFilePath;
    private readonly List<HistoricalDecisionOutcome> _outcomes = [];
    private readonly JsonSerializerOptions _jsonOptions = new() { WriteIndented = true };

    public HistoricalAnalysisService()
    {
        string appData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
        string folder = Path.Combine(appData, "EvoOptimizer");
        Directory.CreateDirectory(folder);
        _storageFilePath = Path.Combine(folder, "empirical_ledger.json");

        LoadFromDisk();
    }

    public void RecordEmpiricalOutcome(InterventionTransactionRecord transaction)
    {
        int scoreDelta = transaction.AfterCompositeScore - transaction.BeforeCompositeScore;
        bool wasEffective = transaction.ExecutionState == InterventionExecutionState.ValidatedEffective;
        bool wasRegressionOrUseless =
            transaction.ExecutionState == InterventionExecutionState.AutoRolledBackRegression ||
            (transaction.FreedMemoryMb < 15.0 && scoreDelta <= 0 && transaction.TouchedProcessCount == 0);

        int existingIndex = _outcomes.FindIndex(o =>
            o.DecisionId == transaction.DecisionId && o.Objective == transaction.Objective);

        if (existingIndex >= 0)
        {
            var prev = _outcomes[existingIndex];
            int totalExec = prev.TotalExecutions + 1;
            int effCount = prev.EffectiveCount + (wasEffective ? 1 : 0);
            int regCount = prev.RegressionOrNoGainCount + (wasRegressionOrUseless ? 1 : 0);

            // Si falló en producir mejora medible 2 veces o causó regresión directa, se suprime para este escenario
            bool suppress = transaction.ExecutionState == InterventionExecutionState.AutoRolledBackRegression ||
                            (regCount >= 2 && effCount == 0);

            string conclusion = suppress
                ? $"DESCARTADO POR APRENDIZAJE EMPÍRICO: Evaluado {totalExec} veces sin mejora neta medible en este hardware."
                : $"HISTORIAL VERIFICADO: {effCount}/{totalExec} ejecuciones exitosas (Último Δ RAM: +{transaction.FreedMemoryMb:F0} MB, Δ Score: {scoreDelta:+#;-#;0}).";

            _outcomes[existingIndex] = new HistoricalDecisionOutcome(
                DecisionId: transaction.DecisionId,
                Objective: transaction.Objective,
                TotalExecutions: totalExec,
                EffectiveCount: effCount,
                RegressionOrNoGainCount: regCount,
                LastFreedMemoryMb: transaction.FreedMemoryMb,
                LastScoreDelta: scoreDelta,
                LastEvaluatedAt: DateTimeOffset.Now,
                SuppressFutureRecommendation: suppress,
                EmpiricalConclusion: conclusion
            );
        }
        else
        {
            bool suppress = transaction.ExecutionState == InterventionExecutionState.AutoRolledBackRegression;
            string conclusion = suppress
                ? "DESCARTADO POR REGRESIÓN MEDIDA: La prueba inicial degradó las métricas del sistema y fue revertida."
                : $"VALIDADO EMPÍRICAMENTE: Liberó {transaction.FreedMemoryMb:F0} MB en {transaction.TouchedProcessCount} procesos (Δ Score: {scoreDelta:+#;-#;0}).";

            _outcomes.Add(new HistoricalDecisionOutcome(
                DecisionId: transaction.DecisionId,
                Objective: transaction.Objective,
                TotalExecutions: 1,
                EffectiveCount: wasEffective ? 1 : 0,
                RegressionOrNoGainCount: wasRegressionOrUseless ? 1 : 0,
                LastFreedMemoryMb: transaction.FreedMemoryMb,
                LastScoreDelta: scoreDelta,
                LastEvaluatedAt: DateTimeOffset.Now,
                SuppressFutureRecommendation: suppress,
                EmpiricalConclusion: conclusion
            ));
        }

        SaveToDisk();
    }

    public HistoricalDecisionOutcome? GetEmpiricalOutcome(string decisionId, OptimizationObjective objective)
    {
        return _outcomes.FirstOrDefault(o => o.DecisionId == decisionId && o.Objective == objective);
    }

    public IReadOnlyList<HistoricalDecisionOutcome> GetAllOutcomes() => _outcomes.AsReadOnly();

    public void ClearEmpiricalHistory()
    {
        _outcomes.Clear();
        SaveToDisk();
    }

    private void LoadFromDisk()
    {
        try
        {
            if (!File.Exists(_storageFilePath)) return;
            string json = File.ReadAllText(_storageFilePath);
            var loaded = JsonSerializer.Deserialize<List<HistoricalDecisionOutcome>>(json);
            if (loaded is not null)
            {
                _outcomes.Clear();
                _outcomes.AddRange(loaded);
            }
        }
        catch
        {
            // Si el archivo está corrupto, iniciar limpio sin bloquear la aplicación
        }
    }

    private void SaveToDisk()
    {
        try
        {
            string json = JsonSerializer.Serialize(_outcomes, _jsonOptions);
            File.WriteAllText(_storageFilePath, json);
        }
        catch
        {
            // Ignorar errores de escritura por permisos restringidos
        }
    }
}
