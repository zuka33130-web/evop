using System.Diagnostics;
using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;
using EvoOptimizer.Infrastructure.Native;

namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// Implementación real de los Motores 13 (Gaming Intelligence) y 14 (Benchmark & Scheduler Stability).
/// Detecta la carga activa en primer plano para protegerla y mide la precisión del planificador del kernel.
/// </summary>
public sealed class WindowsGamingAndLatencyService :
    IGamingIntelligenceEngine,
    IBenchmarkFrametimeEngine
{
    private long _lastProbeTimestamp;
    private double _smoothedJitterMs = 0.15;

    public (int ForegroundPid, string ProcessName, bool IsHeavyOrGameWorkload) InspectForegroundWorkload()
    {
        try
        {
            nint hwnd = Win32NativeMethods.GetForegroundWindow();
            if (hwnd == nint.Zero)
            {
                return (0, "Idle/Desktop", false);
            }

            _ = Win32NativeMethods.GetWindowThreadProcessId(hwnd, out uint pid);
            if (pid == 0)
            {
                return (0, "System", false);
            }

            using var proc = Process.GetProcessById((int)pid);
            string name = proc.ProcessName;
            double workingSetMb = proc.WorkingSet64 / (1024.0 * 1024.0);

            bool isHeavy = workingSetMb > 450.0 ||
                            (!name.Equals("explorer", StringComparison.OrdinalIgnoreCase) &&
                            !name.Equals("EvoOptimizer.App", StringComparison.OrdinalIgnoreCase) &&
                            !name.Equals("TextInputHost", StringComparison.OrdinalIgnoreCase) &&
                            proc.Threads.Count > 24);

            return ((int)pid, name, isHeavy);
        }
        catch
        {
            return (0, "Ventana Protegida", false);
        }
    }

    public (SensorCalibrationState State, double SchedulerJitterMs) MeasureSchedulerStability()
    {
        // Medición real de alta precisión mediante QueryPerformanceCounter (Stopwatch.GetTimestamp)
        long now = Stopwatch.GetTimestamp();
        if (_lastProbeTimestamp == 0)
        {
            _lastProbeTimestamp = now;
            return (SensorCalibrationState.EstimatedFromCounters, _smoothedJitterMs);
        }

        // Realizamos una micro-prueba de latencia de despacho de hilo (SpinWait vs QPC)
        long t0 = Stopwatch.GetTimestamp();
        Thread.Yield();
        long t1 = Stopwatch.GetTimestamp();

        double dispatchLatencyMs = ((t1 - t0) * 1000.0) / Stopwatch.Frequency;
        _smoothedJitterMs = (_smoothedJitterMs * 0.75) + (dispatchLatencyMs * 0.25);
        _lastProbeTimestamp = now;

        return (SensorCalibrationState.EstimatedFromCounters, Math.Round(Math.Clamp(_smoothedJitterMs, 0.01, 25.0), 3));
    }
}
