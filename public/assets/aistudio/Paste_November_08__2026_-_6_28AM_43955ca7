    private void ExecuteExportAuditJson()
    {
        try
        {
            var payload = new
            {
                ExportedAtUtc = DateTimeOffset.UtcNow,
                Hardware = _hardwareProfile,
                HybridTopology = _hybridTopology,
                KernelProfile = _kernelProfile,
                LatestBenchmarkRun = _latestBenchmarkRun,
