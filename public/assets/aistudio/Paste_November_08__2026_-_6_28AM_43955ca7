```csharp
using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Core.Engine;

/// <summary>
/// Motor matemático determinista para cálculo de métricas de frametime a partir de eventos PresentMon/ETW.
/// Documenta y aplica filtros de calentamiento (warmup), exclusión de cuadros descartados (Dropped)
/// y compuertas de suficiencia muestral (N >= 120 para 1% low, N >= 1000 para 0.1% low).
/// </summary>
public static class FrametimeMathCalculator
{
    public const int MinimumValidFramesForOnePercentLow = 120;
    public const int MinimumValidFramesForPointOnePercentLow = 1000;
    public const double DefaultWarmupSeconds = 2.0;

    public static RealFrametimeBenchmarkRun ComputeMetricsFromSamples(
        string configurationTag,
        string targetProcessName,
        string scenarioNotes,
        IReadOnlyList<FramePresentationSample> rawSamples,
        int backgroundProcessCount,
        double availableRamGb,
        double warmupSeconds = DefaultWarmupSeconds)
    {
        if (rawSamples is null || rawSamples.Count == 0)
        {
            return CreateInsufficientDataRun(
                configurationTag,
                targetProcessName,
                scenarioNotes,
                BenchmarkCaptureStatus.InsufficientSampleCount,
                "Información insuficiente: No se recibieron eventos de presentación de fotogramas.",
                0, 0, 0, backgroundProcessCount, availableRamGb);
        }

        int warmupDiscarded = 0;
        int droppedCount = 0;
        var validDisplayedMs = new List<double>(rawSamples.Count);
        var gpuBusyRatios = new List<double>(rawSamples.Count);

        double firstTimestamp = rawSamples[0].TimestampSeconds;

        foreach (var sample in rawSamples)
        {
            if ((sample.TimestampSeconds - firstTimestamp) < warmupSeconds)
            {
                warmupDiscarded++;
                continue;
            }

            if (sample.IsDropped)
            {
                droppedCount++;
                continue;
            }

            // Filtrar valores corruptos fuera de rango físico (0.1 ms = 10,000 FPS, 500 ms = 2 FPS)
            if (sample.MsBetweenPresents is >= 0.1 and <= 500.0)
            {
                validDisplayedMs.Add(sample.MsBetweenPresents);

                if (sample.MsUntilRenderComplete > 0 && sample.MsBetweenPresents > 0)
                {
                    double ratio = Math.Clamp((sample.MsUntilRenderComplete / sample.MsBetweenPresents) * 100.0, 0.0, 100.0);
                    gpuBusyRatios.Add(ratio);
                }
            }
        }

        int n = validDisplayedMs.Count;
        double totalValidDurationMs = validDisplayedMs.Sum();
        double captureDurationSec = Math.Round(totalValidDurationMs / 1000.0, 2);

        if (n < MinimumValidFramesForOnePercentLow)
        {
            return CreateInsufficientDataRun(
                configurationTag,
                targetProcessName,
                scenarioNotes,
                BenchmarkCaptureStatus.InsufficientSampleCount,
                $"Información insuficiente: Se capturaron {n} fotogramas válidos tras descartar warmup ({warmupDiscarded}) y cuadros caídos ({droppedCount}). Se requieren al menos {MinimumValidFramesForOnePercentLow} fotogramas válidos.",
                rawSamples.Count,
                warmupDiscarded,
                droppedCount,
                backgroundProcessCount,
                availableRamGb);
        }

        double[] sortedAscending = validDisplayedMs.OrderBy(x => x).ToArray();

        double meanMs = totalValidDurationMs / n;
        double avgFps = 1000.0 / meanMs;

        double medianMs = CalculateLinearPercentile(sortedAscending, 0.50);
        double p25Ms = CalculateLinearPercentile(sortedAscending, 0.25);
        double p75Ms = CalculateLinearPercentile(sortedAscending, 0.75);
        double p95Ms = CalculateLinearPercentile(sortedAscending, 0.95);
        double p99Ms = CalculateLinearPercentile(sortedAscending, 0.99);

        // 1% Low Percentile FPS = 1000 / P99_ms
        double onePercentPercentileFps = 1000.0 / p99Ms;

        // 1% Low Average FPS = Promedio de los cuadros más lentos que acumulan el 1% del tiempo total
        double onePercentTailAvgMs = CalculateWorstTimeIntegralAverageMs(sortedAscending, totalValidDurationMs, tailTimeFraction: 0.01);
        double onePercentLowAvgFps = 1000.0 / onePercentTailAvgMs;

        // 0.1% Low: Solo se calcula si N >= 1000 fotogramas válidos
        double? p999Ms = null;
        double? pointOnePercentileFps = null;
        double? pointOneAverageFps = null;
        string pointOneNotice;

        if (n >= MinimumValidFramesForPointOnePercentLow)
        {
            double valP999 = CalculateLinearPercentile(sortedAscending, 0.999);
            double tail01Ms = CalculateWorstTimeIntegralAverageMs(sortedAscending, totalValidDurationMs, tailTimeFraction: 0.001);
            p999Ms = Math.Round(valP999, 3);
            pointOnePercentileFps = Math.Round(1000.0 / valP999, 1);
            pointOneAverageFps = Math.Round(1000.0 / tail01Ms, 1);
            pointOneNotice = $"Calculado sobre N = {n} fotogramas válidos (>= {MinimumValidFramesForPointOnePercentLow}).";
        }
        else
        {
            pointOneNotice = $"Información insuficiente para 0.1% low: N = {n} fotogramas válidos (requiere N >= {MinimumValidFramesForPointOnePercentLow}).";
        }

        // Variabilidad y Stuttering
        double sumSquaredDiff = 0.0;
        int stutterSpikes = 0;

        for (int i = 0; i < validDisplayedMs.Count; i++)
        {
            double f = validDisplayedMs[i];
            double diff = f - meanMs;
            sumSquaredDiff += diff * diff;

            bool isSevereFrameSpike = f > (medianMs * 2.5);
            bool isSuddenFrameJump = i > 0 && Math.Abs(f - validDisplayedMs[i - 1]) > 15.0;

            if (isSevereFrameSpike || isSuddenFrameJump)
            {
                stutterSpikes++;
            }
        }

        double stdDevMs = Math.Sqrt(sumSquaredDiff / (n - 1));
        double iqrMs = p75Ms - p25Ms;
        double cv = stdDevMs / meanMs;
        double? gpuBusyAvg = gpuBusyRatios.Count > 0 ? Math.Round(gpuBusyRatios.Average(), 1) : null;

        return new RealFrametimeBenchmarkRun(
            RunId: Guid.NewGuid(),
            ConfigurationTag: configurationTag,
            TargetProcessName: targetProcessName,
            ScenarioNotes: scenarioNotes,
            CapturedAt: DateTimeOffset.Now,
            Status: BenchmarkCaptureStatus.ValidCapture,
            StatusExplanation: $"Captura válida completada: {n} fotogramas presentados en {captureDurationSec:F1} s.",
            CaptureDurationSeconds: captureDurationSec,
            TotalRawFrames: rawSamples.Count,
            WarmupDiscardedFrames: warmupDiscarded,
            DroppedFramesCount: droppedCount,
            ValidEvaluatedFrames: n,
            AverageFrametimeMs: Math.Round(meanMs, 3),
            AverageFps: Math.Round(avgFps, 1),
            MedianFrametimeMs: Math.Round(medianMs, 3),
            P95FrametimeMs: Math.Round(p95Ms, 3),
            P99FrametimeMs: Math.Round(p99Ms, 3),
            P99Point9FrametimeMs: p999Ms,
            OnePercentLowPercentileFps: Math.Round(onePercentPercentileFps, 1),
            OnePercentLowAverageFps: Math.Round(onePercentLowAvgFps, 1),
            PointOnePercentLowPercentileFps: pointOnePercentileFps,
            PointOnePercentLowAverageFps: pointOneAverageFps,
            PointOnePercentLowNotice: pointOneNotice,
            StandardDeviationMs: Math.Round(stdDevMs, 3),
            InterquartileRangeMs: Math.Round(iqrMs, 3),
            CoefficientOfVariation: Math.Round(cv, 4),
            StutterSpikeCount: stutterSpikes,
            GpuBusyRatioPercent: gpuBusyAvg,
            BackgroundProcessCountDuringRun: backgroundProcessCount,
            SystemAvailableRamGbDuringRun: Math.Round(availableRamGb, 2)
        );
    }

    public static double CalculateLinearPercentile(double[] sortedAscending, double percentile)
    {
        if (sortedAscending.Length == 0) return 0.0;
        if (sortedAscending.Length == 1) return sortedAscending[0];

        double clampedP = Math.Clamp(percentile, 0.0, 1.0);
        double continuousIndex = clampedP * (sortedAscending.Length - 1);
        int lowerIndex = (int)Math.Floor(continuousIndex);
        int upperIndex = (int)Math.Ceiling(continuousIndex);

        if (lowerIndex == upperIndex)
        {
            return sortedAscending[lowerIndex];
        }

        double fraction = continuousIndex - lowerIndex;
        return (sortedAscending[lowerIndex] * (1.0 - fraction)) + (sortedAscending[upperIndex] * fraction);
    }

    private static double CalculateWorstTimeIntegralAverageMs(
        double[] sortedAscending,
        double totalDurationMs,
        double tailTimeFraction)
    {
        double targetTailDurationMs = totalDurationMs * tailTimeFraction;
        double accumulatedDurationMs = 0.0;
        double sumFrametimes = 0.0;
        int count = 0;

        for (int i = sortedAscending.Length - 1; i >= 0; i--)
        {
            double frameMs = sortedAscending[i];
            sumFrametimes += frameMs;
            accumulatedDurationMs += frameMs;
            count++;

            if (accumulatedDurationMs >= targetTailDurationMs)
            {
                break;
            }
        }

        return count > 0 ? sumFrametimes / count : sortedAscending[^1];
    }

    private static RealFrametimeBenchmarkRun CreateInsufficientDataRun(
        string configurationTag,
        string targetProcessName,
        string scenarioNotes,
        BenchmarkCaptureStatus status,
        string explanation,
        int rawFrames,
        int warmupDiscarded,
        int dropped,
