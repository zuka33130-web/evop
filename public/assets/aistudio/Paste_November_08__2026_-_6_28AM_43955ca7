using System.IO;
using System.Runtime.InteropServices;
using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;
using EvoOptimizer.Infrastructure.Native;
using Microsoft.Win32;

namespace EvoOptimizer.Infrastructure.Services;

public sealed class WindowsHardwareIntelligenceService :
    IHardwareIntelligenceEngine,
    ISystemIntelligenceEngine,
    IGpuIntelligenceEngine,
    IMemoryIntelligenceEngine,
    IStorageIntelligenceEngine
{
    private HardwareSystemProfile? _cachedProfile;

    public HardwareSystemProfile InspectHardwareProfile()
    {
        if (_cachedProfile is not null)
        {
            return _cachedProfile;
        }

        string cpuName = ReadCpuModelFromRegistry();
        int logicalCores = Environment.ProcessorCount;
        double totalRamGb = ReadTotalPhysicalMemoryGb();
        MemoryCapacityTier memoryTier = ClassifyMemoryTier(totalRamGb);
        var (gpuName, gpuVramGb, gpuTier) = InspectPrimaryGpu();
        var (driveName, driveFormat, driveTotalGb, _, _) = InspectSystemVolume();

        _cachedProfile = new HardwareSystemProfile(
            MachineName: Environment.MachineName,
            OsDescription: RuntimeInformation.OSDescription.Trim(),
            OsVersionBuild: GetOsVersionBuild(),
            CpuModelName: cpuName,
            LogicalCoreCount: logicalCores,
            TotalPhysicalMemoryGb: Math.Round(totalRamGb, 2),
            MemoryTier: memoryTier,
            PrimaryGpuName: gpuName,
            ReportedGpuMemoryGb: Math.Round(gpuVramGb, 2),
            GpuTier: gpuTier,
            SystemDriveName: driveName,
            SystemDriveFormat: driveFormat,
            SystemDriveTotalGb: Math.Round(driveTotalGb, 1),
            ActivePowerSchemeName: GetActivePowerSchemeName(),
            ProfileCapturedAt: DateTimeOffset.Now
        );

        return _cachedProfile;
    }

    public WindowsKernelGamingProfile InspectKernelAndGamingProfile()
    {
        var (minResMs, maxResMs, curResMs) = QueryKernelTimerResolutionMs();

        bool hagsEnabled = false;
        try
        {
            using var gfxKey = Registry.LocalMachine.OpenSubKey(@"SYSTEM\CurrentControlSet\Control\GraphicsDrivers");
            if (gfxKey?.GetValue("HwSchMode") is int hwSch)
            {
                hagsEnabled = hwSch == 2;
            }
        }
        catch { }

        bool vbsActive = false;
        try
        {
            using var dgKey = Registry.LocalMachine.OpenSubKey(@"SYSTEM\CurrentControlSet\Control\DeviceGuard");
            if (dgKey?.GetValue("EnableVirtualizationBasedSecurity") is int vbsVal)
            {
                vbsActive = vbsVal == 1;
            }
        }
        catch { }

        bool gameDvrRecording = false;
        try
        {
            using var dvrKey = Registry.CurrentUser.OpenSubKey(@"System\GameConfigStore");
            bool fseEnabled = (dvrKey?.GetValue("GameDVR_Enabled") is int dvrVal) && dvrVal == 1;
            using var appCaptureKey = Registry.CurrentUser.OpenSubKey(@"SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR");
            bool histCapture = (appCaptureKey?.GetValue("AppCaptureEnabled") is int capVal) && capVal == 1;
            gameDvrRecording = fseEnabled || histCapture;
        }
        catch { }

        int systemResponsiveness = 20;
        int networkThrottling = 10;
        try
        {
            using var mmcssKey = Registry.LocalMachine.OpenSubKey(@"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile");
            if (mmcssKey?.GetValue("SystemResponsiveness") is int srVal)
            {
                systemResponsiveness = srVal;
            }
            if (mmcssKey?.GetValue("NetworkThrottlingIndex") is int ntVal)
            {
                networkThrottling = ntVal;
            }
        }
        catch { }

        return new WindowsKernelGamingProfile(
            MinimumTimerResolutionMs: minResMs,
            MaximumTimerResolutionMs: maxResMs,
            CurrentTimerResolutionMs: curResMs,
            IsHardwareAcceleratedGpuSchedulingEnabled: hagsEnabled,
            IsVirtualizationBasedSecurityActive: vbsActive,
            IsGameDvrBackgroundRecordingEnabled: gameDvrRecording,
            MmcssSystemResponsivenessPercent: systemResponsiveness,
            MmcssNetworkThrottlingIndex: networkThrottling
        );
    }

    public static (double MinMs, double MaxMs, double CurrentMs) QueryKernelTimerResolutionMs()
    {
        try
        {
            int status = Win32NativeMethods.NtQueryTimerResolution(
                out uint maxRes100Ns,
                out uint minRes100Ns,
                out uint currentRes100Ns);

            if (status == 0)
            {
                // 10,000 unidades de 100ns = 1 milisegundo
                return (
                    Math.Round(minRes100Ns / 10_000.0, 4),
                    Math.Round(maxRes100Ns / 10_000.0, 4),
                    Math.Round(currentRes100Ns / 10_000.0, 4)
                );
            }
        }
        catch { }

        return (0.5000, 15.6250, 15.6250);
    }

    public MemoryCapacityTier ClassifyMemoryTier(double totalPhysicalGb)
    {
        if (totalPhysicalGb <= 9.0)
            return MemoryCapacityTier.Constrained_8GBOrLess;

        if (totalPhysicalGb <= 20.0)
            return MemoryCapacityTier.Balanced_12To16GB;

        return MemoryCapacityTier.Abundant_32GBPlus;
    }

    public string GetOsVersionBuild()
    {
        try
        {
            using var key = Registry.LocalMachine.OpenSubKey(@"SOFTWARE\Microsoft\Windows NT\CurrentVersion");
            if (key is not null)
            {
                string displayVersion = key.GetValue("DisplayVersion")?.ToString() ?? "N/A";
                string currentBuild = key.GetValue("CurrentBuild")?.ToString() ?? Environment.OSVersion.Version.Build.ToString();
                string ubr = key.GetValue("UBR")?.ToString() ?? "0";
                return $"Win11/10 {displayVersion} (Build {currentBuild}.{ubr})";
            }
        }
        catch { }

        return Environment.OSVersion.VersionString;
    }

    public string GetActivePowerSchemeName()
    {
        try
        {
            using var powerKey = Registry.LocalMachine.OpenSubKey(@"SYSTEM\CurrentControlSet\Control\Power\User\PowerSchemes");
            string? activeGuid = powerKey?.GetValue("ActivePowerScheme")?.ToString();

            if (!string.IsNullOrWhiteSpace(activeGuid))
            {
                return activeGuid.ToLowerInvariant() switch
                {
                    "381b4222-f694-41f0-9685-ff5bb260df2e" => "Balanced (Equilibrado)",
                    "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c" => "High Performance (Alto Rendimiento)",
                    "a1841308-3541-4fab-bc81-f71556f20b4a" => "Power Saver (Economizador)",
                    "e9a42b02-d5df-448d-aa00-03f14749eb61" => "Ultimate Performance (Máximo Rendimiento)",
                    _ => $"Custom Plan ({activeGuid[..8]}...)"
                };
            }
        }
        catch { }

        return "Estándar del Sistema";
    }

    public (string AdapterName, double DedicatedVramGb, GpuArchitectureTier Tier) InspectPrimaryGpu()
    {
        const string displayClassKeyPath = @"SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}";

        try
        {
            using var classKey = Registry.LocalMachine.OpenSubKey(displayClassKeyPath);
            if (classKey is not null)
            {
                string bestAdapterName = "Adaptador Gráfico Estándar";
                double bestVramGb = 0.0;

                foreach (string subKeyName in classKey.GetSubKeyNames())
                {
                    if (!subKeyName.StartsWith('0'))
                        continue;

                    using var adapterKey = classKey.OpenSubKey(subKeyName);
                    string? desc = adapterKey?.GetValue("DriverDesc")?.ToString();
                    if (string.IsNullOrWhiteSpace(desc) || desc.Contains("Basic Display", StringComparison.OrdinalIgnoreCase))
                        continue;

                    double vramGb = ExtractVramGbFromRegistryKey(adapterKey);
                    if (vramGb >= bestVramGb)
                    {
                        bestAdapterName = desc.Trim();
                        bestVramGb = vramGb;
                    }
                }

                GpuArchitectureTier tier = ClassifyGpuTier(bestAdapterName, bestVramGb);
                return (bestAdapterName, bestVramGb, tier);
            }
        }
        catch { }

        return ("GPU No Identificada", 0.0, GpuArchitectureTier.UnknownOrBasic);
    }

    public (string DriveName, string Format, double TotalGb, double FreeGb, double FreePercent) InspectSystemVolume()
    {
        try
        {
            string systemRoot = Path.GetPathRoot(Environment.SystemDirectory) ?? "C:\\";
            var drive = new DriveInfo(systemRoot);
            if (drive.IsReady)
            {
                double totalGb = drive.TotalSize / (1024.0 * 1024.0 * 1024.0);
                double freeGb = drive.AvailableFreeSpace / (1024.0 * 1024.0 * 1024.0);
                double freePercent = totalGb > 0 ? (freeGb / totalGb) * 100.0 : 0.0;
                return (drive.Name, drive.DriveFormat, totalGb, freeGb, freePercent);
            }
        }
        catch { }

        return ("C:\\", "NTFS", 0, 0, 0);
    }

    private static string ReadCpuModelFromRegistry()
    {
        try
        {
            using var cpuKey = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DESCRIPTION\System\CentralProcessor\0");
            string? name = cpuKey?.GetValue("ProcessorNameString")?.ToString();
            if (!string.IsNullOrWhiteSpace(name))
            {
                return name.Trim();
            }
        }
        catch { }

        return Environment.GetEnvironmentVariable("PROCESSOR_IDENTIFIER") ?? "Procesador x64 Compatible";
    }

    private static double ReadTotalPhysicalMemoryGb()
    {
        var memStatus = Win32NativeMethods.MEMORYSTATUSEX.Create();
        if (Win32NativeMethods.GlobalMemoryStatusEx(ref memStatus) && memStatus.ullTotalPhys > 0)
        {
            return memStatus.ullTotalPhys / (1024.0 * 1024.0 * 1024.0);
        }

        long gcMem = GC.GetGCMemoryInfo().TotalAvailableMemoryBytes;
        return gcMem / (1024.0 * 1024.0 * 1024.0);
    }

    private static double ExtractVramGbFromRegistryKey(RegistryKey? adapterKey)
    {
        if (adapterKey is null) return 0.0;

        object? qwMem = adapterKey.GetValue("HardwareInformation.qwMemorySize");
        if (qwMem is long longBytes && longBytes > 0)
        {
            return longBytes / (1024.0 * 1024.0 * 1024.0);
        }
        if (qwMem is byte[] byteArr && byteArr.Length >= 8)
        {
            ulong bytes = BitConverter.ToUInt64(byteArr, 0);
            return bytes / (1024.0 * 1024.0 * 1024.0);
        }

        object? dwMem = adapterKey.GetValue("HardwareInformation.MemorySize");
        if (dwMem is int intBytes && intBytes > 0)
        {
            return (uint)intBytes / (1024.0 * 1024.0 * 1024.0);
        }

        return 0.0;
    }

    private static GpuArchitectureTier ClassifyGpuTier(string adapterName, double vramGb)
    {
        bool looksIntegrated =
            adapterName.Contains("UHD", StringComparison.OrdinalIgnoreCase) ||
            adapterName.Contains("Iris", StringComparison.OrdinalIgnoreCase) ||
            adapterName.Contains("Radeon(TM) Graphics", StringComparison.OrdinalIgnoreCase) ||
            adapterName.Contains("Vega", StringComparison.OrdinalIgnoreCase);

        if (looksIntegrated || (vramGb > 0 && vramGb <= 2.0))
        {
            return GpuArchitectureTier.IntegratedSharedMemory;
        }

        if (vramGb > 2.0 ||
            adapterName.Contains("RTX", StringComparison.OrdinalIgnoreCase) ||
            adapterName.Contains("GTX", StringComparison.OrdinalIgnoreCase) ||
            adapterName.Contains("RX ", StringComparison.OrdinalIgnoreCase) ||
            adapterName.Contains("Arc ", StringComparison.OrdinalIgnoreCase))
        {
            return GpuArchitectureTier.DedicatedDiscrete;
        }

        return GpuArchitectureTier.UnknownOrBasic;
    }
}
