    [Fact]
    public void SafeInterventionService_DetectsPidReuseMismatch_AndBlocksUnsafeAction()
    {
        var hwService = new WindowsHardwareIntelligenceService();
        var hybridProbe = new HybridSiliconAndCs2ProbeService(hwService);
        var interventionService = new SafeTransactionalInterventionService(hybridProbe);

        // Simulamos un ProcessIdentity con el PID actual pero un CreationTimeUtcTicks falso (como si el PID hubiera sido reutilizado)
        var forgedIdentity = new ProcessIdentity(
            ProcessId: Environment.ProcessId,
            CreationTimeUtcTicks: 123456789L,
            ProcessName: "ForgedProcess",
            ExecutablePath: "C:\\forged.exe");

        var record = interventionService.ApplyBackgroundProcessEcoQosAndLowPriority(
            forgedIdentity,
            userExplicitConsentGranted: true);

        Assert.False(record.AppliedSuccessfully);
