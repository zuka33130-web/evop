using System.Diagnostics;
using System.Runtime.InteropServices;
using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;
using EvoOptimizer.Infrastructure.Native;

namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// Motor de ejecución segura y rollback auditable (Sección 6):
/// - Exige permiso explícito del usuario (userExplicitConsentGranted == true).
/// - Verifica ProcessId + CreationTimeUtcTicks antes de aplicar y antes de revertir (protección ante PID reutilizado).
/// - Detecta modificaciones externas posteriores antes de ejecutar rollback.
/// - Jamás utiliza EmptyWorkingSet ni presenta acciones irreversibles como reversibles.
/// </summary>
public sealed class SafeTransactionalInterventionService : ISafeTransactionalInterventionService
{
    private sealed class InternalRollbackState
    {
        public required VerifiedInterventionRecord Record { get; set; }
        public int? OriginalPriorityClass { get; init; }
        public uint[]? OriginalCpuSetIds { get; init; }
        public uint? AppliedTimerResolution100Ns { get; init; }
        public int? ExpectedAppliedPriorityClass { get; init; }
        public uint[]? ExpectedAppliedCpuSetIds { get; init; }
    }

    private readonly IHybridSiliconAndCs2ProbeService _probeService;
    private readonly List<InternalRollbackState> _ledger = [];

    public SafeTransactionalInterventionService(IHybridSiliconAndCs2ProbeService probeService)
    {
        _probeService = probeService;
    }

    public IReadOnlyList<VerifiedInterventionRecord> GetInterventionLedger() =>
        _ledger.Select(x => x.Record).ToList();

    public VerifiedInterventionRecord ApplyBackgroundProcessEcoQosAndLowPriority(
        ProcessIdentity targetProcess,
        bool userExplicitConsentGranted)
    {
        if (!userExplicitConsentGranted)
        {
            return CreateRejectedRecord(
                "PROC-SINGLE-ECOQOS-CONTAINMENT",
                "Operación rechazada: Se requiere consentimiento explícito del usuario.",
                targetProcess);
        }

        if (!_probeService.VerifyProcessIdentityStillMatches(targetProcess))
        {
            return CreateRejectedRecord(
                "PROC-SINGLE-ECOQOS-CONTAINMENT",
                $"Abortado por seguridad: El PID {targetProcess.ProcessId} ya no corresponde al proceso original '{targetProcess.ProcessName}' (cerrado o PID reutilizado).",
                targetProcess);
        }

        try
        {
            using var proc = Process.GetProcessById(targetProcess.ProcessId);
            int originalPrio = (int)proc.PriorityClass;
            string prevSnapshot = $"PriorityClass={proc.PriorityClass}, EcoQoS=Default";

            proc.PriorityClass = ProcessPriorityClass.BelowNormal;
            bool ecoSuccess = SetProcessEcoQosState(proc.Handle, enable: true);
            int verifiedNewPrio = (int)proc.PriorityClass;

            bool success = verifiedNewPrio == (int)ProcessPriorityClass.BelowNormal;
            string appliedSnapshot = $"PriorityClass={(ProcessPriorityClass)verifiedNewPrio}, EcoQoS={(ecoSuccess ? "Enabled" : "Unchanged")}";

            var record = new VerifiedInterventionRecord(
                OperationId: Guid.NewGuid(),
                RecommendationId: "PROC-SINGLE-ECOQOS-CONTAINMENT",
                Description: $"EcoQoS + BelowNormal en {targetProcess.ProcessName} (PID {targetProcess.ProcessId})",
                AppliedAtUtc: DateTimeOffset.UtcNow,
                UserExplicitConsentGranted: true,
                TargetProcess: targetProcess,
                ResourceIdentifier: $"Process:{targetProcess.ProcessName}:PID={targetProcess.ProcessId}:StartTicks={targetProcess.CreationTimeUtcTicks}",
                PreviousStateSnapshot: prevSnapshot,
                AppliedStateSnapshot: appliedSnapshot,
                AppliedSuccessfully: success,
                CurrentVerificationState: RollbackVerificationState.ActiveUnchangedExternally,
                VerificationMessage: "Estado verificado tras aplicación.",
                RevertedAtUtc: null
            );

            _ledger.Insert(0, new InternalRollbackState
            {
                Record = record,
                OriginalPriorityClass = originalPrio,
                ExpectedAppliedPriorityClass = verifiedNewPrio
            });

            return record;
        }
        catch (Exception ex)
        {
            return CreateRejectedRecord(
                "PROC-SINGLE-ECOQOS-CONTAINMENT",
                $"Fallo al aplicar sobre {targetProcess.ProcessName} (PID {targetProcess.ProcessId}): {ex.Message}",
                targetProcess);
        }
    }

    public VerifiedInterventionRecord ApplyBackgroundProcessECoreCpuSets(
        ProcessIdentity targetProcess,
        HybridCpuTopologyProfile topology,
        bool userExplicitConsentGranted)
    {
        if (!userExplicitConsentGranted)
        {
            return CreateRejectedRecord(
                "HYBRID-CPUSETS-ECORE-STEER",
                "Operación rechazada: Se requiere consentimiento explícito del usuario.",
                targetProcess);
        }

        if (!topology.IsHybridArchitecture || topology.ECoreLogicalProcessors.Count == 0)
        {
            return CreateRejectedRecord(
                "HYBRID-CPUSETS-ECORE-STEER",
                "Operación no aplicable: El procesador no reporta núcleos E-Core (EfficiencyClass = 0).",
                targetProcess);
        }

        if (!_probeService.VerifyProcessIdentityStillMatches(targetProcess))
        {
            return CreateRejectedRecord(
                "HYBRID-CPUSETS-ECORE-STEER",
                $"Abortado por seguridad: El PID {targetProcess.ProcessId} fue reutilizado o el proceso terminó.",
                targetProcess);
        }

        try
        {
            using var proc = Process.GetProcessById(targetProcess.ProcessId);
            uint[] originalCpuSets = HybridSiliconAndCs2ProbeService.QueryProcessAssignedCpuSets(proc.Handle);
            uint[] targetECoreSetIds = topology.ECoreLogicalProcessors.Select(c => c.CpuSetId).Distinct().ToArray();

            string prevSnap = originalCpuSets.Length == 0
                ? "CpuSets=Default(AllCores)"
                : $"CpuSets=[{string.Join(",", originalCpuSets)}]";

            bool applied = Win32NativeMethods.SetProcessDefaultCpuSets(
                proc.Handle,
                targetECoreSetIds,
                (uint)targetECoreSetIds.Length);

            uint[] readBackSets = HybridSiliconAndCs2ProbeService.QueryProcessAssignedCpuSets(proc.Handle);
            bool verified = applied && readBackSets.Length == targetECoreSetIds.Length;

            string afterSnap = $"CpuSets(E-Cores)=[{string.Join(",", readBackSets)}]";

            var record = new VerifiedInterventionRecord(
                OperationId: Guid.NewGuid(),
                RecommendationId: "HYBRID-CPUSETS-ECORE-STEER",
                Description: $"Confinamiento flexible CPU Sets (E-Cores) en {targetProcess.ProcessName} (PID {targetProcess.ProcessId})",
                AppliedAtUtc: DateTimeOffset.UtcNow,
                UserExplicitConsentGranted: true,
                TargetProcess: targetProcess,
                ResourceIdentifier: $"CpuSets:{targetProcess.ProcessName}:PID={targetProcess.ProcessId}:StartTicks={targetProcess.CreationTimeUtcTicks}",
                PreviousStateSnapshot: prevSnap,
                AppliedStateSnapshot: afterSnap,
                AppliedSuccessfully: verified,
                CurrentVerificationState: RollbackVerificationState.ActiveUnchangedExternally,
                VerificationMessage: verified
                    ? $"Asignados {readBackSets.Length} E-Cores vía SetProcessDefaultCpuSets."
                    : "El sistema operativo no confirmó el cambio de CPU Sets.",
                RevertedAtUtc: null
            );

            _ledger.Insert(0, new InternalRollbackState
            {
                Record = record,
                OriginalCpuSetIds = originalCpuSets,
                ExpectedAppliedCpuSetIds = readBackSets
            });

            return record;
        }
        catch (Exception ex)
        {
            return CreateRejectedRecord(
                "HYBRID-CPUSETS-ECORE-STEER",
                $"Error en SetProcessDefaultCpuSets: {ex.Message}",
                targetProcess);
        }
    }

    public VerifiedInterventionRecord ApplySessionTimerResolution(
        uint desiredResolution100Ns,
        bool userExplicitConsentGranted)
    {
        if (!userExplicitConsentGranted)
        {
            return CreateRejectedRecord(
                "TIMER-KERNEL-SESSION",
                "Operación rechazada: Se requiere consentimiento explícito del usuario.",
                null);
        }

        try
        {
            _ = Win32NativeMethods.NtQueryTimerResolution(out _, out uint min100Ns, out uint before100Ns);
            uint target100Ns = Math.Max(min100Ns, desiredResolution100Ns);
            int status = Win32NativeMethods.NtSetTimerResolution(target100Ns, setResolution: true, out uint after100Ns);

            var selfId = _probeService.CaptureProcessIdentity(Environment.ProcessId);

            var record = new VerifiedInterventionRecord(
                OperationId: Guid.NewGuid(),
                RecommendationId: "TIMER-KERNEL-SESSION",
                Description: $"Solicitud de Timer Resolution de sesión ({target100Ns / 10_000.0:F3} ms)",
                AppliedAtUtc: DateTimeOffset.UtcNow,
                UserExplicitConsentGranted: true,
                TargetProcess: selfId,
                ResourceIdentifier: "ntdll!NtSetTimerResolution(CurrentProcess)",
                PreviousStateSnapshot: $"TimerResolution={before100Ns / 10_000.0:F4} ms",
                AppliedStateSnapshot: $"TimerResolution={after100Ns / 10_000.0:F4} ms",
                AppliedSuccessfully: status == 0,
                CurrentVerificationState: RollbackVerificationState.ActiveUnchangedExternally,
                VerificationMessage: status == 0 ? "Voto de temporizador registrado en ntdll." : $"NtSetTimerResolution devolvió NTSTATUS 0x{status:X8}.",
                RevertedAtUtc: null
            );

            _ledger.Insert(0, new InternalRollbackState
            {
                Record = record,
                AppliedTimerResolution100Ns = target100Ns
            });

            return record;
        }
        catch (Exception ex)
        {
            return CreateRejectedRecord("TIMER-KERNEL-SESSION", ex.Message, null);
        }
    }

    public RollbackVerificationState VerifyExternalDrift(Guid operationId)
    {
        var entry = _ledger.FirstOrDefault(x => x.Record.OperationId == operationId);
        if (entry is null) return RollbackVerificationState.RevertFailed;
        if (entry.Record.RevertedAtUtc.HasValue) return RollbackVerificationState.SuccessfullyReverted;

        if (entry.Record.TargetProcess is not null)
        {
            try
            {
                using var proc = Process.GetProcessById(entry.Record.TargetProcess.ProcessId);
                long startTicks = proc.StartTime.ToUniversalTime().Ticks;
                if (startTicks != entry.Record.TargetProcess.CreationTimeUtcTicks)
                {
                    entry.Record = entry.Record with
                    {
                        CurrentVerificationState = RollbackVerificationState.PidReusedByDifferentProcess,
                        VerificationMessage = $"ALERTA DE SEGURIDAD: El PID {proc.Id} ahora pertenece a otro proceso creado posteriormente. Rollback bloqueado para no alterar un proceso ajeno."
                    };
                    return RollbackVerificationState.PidReusedByDifferentProcess;
                }

                if (entry.ExpectedAppliedPriorityClass.HasValue &&
                    (int)proc.PriorityClass != entry.ExpectedAppliedPriorityClass.Value)
                {
                    entry.Record = entry.Record with
                    {
                        CurrentVerificationState = RollbackVerificationState.ExternalModificationDetected,
                        VerificationMessage = $"Deriva externa detectada: La prioridad actual es {proc.PriorityClass} en lugar del valor esperado {(ProcessPriorityClass)entry.ExpectedAppliedPriorityClass.Value}."
                    };
                    return RollbackVerificationState.ExternalModificationDetected;
                }

                if (entry.ExpectedAppliedCpuSetIds is not null)
                {
                    uint[] currentSets = HybridSiliconAndCs2ProbeService.QueryProcessAssignedCpuSets(proc.Handle);
                    if (!currentSets.SequenceEqual(entry.ExpectedAppliedCpuSetIds))
                    {
                        entry.Record = entry.Record with
                        {
                            CurrentVerificationState = RollbackVerificationState.ExternalModificationDetected,
                            VerificationMessage = "Deriva externa detectada: Los CPU Sets del proceso fueron modificados externamente."
                        };
                        return RollbackVerificationState.ExternalModificationDetected;
                    }
                }
            }
            catch
            {
                entry.Record = entry.Record with
                {
                    CurrentVerificationState = RollbackVerificationState.TargetProcessExited,
                    VerificationMessage = "El proceso objetivo ya finalizó su ejecución naturalmente."
                };
                return RollbackVerificationState.TargetProcessExited;
            }
        }

        return RollbackVerificationState.ActiveUnchangedExternally;
    }

    public bool RevertOperation(Guid operationId, out string verificationDetails)
    {
        var entry = _ledger.FirstOrDefault(x => x.Record.OperationId == operationId);
        if (entry is null)
        {
            verificationDetails = "Operación no encontrada en el registro transaccional.";
            return false;
        }

        RollbackVerificationState driftState = VerifyExternalDrift(operationId);

        if (driftState == RollbackVerificationState.PidReusedByDifferentProcess)
        {
            verificationDetails = entry.Record.VerificationMessage;
            return false;
        }

        if (driftState == RollbackVerificationState.TargetProcessExited)
        {
            entry.Record = entry.Record with { RevertedAtUtc = DateTimeOffset.UtcNow };
            verificationDetails = "El proceso ya había finalizado; el recurso fue liberado por el sistema operativo.";
            return true;
        }

        try
        {
            if (entry.AppliedTimerResolution100Ns.HasValue)
            {
                _ = Win32NativeMethods.NtSetTimerResolution(entry.AppliedTimerResolution100Ns.Value, setResolution: false, out uint cur100Ns);
                entry.Record = entry.Record with
                {
                    CurrentVerificationState = RollbackVerificationState.SuccessfullyReverted,
                    VerificationMessage = $"Voto de Timer liberado correctamente (Resolución actual: {cur100Ns / 10_000.0:F4} ms).",
                    RevertedAtUtc = DateTimeOffset.UtcNow
                };
                verificationDetails = entry.Record.VerificationMessage;
                return true;
            }

            if (entry.Record.TargetProcess is not null)
            {
                using var proc = Process.GetProcessById(entry.Record.TargetProcess.ProcessId);

                if (entry.OriginalPriorityClass.HasValue)
                {
                    proc.PriorityClass = (ProcessPriorityClass)entry.OriginalPriorityClass.Value;
                    _ = SetProcessEcoQosState(proc.Handle, enable: false);
                }

                if (entry.OriginalCpuSetIds is not null)
                {
                    if (entry.OriginalCpuSetIds.Length == 0)
                    {
                        _ = Win32NativeMethods.SetProcessDefaultCpuSets(proc.Handle, null, 0);
                    }
                    else
                    {
                        _ = Win32NativeMethods.SetProcessDefaultCpuSets(proc.Handle, entry.OriginalCpuSetIds, (uint)entry.OriginalCpuSetIds.Length);
                    }
                }

                string driftNote = driftState == RollbackVerificationState.ExternalModificationDetected
                    ? " (Nota: se había detectado una modificación externa previa)."
                    : string.Empty;

                entry.Record = entry.Record with
                {
                    CurrentVerificationState = RollbackVerificationState.SuccessfullyReverted,
                    VerificationMessage = $"Estado previo restaurado y verificado para PID {proc.Id}{driftNote}.",
                    RevertedAtUtc = DateTimeOffset.UtcNow
                };

                verificationDetails = entry.Record.VerificationMessage;
                return true;
            }
        }
        catch (Exception ex)
        {
            entry.Record = entry.Record with
            {
                CurrentVerificationState = RollbackVerificationState.RevertFailed,
                VerificationMessage = $"Error durante la reversión: {ex.Message}"
            };
            verificationDetails = entry.Record.VerificationMessage;
            return false;
        }

        verificationDetails = "No se encontró acción de reversión aplicable.";
        return false;
    }

    public int RevertAllActiveOperations(out IReadOnlyList<string> auditMessages)
    {
        var messages = new List<string>();
        int count = 0;

        foreach (var entry in _ledger.Where(x => !x.Record.RevertedAtUtc.HasValue && x.Record.AppliedSuccessfully).ToList())
        {
            if (RevertOperation(entry.Record.OperationId, out string msg))
            {
                count++;
            }
            messages.Add($"[{entry.Record.Description}] -> {msg}");
        }

        auditMessages = messages;
        return count;
    }

    private static bool SetProcessEcoQosState(nint handle, bool enable)
    {
        try
        {
            var state = new Win32NativeMethods.PROCESS_POWER_THROTTLING_STATE
            {
                Version = Win32NativeMethods.PROCESS_POWER_THROTTLING_CURRENT_VERSION,
                ControlMask = Win32NativeMethods.PROCESS_POWER_THROTTLING_EXECUTION_SPEED,
                StateMask = enable ? Win32NativeMethods.PROCESS_POWER_THROTTLING_EXECUTION_SPEED : 0u
            };

            return Win32NativeMethods.SetProcessInformation(
                handle,
                Win32NativeMethods.ProcessPowerThrottlingInformationClass,
                ref state,
                Marshal.SizeOf<Win32NativeMethods.PROCESS_POWER_THROTTLING_STATE>());
        }
        catch
        {
            return false;
        }
    }

    private static VerifiedInterventionRecord CreateRejectedRecord(
        string recommendationId,
        string reason,
        ProcessIdentity? target)
    {
        return new VerifiedInterventionRecord(
            OperationId: Guid.NewGuid(),
            RecommendationId: recommendationId,
            Description: reason,
            AppliedAtUtc: DateTimeOffset.UtcNow,
            UserExplicitConsentGranted: false,
            TargetProcess: target,
            ResourceIdentifier: target?.ProcessName ?? "N/A",
            PreviousStateSnapshot: "Sin cambios",
            AppliedStateSnapshot: "Sin cambios",
            AppliedSuccessfully: false,
            CurrentVerificationState: RollbackVerificationState.RevertFailed,
            VerificationMessage: reason,
            RevertedAtUtc: DateTimeOffset.UtcNow
        );
    }
}
