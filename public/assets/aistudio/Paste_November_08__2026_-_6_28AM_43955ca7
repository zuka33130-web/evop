                VerifiedInterventionsLedger = _safeInterventionService.GetInterventionLedger(),
                AuditedWindowsInternals = _internalsCatalogService.GetAuditedMechanismsCatalog()
            };

            string desktop = Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory);
            string filePath = Path.Combine(desktop, $"EVO_RealEngine_Audit_{DateTime.Now:yyyyMMdd_HHmmss}.json");
            File.WriteAllText(filePath, JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true }));
            LastActionStatusBanner = $"AUDITORÍA EXPORTADA: {filePath}";
        }
        catch (Exception ex)
        {
            LastActionStatusBanner = $"Error al exportar auditoría: {ex.Message}";
        }
    }

    private void ExecuteTelemetryCycle(bool forceRefreshRecommendations)
    {
        SystemTelemetrySnapshot snapshot = _telemetryEngine.CaptureSnapshot();
        Cs2ProcessTelemetry cs2 = _hybridCs2Probe.InspectCs2Process();

        CpuUtilizationPercent = snapshot.CpuTotalUtilizationPercent;
        CpuClockAndThrottleText = snapshot.IsCpuPowerOrThermalThrottled
            ? $"Reloj: {snapshot.CpuCurrentClockMhz} MHz (THROTTLED Límite: {snapshot.CpuLimitClockMhz} MHz)"
            : $"Reloj: {snapshot.CpuCurrentClockMhz} / {snapshot.CpuMaxClockMhz} MHz | {snapshot.TotalRunningProcesses} Procs ({snapshot.TotalSystemThreads} Hilos)";

        RamLoadPercent = snapshot.PhysicalMemoryLoadPercent;
        RamUsageDetailText = $"{snapshot.PhysicalMemoryUsedGb:F2} / {_hardwareProfile.TotalPhysicalMemoryGb:F1} GB ({snapshot.PhysicalMemoryAvailableGb:F2} GB Libres)";

        CommitLoadPercent = snapshot.CommitChargePercent;
        CommitUsageDetailText = $"{snapshot.CommitChargeTotalGb:F2} / {snapshot.CommitChargeLimitGb:F1} GB Commit Total";

        if (cs2.IsRunning && cs2.Identity is not null)
        {
            Cs2ProcessStatusText =
                $"CS2 ACTIVO (PID {cs2.Identity.ProcessId}) | Working Set: {cs2.WorkingSetMb:F0} MB | Commit Privado: {cs2.PrivateCommitMb:F0} MB | " +
                $"Hilos: {cs2.ThreadCount} | Prioridad: {cs2.CurrentPriorityClass} | Foco: {(cs2.IsForegroundWindow ? "SÍ" : "NO")}";
            Cs2StatusBrush = new SolidColorBrush(Color.FromRgb(0, 230, 118));
        }
        else
        {
            Cs2ProcessStatusText = "CS2 INACTIVO (cs2.exe no detectado) — Estado: Información insuficiente para telemetría en partida.";
            Cs2StatusBrush = new SolidColorBrush(Color.FromRgb(255, 179, 0));
        }

        if (_cpuHistory.Count >= MaxHistorySamples) _cpuHistory.RemoveAt(0);
        if (_ramHistory.Count >= MaxHistorySamples) _ramHistory.RemoveAt(0);
        _cpuHistory.Add(snapshot.CpuTotalUtilizationPercent);
        _ramHistory.Add(snapshot.PhysicalMemoryLoadPercent);
        RebuildWaveformPolylines();

        TopMemoryProcesses.Clear();
        foreach (var proc in snapshot.TopMemoryConsumers)
        {
            TopMemoryProcesses.Add(proc);
        }

        if (forceRefreshRecommendations || EvidenceRecommendations.Count == 0)
        {
            var controllableBg = _hybridCs2Probe.EnumerateControllableBackgroundProcesses();
            var recs = _evidenceAdaptiveEngine.EvaluateRecommendations(
                _hardwareProfile,
                _hybridTopology,
                snapshot,
                cs2,
                controllableBg,
                _latestBenchmarkRun,
                _historicalEngine.GetAllOutcomes());

            EvidenceRecommendations.Clear();
            foreach (var r in recs)
            {
                var (badgeText, badgeBrush) = r.EvidenceState switch
                {
                    EvidenceSufficiencyState.EmpiricalEvidenceAvailable =>
                        ("EVIDENCIA VERIFICABLE DISPONIBLE", new SolidColorBrush(Color.FromRgb(0, 229, 255))),
                    EvidenceSufficiencyState.PreviouslyProvenIneffective =>
                        ("DESCARTADO POR HISTORIAL EMPÍRICO", new SolidColorBrush(Color.FromRgb(255, 61, 87))),
                    _ =>
                        ("INFORMACIÓN INSUFICIENTE", new SolidColorBrush(Color.FromRgb(255, 179, 0)))
                };

                bool canExecute = r.EvidenceState == EvidenceSufficiencyState.EmpiricalEvidenceAvailable &&
                                  r.TargetProcessIdentity is not null &&
                                  r.RequiresExplicitUserConsent;

                EvidenceRecommendations.Add(new RecommendationItemViewModel
                {
                    Source = r,
                    Title = r.Title,
                    Subsystem = r.TargetSubsystem,
                    EvidenceBadgeText = badgeText,
                    EvidenceBadgeBrush = badgeBrush,
                    EvidenceStatement = r.EvidenceStatement,
                    BottleneckDiagnosis = r.BottleneckDiagnosis,
                    ProposedMechanism = $"Mecanismo: {r.ProposedMechanism}",
                    VerificationAndRollbackText = $"Reversión: {r.RollbackProtocol}",
                    ExecuteButtonVisibility = canExecute ? Visibility.Visible : Visibility.Collapsed,
                    ExecuteWithConsentCommand = new RelayCommand(() => ExecuteRecommendationWithUserConsent(r))
                });
            }
        }
    }

    private void RefreshVerifiedLedgerView()
    {
        VerifiedLedgerItems.Clear();
        foreach (var rec in _safeInterventionService.GetInterventionLedger())
        {
            var statusBrush = rec.CurrentVerificationState switch
            {
                RollbackVerificationState.ActiveUnchangedExternally => new SolidColorBrush(Color.FromRgb(0, 229, 255)),
                RollbackVerificationState.SuccessfullyReverted => new SolidColorBrush(Color.FromRgb(0, 230, 118)),
                RollbackVerificationState.ExternalModificationDetected => new SolidColorBrush(Color.FromRgb(255, 179, 0)),
                RollbackVerificationState.PidReusedByDifferentProcess => new SolidColorBrush(Color.FromRgb(255, 61, 87)),
                _ => new SolidColorBrush(Color.FromRgb(138, 153, 173))
            };

            bool canRevert = !rec.RevertedAtUtc.HasValue && rec.AppliedSuccessfully;

            VerifiedLedgerItems.Add(new VerifiedLedgerItemViewModel
            {
                OperationId = rec.OperationId,
                Description = rec.Description,
                ResourceIdentifier = rec.ResourceIdentifier,
                StateTransitionText = $"Antes: [{rec.PreviousStateSnapshot}]  ==>  Aplicado: [{rec.AppliedStateSnapshot}]",
                VerificationStatusText = $"{rec.CurrentVerificationState}: {rec.VerificationMessage}",
                StatusBrush = statusBrush,
                RevertButtonVisibility = canRevert ? Visibility.Visible : Visibility.Collapsed,
                RevertSingleCommand = new RelayCommand(() => ExecuteRevertSingleOperation(rec.OperationId))
            });
        }
    }

    private void RebuildWaveformPolylines()
    {
        var cpuPts = new PointCollection(MaxHistorySamples);
        var ramPts = new PointCollection(MaxHistorySamples);

        double stepX = _graphCanvasWidth / (MaxHistorySamples - 1);

        for (int i = 0; i < _cpuHistory.Count; i++)
        {
            double x = i * stepX;
            double cpuY = _graphCanvasHeight - ((_cpuHistory[i] / 100.0) * (_graphCanvasHeight - 10)) - 5;
            double ramY = _graphCanvasHeight - ((_ramHistory[i] / 100.0) * (_graphCanvasHeight - 10)) - 5;

            cpuPts.Add(new Point(x, Math.Clamp(cpuY, 3, _graphCanvasHeight - 3)));
            ramPts.Add(new Point(x, Math.Clamp(ramY, 3, _graphCanvasHeight - 3)));
        }

        cpuPts.Freeze();
        ramPts.Freeze();

        CpuGraphPoints = cpuPts;
        RamGraphPoints = ramPts;
    }

    private void SetField<T>(ref T field, T value, [CallerMemberName] string? propertyName = null)
    {
        if (EqualityComparer<T>.Default.Equals(field, value)) return;
        field = value;
        OnPropertyChanged(propertyName);
    }

    private void OnPropertyChanged([CallerMemberName] string? propertyName = null) =>
        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
}

public sealed class RelayCommand(Action execute) : ICommand
{
    public event EventHandler? CanExecuteChanged { add { } remove { } }
    public bool CanExecute(object? parameter) => true;
    public void Execute(object? parameter) => execute();
}
