    /// <summary>
    /// Consulta powrprof.dll!CallNtPowerInformation (ProcessorInformation) para extraer
    /// los MHz reales actuales, máximos y el techo de throttling térmico/energético de Windows.
    /// </summary>
    public (int CurrentMhz, int MaxMhz, int LimitMhz, bool IsThrottled) ProbeCpuFrequencyAndThrottling()
    {
        try
        {
            int coreCount = Environment.ProcessorCount;
            int structSize = Marshal.SizeOf<Win32NativeMethods.PROCESSOR_POWER_INFORMATION>();
            int totalBufferSize = structSize * coreCount;
            nint outBuffer = Marshal.AllocHGlobal(totalBufferSize);

            try
            {
                uint status = Win32NativeMethods.CallNtPowerInformation(
                    Win32NativeMethods.ProcessorInformationLevel,
                    nint.Zero,
                    0,
                    outBuffer,
                    (uint)totalBufferSize);

                if (status == 0)
                {
                    long sumCurrentMhz = 0;
                    uint maxMhz = 0;
                    uint minLimitMhz = uint.MaxValue;

                    for (int i = 0; i < coreCount; i++)
                    {
                        var info = Marshal.PtrToStructure<Win32NativeMethods.PROCESSOR_POWER_INFORMATION>(outBuffer + (i * structSize));
                        sumCurrentMhz += info.CurrentMhz;
                        if (info.MaxMhz > maxMhz) maxMhz = info.MaxMhz;
                        if (info.MhzLimit > 0 && info.MhzLimit < minLimitMhz) minLimitMhz = info.MhzLimit;
                    }

                    int avgCurrentMhz = (int)(sumCurrentMhz / Math.Max(1, coreCount));
                    int reportedLimit = minLimitMhz == uint.MaxValue ? (int)maxMhz : (int)minLimitMhz;
                    bool isThrottled = maxMhz > 0 && reportedLimit < maxMhz;

                    return (avgCurrentMhz, (int)maxMhz, reportedLimit, isThrottled);
                }
            }
            finally
            {
                Marshal.FreeHGlobal(outBuffer);
            }
        }
        catch { }

        return (0, 0, 0, false);
    }

    public double MeasureCpuUtilizationPercent()
    {
        if (!Win32NativeMethods.GetSystemTimes(out var idleTime, out var kernelTime, out var userTime))
        {
            return _lastCpuPercent;
        }

        ulong idleTicks = idleTime.ToUInt64();
        ulong totalTicks = kernelTime.ToUInt64() + userTime.ToUInt64();

        ulong totalDelta = totalTicks - _previousTotalTicks;
        ulong idleDelta = idleTicks - _previousIdleTicks;

        _previousTotalTicks = totalTicks;
        _previousIdleTicks = idleTicks;

        if (totalDelta == 0)
        {
            return _lastCpuPercent;
        }

        double busyRatio = 1.0 - ((double)idleDelta / totalDelta);
        _lastCpuPercent = Math.Clamp(busyRatio * 100.0, 0.0, 100.0);
        return _lastCpuPercent;
    }

    public (int ProcessCount, int ThreadCount, IReadOnlyList<ProcessResourceSample> TopConsumers) InspectProcessEcosystem(int topCount = 5)
    {
        var now = DateTimeOffset.Now;
        if ((now - _lastProcessAuditTime).TotalSeconds < 2.0 && _cachedTopProcesses.Count > 0)
        {
            return (_cachedProcessCount, _cachedThreadCount, _cachedTopProcesses);
        }

        Process[] processes = Process.GetProcesses();
        int totalThreads = 0;
        var samples = new List<ProcessResourceSample>(processes.Length);

        foreach (var proc in processes)
        {
            try
            {
                long wsBytes = proc.WorkingSet64;
                int tCount = proc.Threads.Count;
                totalThreads += tCount;

                if (wsBytes > 10 * 1024 * 1024 && proc.Id > 4)
                {
                    samples.Add(new ProcessResourceSample(
                        ProcessId: proc.Id,
                        ProcessName: proc.ProcessName,
                        WorkingSetMb: Math.Round(wsBytes / (1024.0 * 1024.0), 1),
                        ThreadCount: tCount
                    ));
                }
            }
            catch { }
            finally
            {
                proc.Dispose();
            }
        }

        _cachedProcessCount = processes.Length;
        _cachedThreadCount = totalThreads;
        _cachedTopProcesses = samples
            .OrderByDescending(p => p.WorkingSetMb)
            .Take(topCount)
            .ToList();
        _lastProcessAuditTime = now;

        return (_cachedProcessCount, _cachedThreadCount, _cachedTopProcesses);
    }

    public (SensorCalibrationState State, double? PackageTempCelsius) ProbeThermalState()
    {
        // Usamos el estado de límite de frecuencia de powrprof como sensor calibrado de throttling del kernel
        return (SensorCalibrationState.EstimatedFromCounters, null);
    }
}
