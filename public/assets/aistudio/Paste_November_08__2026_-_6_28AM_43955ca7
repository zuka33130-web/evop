    private async Task ExecuteCaptureBaselineBenchmarkAsync()
    {
        if (_isBenchmarkRunning) return;
        _isBenchmarkRunning = true;

        try
        {
            LastActionStatusBanner = "EJECUTANDO MICRO-BENCHMARK DE LÍNEA BASE (450 MUESTRAS QPC DE ALTA FRECUENCIA)...";
            SystemTelemetrySnapshot snap = _telemetryEngine.CaptureSnapshot();
            _baselineBenchmarkSnapshot = await _benchmarkEngine.RunHighFrequencyStabilityBenchmarkAsync("ANTES (Línea Base)", snap);

            BenchmarkBaselineText =
                $"ANTES -> 1% Low (P99): {_baselineBenchmarkSnapshot.OnePercentLowLatencyMs:F3} ms | " +
                $"0.1% Low: {_baselineBenchmarkSnapshot.PointOnePercentLowLatencyMs:F3} ms | " +
                $"RAM Libre: {_baselineBenchmarkSnapshot.AvailablePhysicalRamGb:F2} GB | " +
                $"Timer: {_baselineBenchmarkSnapshot.KernelTimerResolutionMs:F3} ms";

            BenchmarkVerdictText = "Línea Base capturada. Ahora aplica una o más optimizaciones recomendadas y pulsa [2. VALIDAR DESPUÉS].";
            BenchmarkVerdictBrush = new SolidColorBrush(Color.FromRgb(0, 229, 255));
            LastActionStatusBanner = "LÍNEA BASE CAPTURADA: Lista para validación comparativa A/B.";
        }
        finally
        {
            _isBenchmarkRunning = false;
        }
    }

    private async Task ExecuteAfterBenchmarkValidationAsync()
    {
        if (_isBenchmarkRunning) return;
        _isBenchmarkRunning = true;

        try
        {
            SystemTelemetrySnapshot snap = _telemetryEngine.CaptureSnapshot();
            if (_baselineBenchmarkSnapshot is null)
            {
                _baselineBenchmarkSnapshot = await _benchmarkEngine.RunHighFrequencyStabilityBenchmarkAsync("ANTES (Auto-Capturado)", snap);
                BenchmarkBaselineText =
                    $"ANTES -> 1% Low (P99): {_baselineBenchmarkSnapshot.OnePercentLowLatencyMs:F3} ms | " +
                    $"0.1% Low: {_baselineBenchmarkSnapshot.PointOnePercentLowLatencyMs:F3} ms | " +
                    $"RAM Libre: {_baselineBenchmarkSnapshot.AvailablePhysicalRamGb:F2} GB";
            }

            LastActionStatusBanner = "EJECUTANDO BENCHMARK DE VERIFICACIÓN POST-OPTIMIZACIÓN...";
            StabilityBenchmarkSnapshot afterSnap = await _benchmarkEngine.RunHighFrequencyStabilityBenchmarkAsync("DESPUÉS (Optimizado)", snap);
            BenchmarkComparisonReport report = _benchmarkEngine.CompareBenchmarkSnapshots(_baselineBenchmarkSnapshot, afterSnap);

            BenchmarkAfterText =
                $"DESPUÉS -> 1% Low (P99): {afterSnap.OnePercentLowLatencyMs:F3} ms ({report.OnePercentLowImprovementPercent:+0.0;-0.0;0.0}%) | " +
                $"0.1% Low: {afterSnap.PointOnePercentLowLatencyMs:F3} ms | " +
                $"RAM Libre: {afterSnap.AvailablePhysicalRamGb:F2} GB ({report.FreedMemoryMb:+0;-0;0} MB)";

            BenchmarkVerdictText = report.TechnicalVerdict;
            BenchmarkVerdictBrush = report.IsMeasurableImprovement
                ? new SolidColorBrush(Color.FromRgb(0, 230, 118))
                : new SolidColorBrush(Color.FromRgb(255, 179, 0));

            LastActionStatusBanner = report.TechnicalVerdict;
        }
        finally
        {
            _isBenchmarkRunning = false;
        }
    }

    private void ExecuteApplyDecision(AdaptiveDecisionItem decision)
    {
        if (!_optimizationEngine.CanExecuteIntervention(decision, out string reason))
        {
            LastActionStatusBanner = $"AVISO PRE-VUELO: {reason}";
            return;
        }

        InterventionTransactionRecord record = _optimizationEngine.ExecuteAndValidateIntervention(
            decision,
            _selectedObjective,
            _hardwareProfile);

        _kernelProfile = _systemEngine.InspectKernelAndGamingProfile();
        OnPropertyChanged(nameof(KernelGamingBadgesText));

        LastActionStatusBanner = record.ValidationSummary;
        RefreshTransactionHistoryView();
        ExecuteTelemetryAndDecisionCycle(forceRebuildDecisions: true);
    }

    private void ExecuteRevertDecision(string decisionId)
    {
        if (_rollbackEngine.RevertTransactionByDecisionId(decisionId, out string msg))
        {
            _kernelProfile = _systemEngine.InspectKernelAndGamingProfile();
            OnPropertyChanged(nameof(KernelGamingBadgesText));

            LastActionStatusBanner = $"ROLLBACK COMPLETADO: {msg}";
            RefreshTransactionHistoryView();
            ExecuteTelemetryAndDecisionCycle(forceRebuildDecisions: true);
        }
    }

    private void ExecuteRevertAll()
    {
        int count = _rollbackEngine.RevertAllActiveTransactions();
        _kernelProfile = _systemEngine.InspectKernelAndGamingProfile();
        OnPropertyChanged(nameof(KernelGamingBadgesText));

        LastActionStatusBanner = count > 0
            ? $"ROLLBACK GLOBAL EJECUTADO: {count} optimizaciones activas fueron revertidas a su línea base."
            : "No había intervenciones activas pendientes de reversión.";

        RefreshTransactionHistoryView();
        ExecuteTelemetryAndDecisionCycle(forceRebuildDecisions: true);
    }

    private void ExecuteResetEmpiricalHistory()
    {
        _historicalEngine.ClearEmpiricalHistory();
        LastActionStatusBanner = "HISTORIAL EMPÍRICO REINICIADO: Todas las decisiones vuelven a ser evaluables desde cero.";
        ExecuteTelemetryAndDecisionCycle(forceRebuildDecisions: true);
    }

    private void ExecuteTelemetryAndDecisionCycle(bool forceRebuildDecisions)
    {
        SystemTelemetrySnapshot snapshot = _telemetryEngine.CaptureSnapshot();
        AdaptiveEvaluationReport report = _decisionEngine.EvaluateSystemState(_hardwareProfile, snapshot, _selectedObjective);

        // Si Auto-Pilot está activo, ejecuta decisiones recomendadas de alta confianza aún no aplicadas
        if (_isAutoPilotEnabled)
        {
            bool autoAppliedAny = false;
            foreach (var dec in report.Decisions)
            {
                if (dec.Disposition == DecisionDisposition.RecommendedIntervention &&
                    !dec.IsCurrentlyApplied &&
                    dec.ConfidencePercent >= 90)
                {
                    _ = _optimizationEngine.ExecuteAndValidateIntervention(dec, _selectedObjective, _hardwareProfile);
                    autoAppliedAny = true;
                }
            }

            if (autoAppliedAny)
            {
                _kernelProfile = _systemEngine.InspectKernelAndGamingProfile();
                OnPropertyChanged(nameof(KernelGamingBadgesText));
                RefreshTransactionHistoryView();
                snapshot = _telemetryEngine.CaptureSnapshot();
                report = _decisionEngine.EvaluateSystemState(_hardwareProfile, snapshot, _selectedObjective);
                forceRebuildDecisions = true;
            }
        }

        // Diagnóstico Predictivo
        var predictiveAlerts = _gamingEngine.AnalyzePredictiveTrends(snapshot);
        if (predictiveAlerts.Count > 0)
        {
            var topAlert = predictiveAlerts[0];
            PredictiveHeadline = $"{topAlert.Subsystem}: {topAlert.Headline}";
            PredictiveDetail = topAlert.TechnicalPrediction;
            PredictiveAccentBrush = topAlert.Severity switch
            {
                PredictiveAlertSeverity.Warning => new SolidColorBrush(Color.FromRgb(255, 61, 87)),
                PredictiveAlertSeverity.Advisory => new SolidColorBrush(Color.FromRgb(255, 179, 0)),
                _ => new SolidColorBrush(Color.FromRgb(0, 230, 118))
            };
        }

        CpuUtilizationPercent = snapshot.CpuTotalUtilizationPercent;
        RamLoadPercent = snapshot.PhysicalMemoryLoadPercent;
        RamUsageDetailText = $"{snapshot.PhysicalMemoryUsedGb:F2} / {_hardwareProfile.TotalPhysicalMemoryGb:F1} GB ({snapshot.PhysicalMemoryAvailableGb:F2} GB Libres)";

        CommitLoadPercent = snapshot.CommitChargePercent;
        CommitUsageDetailText = $"{snapshot.CommitChargeTotalGb:F2} / {snapshot.CommitChargeLimitGb:F1} GB Commit Total";

        DriveDetailText = $"Unidad {_hardwareProfile.SystemDriveName} ({_hardwareProfile.SystemDriveFormat}) — {snapshot.SystemDriveFreeGb:F1} GB Libres ({snapshot.SystemDriveFreePercent:F0}%)";
        ProcessEcosystemText = $"{snapshot.TotalRunningProcesses} Procesos  |  {snapshot.TotalSystemThreads} Hilos";

        KernelTimerAndLowsText = $"1% Low (P99): {snapshot.SchedulerOnePercentLowMs:F3} ms | 0.1% Low: {snapshot.SchedulerPointOnePercentLowMs:F3} ms";
        SchedulerAndFocusText = $"Timer Kernel: {snapshot.CurrentKernelTimerResolutionMs:F3} ms | Foco: {snapshot.ActiveForegroundProcessName}";

        if (_cpuHistory.Count >= MaxHistorySamples) _cpuHistory.RemoveAt(0);
        if (_ramHistory.Count >= MaxHistorySamples) _ramHistory.RemoveAt(0);
        _cpuHistory.Add(snapshot.CpuTotalUtilizationPercent);
        _ramHistory.Add(snapshot.PhysicalMemoryLoadPercent);
        RebuildWaveformPolylines();

        TopMemoryProcesses.Clear();
        foreach (var proc in snapshot.TopMemoryConsumers)
        {
            TopMemoryProcesses.Add(proc);
        }

        CompositeScore = report.PerformanceScore.CompositeWeightedScore;
        StabilityScore = report.PerformanceScore.StabilityScore;
        StabilityDiag = report.PerformanceScore.StabilityDiagnostic;
        PerformanceScore = report.PerformanceScore.PerformanceScore;
        PerformanceDiag = report.PerformanceScore.PerformanceDiagnostic;
        EfficiencyScore = report.PerformanceScore.EfficiencyScore;
        EfficiencyDiag = report.PerformanceScore.EfficiencyDiagnostic;
        HealthScore = report.PerformanceScore.HealthScore;
        HealthDiag = report.PerformanceScore.HealthDiagnostic;

        BottleneckHeadline = report.Bottleneck.SummaryHeadline;
        BottleneckExplanation = report.Bottleneck.TechnicalExplanation;
        BottleneckConfidenceText = $"CONFIANZA: {report.Bottleneck.DiagnosticConfidencePercent}%";
        UncertaintyNotice = report.Bottleneck.UncertaintyNotice;

        BottleneckAccentBrush = report.Bottleneck.PrimaryBottleneck == BottleneckSubsystem.NoneNominal
            ? new SolidColorBrush(Color.FromRgb(0, 230, 118))
            : new SolidColorBrush(Color.FromRgb(255, 179, 0));

        RefreshDecisionsCollection(report.Decisions, forceRebuildDecisions);
    }

    private void RebuildWaveformPolylines()
    {
        var cpuPts = new PointCollection(MaxHistorySamples);
        var ramPts = new PointCollection(MaxHistorySamples);

        double stepX = _graphCanvasWidth / (MaxHistorySamples - 1);

        for (int i = 0; i < _cpuHistory.Count; i++)
        {
            double x = i * stepX;
            double cpuY = _graphCanvasHeight - ((_cpuHistory[i] / 100.0) * (_graphCanvasHeight - 10)) - 5;
            double ramY = _graphCanvasHeight - ((_ramHistory[i] / 100.0) * (_graphCanvasHeight - 10)) - 5;

            cpuPts.Add(new Point(x, Math.Clamp(cpuY, 3, _graphCanvasHeight - 3)));
            ramPts.Add(new Point(x, Math.Clamp(ramY, 3, _graphCanvasHeight - 3)));
        }

        cpuPts.Freeze();
        ramPts.Freeze();

        CpuGraphPoints = cpuPts;
        RamGraphPoints = ramPts;
    }

    private void RefreshDecisionsCollection(IReadOnlyList<AdaptiveDecisionItem> items, bool forceRebuild)
    {
        bool needsRebuild = forceRebuild || AdaptiveDecisions.Count != items.Count;
        if (!needsRebuild)
        {
            for (int i = 0; i < items.Count; i++)
            {
                if (AdaptiveDecisions[i].DecisionId != items[i].DecisionId ||
                    AdaptiveDecisions[i].SourceDecision.IsCurrentlyApplied != items[i].IsCurrentlyApplied ||
                    AdaptiveDecisions[i].SourceDecision.Disposition != items[i].Disposition)
                {
                    needsRebuild = true;
                    break;
                }
            }
        }

        if (!needsRebuild) return;

        AdaptiveDecisions.Clear();
        foreach (var item in items)
        {
            var (badgeText, badgeBrush) = item.IsCurrentlyApplied
                ? ("ACTIVO Y VALIDADO (REVERSIBLE)", new SolidColorBrush(Color.FromRgb(0, 230, 118)))
                : item.Disposition switch
                {
                    DecisionDisposition.RecommendedIntervention =>
                        ("RECOMENDADO PARA ESTE PC", new SolidColorBrush(Color.FromRgb(0, 229, 255))),
                    DecisionDisposition.SuppressedNotBeneficial =>
                        ("SUPRIMIDO / NO BENEFICIOSO", new SolidColorBrush(Color.FromRgb(0, 230, 118))),
                    DecisionDisposition.LockedBySensorUncertainty =>
                        ("BLOQUEADO POR INCERTIDUMBRE", new SolidColorBrush(Color.FromRgb(255, 179, 0))),
                    _ =>
                        ("SUBSISTEMA ÓPTIMO", new SolidColorBrush(Color.FromRgb(138, 153, 173)))
                };

            bool canApply = item.Disposition == DecisionDisposition.RecommendedIntervention && !item.IsCurrentlyApplied;
            bool canRevert = item.IsCurrentlyApplied;

            AdaptiveDecisions.Add(new DecisionCardViewModel
            {
                SourceDecision = item,
                DecisionId = item.DecisionId,
                SubsystemTag = item.SubsystemTag,
                Title = item.Title,
                DispositionBadgeText = badgeText.ToUpperInvariant(),
                DispositionBadgeBrush = badgeBrush,
                ConfidenceText = $"Confianza: {item.ConfidencePercent}%",
                HardwareContextReason = item.HardwareContextReason,
                TechnicalRationale = item.TechnicalRationale,
                ExpectedMeasurableImpact = item.ExpectedMeasurableImpact,
                ValidationCriteria = item.ValidationCriteria,
                RollbackStrategy = item.RollbackStrategy,
                EmpiricalHistoryText = item.EmpiricalHistoryNote ?? string.Empty,
                EmpiricalHistoryVisibility = string.IsNullOrWhiteSpace(item.EmpiricalHistoryNote)
                    ? Visibility.Collapsed
                    : Visibility.Visible,
                ApplyButtonVisibility = canApply ? Visibility.Visible : Visibility.Collapsed,
                RevertButtonVisibility = canRevert ? Visibility.Visible : Visibility.Collapsed,
                ApplyCommand = new RelayCommand(() => ExecuteApplyDecision(item)),
                RevertCommand = new RelayCommand(() => ExecuteRevertDecision(item.DecisionId))
            });
        }
    }

    private void RefreshTransactionHistoryView()
    {
        ValidationTransactions.Clear();
        foreach (var tx in _rollbackEngine.GetTransactionHistory())
        {
            var (statusText, statusBrush) = tx.ExecutionState switch
            {
                InterventionExecutionState.ValidatedEffective =>
                    ("VALIDADO EFECTIVO", new SolidColorBrush(Color.FromRgb(0, 230, 118))),
                InterventionExecutionState.AppliedMinimalGain =>
                    ("ACTIVO (IMPACTO LEVE)", new SolidColorBrush(Color.FromRgb(0, 229, 255))),
                InterventionExecutionState.AutoRolledBackRegression =>
                    ("AUTO-ROLLBACK (REGRESIÓN)", new SolidColorBrush(Color.FromRgb(255, 61, 87))),
                InterventionExecutionState.RevertedByUser =>
                    ("REVERTIDO AL ESTADO ORIGINAL", new SolidColorBrush(Color.FromRgb(255, 179, 0))),
                _ =>
                    ("REGISTRADO", new SolidColorBrush(Color.FromRgb(138, 153, 173)))
            };

            string comparison =
                $"ANTES -> RAM Libre: {tx.BeforeAvailableRamGb:F2} GB | P99: {tx.BeforeJitterMs:F3} ms | Score: {tx.BeforeCompositeScore}   ==>   " +
                $"DESPUÉS -> RAM Libre: {tx.AfterAvailableRamGb:F2} GB (+{tx.FreedMemoryMb:F0} MB) | P99: {tx.AfterJitterMs:F3} ms | Score: {tx.AfterCompositeScore}";

            ValidationTransactions.Add(new TransactionHistoryItemViewModel
            {
                DecisionTitle = tx.DecisionTitle,
                TimestampText = tx.ExecutedAt.ToString("HH:mm:ss"),
                StatusBadgeText = statusText,
                StatusBadgeBrush = statusBrush,
                ValidationSummary = tx.ValidationSummary,
                MetricsComparisonText = comparison
            });
        }
    }

