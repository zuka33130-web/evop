namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// Motores 13 y 14:
/// - Calcula en vivo la estabilidad de despacho QPC con percentiles P99 (1% Low) y P99.9 (0.1% Low).
/// - Ejecuta el Benchmark A/B de alta frecuencia Antes/Después.
/// - Analiza tendencias predictivas (derivada de memoria y picos de latencia).
/// </summary>
public sealed class WindowsGamingAndLatencyService :
    IGamingIntelligenceEngine,
    IBenchmarkFrametimeEngine
{
    private const int RollingLatencyWindowSize = 120;
    private readonly List<double> _rollingDispatchSamplesMs = new(RollingLatencyWindowSize);
    private readonly Queue<(DateTimeOffset Time, double UsedRamGb, double CommitGb, double P99Ms)> _telemetryTrendWindow = new(30);

    public (int ForegroundPid, string ProcessName, bool IsHeavyOrGameWorkload) InspectForegroundWorkload()
    {
        try
        {
            nint hwnd = Win32NativeMethods.GetForegroundWindow();
            if (hwnd == nint.Zero)
            {
                return (0, "Idle/Desktop", false);
            }

            _ = Win32NativeMethods.GetWindowThreadProcessId(hwnd, out uint pid);
            if (pid == 0)
            {
                return (0, "System", false);
            }

            using var proc = Process.GetProcessById((int)pid);
            string name = proc.ProcessName;
            double workingSetMb = proc.WorkingSet64 / (1024.0 * 1024.0);

            bool isHeavy = workingSetMb > 450.0 ||
                           (!name.Equals("explorer", StringComparison.OrdinalIgnoreCase) &&
                            !name.Equals("EvoOptimizer.App", StringComparison.OrdinalIgnoreCase) &&
                            !name.Equals("TextInputHost", StringComparison.OrdinalIgnoreCase) &&
                            proc.Threads.Count > 24);

            return ((int)pid, name, isHeavy);
        }
        catch
        {
            return (0, "Ventana Protegida", false);
        }
    }

    public (SensorCalibrationState State, double MeanJitterMs, double OnePercentLowMs, double PointOnePercentLowMs) MeasureSchedulerStability()
    {
        // Tomamos 8 micro-muestras QPC por ciclo para alimentar la ventana estadística real
        for (int i = 0; i < 8; i++)
        {
            long t0 = Stopwatch.GetTimestamp();
            Thread.Yield();
            long t1 = Stopwatch.GetTimestamp();

            double sampleMs = ((t1 - t0) * 1000.0) / Stopwatch.Frequency;
            if (_rollingDispatchSamplesMs.Count >= RollingLatencyWindowSize)
            {
                _rollingDispatchSamplesMs.RemoveAt(0);
            }
            _rollingDispatchSamplesMs.Add(Math.Clamp(sampleMs, 0.001, 30.0));
        }

        var sorted = _rollingDispatchSamplesMs.OrderBy(x => x).ToArray();
        double mean = sorted.Average();
        double p99 = GetPercentile(sorted, 0.99);
        double p999 = GetPercentile(sorted, 0.999);

        return (
            SensorCalibrationState.CalibratedRealTime,
            Math.Round(mean, 3),
            Math.Round(p99, 3),
            Math.Round(p999, 3)
        );
    }

    public async Task<StabilityBenchmarkSnapshot> RunHighFrequencyStabilityBenchmarkAsync(
        string phaseLabel,
        SystemTelemetrySnapshot currentSnapshot)
    {
        return await Task.Run(() =>
        {
            const int totalSamples = 450;
            var samplesMs = new double[totalSamples];

            for (int i = 0; i < totalSamples; i++)
            {
                long start = Stopwatch.GetTimestamp();
                // Micro-espera activa + cesión de quantum para medir el tiempo real de retorno del planificador
                Thread.SpinWait(60);
                Thread.Yield();
                long end = Stopwatch.GetTimestamp();

                samplesMs[i] = ((end - start) * 1000.0) / Stopwatch.Frequency;
                if (i % 30 == 0)
                {
                    Thread.Sleep(1);
                }
            }

            Array.Sort(samplesMs);
            double mean = samplesMs.Average();
            double p95 = GetPercentile(samplesMs, 0.95);
            double p99 = GetPercentile(samplesMs, 0.99);
            double p999 = GetPercentile(samplesMs, 0.999);

            // Índice de estabilidad basado en la cercanía entre el P99 (1% low) y la media
            double spreadPenalty = Math.Min(55.0, (p99 - mean) * 38.0);
            int stabilityScore = (int)Math.Clamp(Math.Round(98.0 - spreadPenalty), 30, 99);

            return new StabilityBenchmarkSnapshot(
                CapturedAt: DateTimeOffset.Now,
                PhaseLabel: phaseLabel,
                SampleCount: totalSamples,
                MeanDispatchLatencyMs: Math.Round(mean, 4),
                P95LatencyMs: Math.Round(p95, 4),
                OnePercentLowLatencyMs: Math.Round(p99, 4),
                PointOnePercentLowLatencyMs: Math.Round(p999, 4),
                StabilityIndexScore: stabilityScore,
                AvailablePhysicalRamGb: currentSnapshot.PhysicalMemoryAvailableGb,
                CpuLoadPercent: currentSnapshot.CpuTotalUtilizationPercent,
                KernelTimerResolutionMs: currentSnapshot.CurrentKernelTimerResolutionMs
            );
        });
    }

    public BenchmarkComparisonReport CompareBenchmarkSnapshots(
        StabilityBenchmarkSnapshot baselineBefore,
        StabilityBenchmarkSnapshot verificationAfter)
    {
        double beforeP99 = Math.Max(0.0001, baselineBefore.OnePercentLowLatencyMs);
        double afterP99 = verificationAfter.OnePercentLowLatencyMs;
        double onePercentImprovement = ((beforeP99 - afterP99) / beforeP99) * 100.0;

        double beforeP999 = Math.Max(0.0001, baselineBefore.PointOnePercentLowLatencyMs);
        double afterP999 = verificationAfter.PointOnePercentLowLatencyMs;
        double pointOnePercentImprovement = ((beforeP999 - afterP999) / beforeP999) * 100.0;

        double freedRamMb = (verificationAfter.AvailablePhysicalRamGb - baselineBefore.AvailablePhysicalRamGb) * 1024.0;
        int stabilityDelta = verificationAfter.StabilityIndexScore - baselineBefore.StabilityIndexScore;

        bool improved = onePercentImprovement > 1.5 || freedRamMb >= 25.0 || stabilityDelta > 0;

        string verdict = improved
            ? $"MEJORA DEMOSTRADA CON DATOS: Latencia P99 (1% Low) pasó de {baselineBefore.OnePercentLowLatencyMs:F3} ms a {verificationAfter.OnePercentLowLatencyMs:F3} ms ({onePercentImprovement:+0.0;-0.0;0.0}%) | Δ RAM Libre: {freedRamMb:+0;-0;0} MB | Timer Kernel: {verificationAfter.KernelTimerResolutionMs:F3} ms."
            : $"SIN GANANCIA SIGNIFICATIVA DETECTADA: P99 (1% Low) varió de {baselineBefore.OnePercentLowLatencyMs:F3} ms a {verificationAfter.OnePercentLowLatencyMs:F3} ms | Δ RAM: {freedRamMb:+0;-0;0} MB. El sistema ya operaba cerca de su límite físico.";

        return new BenchmarkComparisonReport(
            BaselineBefore: baselineBefore,
            VerificationAfter: verificationAfter,
            OnePercentLowImprovementPercent: Math.Round(onePercentImprovement, 1),
            PointOnePercentLowImprovementPercent: Math.Round(pointOnePercentImprovement, 1),
            FreedMemoryMb: Math.Round(freedRamMb, 1),
            StabilityScoreDelta: stabilityDelta,
            IsMeasurableImprovement: improved,
            TechnicalVerdict: verdict
        );
    }

    public IReadOnlyList<PredictiveDiagnosticAlert> AnalyzePredictiveTrends(SystemTelemetrySnapshot currentSnapshot)
    {
        if (_telemetryTrendWindow.Count >= 30)
        {
            _telemetryTrendWindow.Dequeue();
        }

        _telemetryTrendWindow.Enqueue((
            currentSnapshot.Timestamp,
            currentSnapshot.PhysicalMemoryUsedGb,
            currentSnapshot.CommitChargeTotalGb,
            currentSnapshot.SchedulerOnePercentLowMs));

        var alerts = new List<PredictiveDiagnosticAlert>();

        if (_telemetryTrendWindow.Count >= 8)
        {
            var oldest = _telemetryTrendWindow.Peek();
            double elapsedMinutes = Math.Max(0.1, (currentSnapshot.Timestamp - oldest.Time).TotalMinutes);
            double ramGrowthMbPerMin = ((currentSnapshot.PhysicalMemoryUsedGb - oldest.UsedRamGb) * 1024.0) / elapsedMinutes;

            if (ramGrowthMbPerMin > 180.0 && currentSnapshot.PhysicalMemoryLoadPercent > 65.0)
            {
                double remainingMb = currentSnapshot.PhysicalMemoryAvailableGb * 1024.0;
                double minutesToExhaustion = remainingMb / ramGrowthMbPerMin;

                alerts.Add(new PredictiveDiagnosticAlert(
                    Severity: PredictiveAlertSeverity.Warning,
                    Subsystem: "PREDICTIVE MEMORY GUARD",
                    Headline: $"Tendencia de Crecimiento Rápido de RAM (+{ramGrowthMbPerMin:F0} MB/min)",
                    TechnicalPrediction: $"A este ritmo de asignación, el margen físico disponible se agotará en ~{minutesToExhaustion:F1} min. Se recomienda aplicar Contención Selectiva de Working Set."
                ));
            }
        }

        if (currentSnapshot.SchedulerOnePercentLowMs > 0.85)
        {
            alerts.Add(new PredictiveDiagnosticAlert(
                Severity: PredictiveAlertSeverity.Advisory,
                Subsystem: "PREDICTIVE FRAMETIME / SCHEDULER",
                Headline: $"Elevación en Cola P99 del Planificador ({currentSnapshot.SchedulerOnePercentLowMs:F3} ms)",
                TechnicalPrediction: "La varianza entre la latencia media de despacho y el percentil 99 indica interferencia de hilos secundarios o timer del kernel relajado (>10 ms)."
            ));
        }

        if (alerts.Count == 0)
        {
            alerts.Add(new PredictiveDiagnosticAlert(
                Severity: PredictiveAlertSeverity.Nominal,
                Subsystem: "PREDICTIVE DIAGNOSTICS",
                Headline: "Trayectoria de Recursos Estable (Sin Fugas ni Anomalías)",
                TechnicalPrediction: $"Tasa de asignación de RAM estable | P99 (1% Low) en {currentSnapshot.SchedulerOnePercentLowMs:F3} ms | P99.9 (0.1% Low) en {currentSnapshot.SchedulerPointOnePercentLowMs:F3} ms."
            ));
        }

        return alerts;
    }

    private static double GetPercentile(double[] sortedSamples, double percentile)
    {
        if (sortedSamples.Length == 0) return 0.0;
        double index = percentile * (sortedSamples.Length - 1);
        int lower = (int)Math.Floor(index);
        int upper = (int)Math.Ceiling(index);
        if (lower == upper) return sortedSamples[lower];
        double weight = index - lower;
        return (sortedSamples[lower] * (1.0 - weight)) + (sortedSamples[upper] * weight);
    }
}
