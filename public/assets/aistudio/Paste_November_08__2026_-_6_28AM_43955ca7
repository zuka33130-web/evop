    private int _cachedProcessCount;
    private int _cachedThreadCount;
    private IReadOnlyList<ProcessResourceSample> _cachedTopProcesses = [];

    public WindowsLiveTelemetryService(
        IStorageIntelligenceEngine storageEngine,
