using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// NÚCLEO DIFERENCIAL DE EVO:
/// Analiza el hardware real, detecta cuellos de botella, calcula el EVO Performance Score
/// multidimensional y selecciona estrategias adaptadas (incluyendo la supresión de ajustes genéricos dañinos).
/// </summary>
public sealed class AdaptiveDecisionEngineService :
    IAdaptiveDecisionEngine,
    IBottleneckDetectionEngine
{
    public AdaptiveEvaluationReport EvaluateSystemState(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        BottleneckAssessment bottleneck = AnalyzeBottlenecks(hardware, telemetry, objective);
        EvoPerformanceScore score = ComputePerformanceScore(hardware, telemetry, objective);
        IReadOnlyList<AdaptiveDecisionItem> decisions = GenerateContextAwareDecisions(hardware, telemetry, bottleneck, objective);

        return new AdaptiveEvaluationReport(
            GeneratedAt: DateTimeOffset.Now,
            ActiveObjective: objective,
            HardwareProfile: hardware,
            Telemetry: telemetry,
            Bottleneck: bottleneck,
            PerformanceScore: score,
            Decisions: decisions
        );
    }

    public BottleneckAssessment AnalyzeBottlenecks(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        var candidates = new List<(BottleneckSubsystem Subsystem, int SeverityScore, string Headline, string Explanation)>();

        // 1. Evaluación de Presión de Memoria Física y Commit Charge
        if (telemetry.PhysicalMemoryLoadPercent >= 85.0 || telemetry.CommitChargePercent >= 85.0)
        {
            candidates.Add((
                BottleneckSubsystem.MemoryPhysicalPressure,
                92,
                "Presión Crítica de Memoria y Riesgo de Paginación",
                $"El sistema utiliza el {telemetry.PhysicalMemoryLoadPercent:F0}% de sus {hardware.TotalPhysicalMemoryGb:F1} GB físicos y el {telemetry.CommitChargePercent:F0}% del Commit Charge total. Esto fuerza lecturas/escrituras sincrónicas en el archivo de paginación, degradando severamente los 1% lows."
            ));
        }
        else if (hardware.MemoryTier == MemoryCapacityTier.Constrained_8GBOrLess && telemetry.PhysicalMemoryLoadPercent >= 70.0)
        {
            candidates.Add((
                BottleneckSubsystem.MemoryPhysicalPressure,
                80,
                "Margen Estrecho de RAM en Arquitectura de <= 8 GB",
                $"Con {hardware.TotalPhysicalMemoryGb:F1} GB instalados y {telemetry.PhysicalMemoryAvailableGb:F2} GB libres, cualquier carga adicional (como un motor de juego moderno) agotará el búfer físico."
            ));
        }

        // 2. Evaluación de Saturación de Cómputo CPU
        if (telemetry.CpuTotalUtilizationPercent >= 82.0)
        {
            candidates.Add((
                BottleneckSubsystem.CpuComputeSaturation,
                88,
                "Saturación de Cómputo en Hilos Lógicos de CPU",
                $"La utilización global de los {hardware.LogicalCoreCount} hilos lógicos alcanza el {telemetry.CpuTotalUtilizationPercent:F1}%. Existe contención de planificación (scheduler contention) para tareas sensibles a la latencia."
            ));
        }

        // 3. Evaluación de Proliferación de Procesos y Hilos (Process Sprawl)
        int processThreshold = objective == OptimizationObjective.Gaming ? 185 : 230;
        if (telemetry.TotalRunningProcesses > processThreshold || telemetry.TotalSystemThreads > 3200)
        {
            candidates.Add((
                BottleneckSubsystem.ProcessEcosystemSprawl,
                74,
                "Alta Proliferación de Procesos e Hilos en Segundo Plano",
                $"Se detectan {telemetry.TotalRunningProcesses} procesos activos y {telemetry.TotalSystemThreads} hilos. El exceso de cambios de contexto (context switching) reduce la eficiencia de la caché L3 del procesador."
            ));
        }

        // 4. Evaluación de Volumen de Almacenamiento Primario
        if (telemetry.SystemDriveFreePercent < 12.0 || telemetry.SystemDriveFreeGb < 20.0)
        {
            candidates.Add((
                BottleneckSubsystem.StorageSpaceCritical,
                85,
                "Degradación de Escritura por Baja Capacidad Libre en Unidad del Sistema",
                $"La unidad {hardware.SystemDriveName} solo dispone de {telemetry.SystemDriveFreeGb:F1} GB libres ({telemetry.SystemDriveFreePercent:F1}%). Los SSD NVMe/SATA sufren amplificación de escritura y caída de IOPS cuando operan sobre el 88% de ocupación."
            ));
        }

        string uncertaintyNotice = telemetry.ThermalSensorState == SensorCalibrationState.ProviderNotAttached
            ? "INCERTIDUMBRE DECLARADA: Telemetría térmica Ring-0 y captura ETW Frametime aún no adjuntas. El motor bloquea ajustes agresivos de energía/frecuencia de CPU para evitar throttling térmico no supervisado."
            : "Todos los sensores primarios operan dentro de los parámetros verificados.";

        if (candidates.Count == 0)
        {
            return new BottleneckAssessment(
                PrimaryBottleneck: BottleneckSubsystem.NoneNominal,
                SecondaryBottleneck: BottleneckSubsystem.ThermalTelemetryUnverified,
                DiagnosticConfidencePercent: 89,
                SummaryHeadline: "Operación Nominal sin Cuello de Botella Activo",
                TechnicalExplanation: $"Los recursos de CPU ({telemetry.CpuTotalUtilizationPercent:F1}%), RAM ({telemetry.PhysicalMemoryLoadPercent:F0}%) y Almacenamiento ({telemetry.SystemDriveFreeGb:F1} GB libres) muestran holgura suficiente para el perfil '{FormatObjectiveName(objective)}'.",
                UncertaintyNotice: uncertaintyNotice
            );
        }

        var ordered = candidates.OrderByDescending(c => c.SeverityScore).ToList();
        var primary = ordered[0];
        var secondary = ordered.Count > 1 ? ordered[1].Subsystem : BottleneckSubsystem.ThermalTelemetryUnverified;

        return new BottleneckAssessment(
            PrimaryBottleneck: primary.Subsystem,
            SecondaryBottleneck: secondary,
            DiagnosticConfidencePercent: primary.SeverityScore,
            SummaryHeadline: primary.Headline,
            TechnicalExplanation: primary.Explanation,
            UncertaintyNotice: uncertaintyNotice
        );
    }

    private static EvoPerformanceScore ComputePerformanceScore(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        OptimizationObjective objective)
    {
        // 1. ESTABILIDAD: Basado en holgura de Commit Charge, presión de RAM y presión de hilos
        double commitPenalty = Math.Max(0, telemetry.CommitChargePercent - 55.0) * 1.1;
        double threadPenalty = Math.Max(0, (telemetry.TotalSystemThreads - 2200) / 80.0);
        int stabilityScore = (int)Math.Clamp(Math.Round(96.0 - commitPenalty - threadPenalty), 25, 99);
        string stabilityDiag = $"Commit al {telemetry.CommitChargePercent:F0}% ({telemetry.CommitChargeTotalGb:F1}/{telemetry.CommitChargeLimitGb:F1} GB) | {telemetry.TotalSystemThreads} hilos";

        // 2. RENDIMIENTO: Basado en disponibilidad inmediata de cómputo CPU, RAM libre y arquitectura
        double cpuBusyPenalty = telemetry.CpuTotalUtilizationPercent * 0.45;
        double ramHeadroomBonus = Math.Min(12.0, telemetry.PhysicalMemoryAvailableGb * 0.8);
        int performanceScore = (int)Math.Clamp(Math.Round(86.0 - cpuBusyPenalty + ramHeadroomBonus), 20, 99);
        string performanceDiag = $"Holgura CPU: {100.0 - telemetry.CpuTotalUtilizationPercent:F1}% | RAM Libre: {telemetry.PhysicalMemoryAvailableGb:F1} GB";

        // 3. EFICIENCIA: Basado en proliferación de procesos y carga parasitaria de fondo
        double processSprawlPenalty = Math.Max(0, (telemetry.TotalRunningProcesses - 120) * 0.28);
        double topConsumersMb = telemetry.TopMemoryConsumers.Sum(p => p.WorkingSetMb);
        double backgroundFootprintPenalty = hardware.TotalPhysicalMemoryGb > 0
            ? (topConsumersMb / (hardware.TotalPhysicalMemoryGb * 1024.0)) * 35.0
            : 10.0;
        int efficiencyScore = (int)Math.Clamp(Math.Round(98.0 - processSprawlPenalty - backgroundFootprintPenalty), 25, 99);
        string efficiencyDiag = $"{telemetry.TotalRunningProcesses} procesos activos | Top 5 consumen {topConsumersMb:F0} MB";

        // 4. SALUD: Basado en margen de almacenamiento SSD, riesgo de paginación y cobertura de sensores
        double storagePenalty = telemetry.SystemDriveFreePercent < 20.0 ? (20.0 - telemetry.SystemDriveFreePercent) * 2.5 : 0.0;
        double sensorUncertaintyCap = telemetry.ThermalSensorState == SensorCalibrationState.ProviderNotAttached ? 8.0 : 0.0;
        int healthScore = (int)Math.Clamp(Math.Round(96.0 - storagePenalty - sensorUncertaintyCap), 30, 98);
        string healthDiag = $"Unidad {hardware.SystemDriveName} con {telemetry.SystemDriveFreePercent:F0}% libre | Guardia Térmica Activa";

        // Ponderación adaptativa según el objetivo elegido por el usuario
        double weighted = objective switch
        {
            OptimizationObjective.EverydayUse =>
                (stabilityScore * 0.30) + (efficiencyScore * 0.35) + (healthScore * 0.25) + (performanceScore * 0.10),
            OptimizationObjective.Gaming =>
                (stabilityScore * 0.40) + (performanceScore * 0.35) + (efficiencyScore * 0.15) + (healthScore * 0.10),
            OptimizationObjective.MaxPerformance =>
                (performanceScore * 0.45) + (stabilityScore * 0.30) + (efficiencyScore * 0.15) + (healthScore * 0.10),
            _ => (stabilityScore + performanceScore + efficiencyScore + healthScore) / 4.0
        };

        return new EvoPerformanceScore(
            EvaluatedForObjective: objective,
            CompositeWeightedScore: (int)Math.Round(weighted),
            StabilityScore: stabilityScore,
            StabilityDiagnostic: stabilityDiag,
            PerformanceScore: performanceScore,
            PerformanceDiagnostic: performanceDiag,
            EfficiencyScore: efficiencyScore,
            EfficiencyDiagnostic: efficiencyDiag,
            HealthScore: healthScore,
            HealthDiagnostic: healthDiag
        );
    }

    private static IReadOnlyList<AdaptiveDecisionItem> GenerateContextAwareDecisions(
        HardwareSystemProfile hardware,
        SystemTelemetrySnapshot telemetry,
        BottleneckAssessment bottleneck,
        OptimizationObjective objective)
    {
        var decisions = new List<AdaptiveDecisionItem>();

        // =========================================================================================
        // DECISIÓN 1: INTELIGENCIA ADAPTATIVA DE MEMORIA (Diferencia radical entre 8GB, 16GB y 32GB+)
        // =========================================================================================
        if (hardware.MemoryTier == MemoryCapacityTier.Abundant_32GBPlus && telemetry.PhysicalMemoryLoadPercent < 75.0)
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "MEM-SUPPRESS-STANDBY-PURGE",
                SubsystemTag: "MEMORY INTELLIGENCE",
                Title: "Supresión de Limpieza Agresiva de RAM y Standby List",
                Disposition: DecisionDisposition.SuppressedNotBeneficial,
                ConfidencePercent: 98,
                RiskLevel: InterventionRiskLevel.ZeroRisk_Informational,
                HardwareContextReason: $"Equipo clasificado en nivel 'Abundant RAM' ({hardware.TotalPhysicalMemoryGb:F1} GB instalados, {telemetry.PhysicalMemoryAvailableGb:F1} GB libres).",
                TechnicalRationale: "Los optimizadores convencionales vacían el Working Set y la Standby List indiscriminadamente. En un equipo con 32 GB+ y baja presión de memoria, vaciar la caché de Windows destruye las páginas pre-cargadas en RAM y provoca micro-stuttering (caídas en 1% lows) cuando el juego o aplicación debe volver a leer activos desde el SSD.",
                ExpectedMeasurableImpact: "Preservación del 100% de aciertos de caché en Standby List y eliminación de fallos de página duros (Hard Page Faults) innecesarios.",
                ValidationCriteria: "Verificar que Hard Page Faults/sec se mantenga cercano a cero durante la carga de escenas.",
                RollbackStrategy: "No requiere cambios en el sistema (intervención dañina bloqueada preventivamente)."
            ));
        }
        else if (hardware.MemoryTier == MemoryCapacityTier.Constrained_8GBOrLess || telemetry.PhysicalMemoryLoadPercent >= 75.0)
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "MEM-ADAPTIVE-CONTAINMENT",
                SubsystemTag: "MEMORY INTELLIGENCE",
                Title: "Contención Selectiva de Working Set en Procesos Inactivos",
                Disposition: DecisionDisposition.RecommendedIntervention,
                ConfidencePercent: 91,
                RiskLevel: InterventionRiskLevel.LowRisk_SessionReversible,
                HardwareContextReason: $"Presión de memoria del {telemetry.PhysicalMemoryLoadPercent:F0}% sobre {hardware.TotalPhysicalMemoryGb:F1} GB físicos ({telemetry.PhysicalMemoryAvailableGb:F2} GB disponibles).",
                TechnicalRationale: "Cuando la memoria física libre cae por debajo del umbral de seguridad, el gestor de memoria de Windows comprime páginas activamente (consumiendo ciclos de CPU) y pagina hacia el disco. En lugar de purgar todo el sistema, EVO propone recortar únicamente el Working Set de procesos de fondo sin ventana activa.",
                ExpectedMeasurableImpact: "Liberación estimada de 350 MB a 900 MB de margen físico antes de iniciar una sesión pesada.",
                ValidationCriteria: "Aumento neto de PhysicalMemoryAvailableGb >= 0.35 GB sin incremento en uso de CPU del proceso System (Memory Compression).",
                RollbackStrategy: "Restauración automática por demanda del paginador de Windows; sin alteración permanente de registro."
            ));
        }
        else
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "MEM-BALANCED-MONITORING",
                SubsystemTag: "MEMORY INTELLIGENCE",
                Title: "Reserva Dinámica de Memoria para Perfil de 16 GB",
                Disposition: DecisionDisposition.SystemAlreadyOptimal,
                ConfidencePercent: 94,
                RiskLevel: InterventionRiskLevel.ZeroRisk_Informational,
                HardwareContextReason: $"Capacidad intermedia detectada ({hardware.TotalPhysicalMemoryGb:F1} GB) con presión controlada ({telemetry.PhysicalMemoryLoadPercent:F0}%).",
                TechnicalRationale: "Con más del 30% de memoria física libre, el subsistema de memoria de Windows gestiona eficientemente el caché de archivos. Solo se activará reclamación preventiva si el Commit Charge supera el 78%.",
                ExpectedMeasurableImpact: "Equilibrio óptimo entre latencia de acceso a caché y margen para cargas de trabajo.",
                ValidationCriteria: "Monitoreo continuo de PhysicalMemoryLoadPercent < 75%.",
                RollbackStrategy: "N/A (Estado nominal verificado)."
            ));
        }

        // =========================================================================================
        // DECISIÓN 2: INTELIGENCIA DE GPU (Integrada vs Dedicada)
        // =========================================================================================
        if (hardware.GpuTier == GpuArchitectureTier.IntegratedSharedMemory)
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "GPU-UMA-BANDWIDTH-GUARD",
                SubsystemTag: "GPU & MEMORY BUS",
                Title: "Protección de Ancho de Banda UMA para Gráficos Integrados",
                Disposition: DecisionDisposition.RecommendedIntervention,
                ConfidencePercent: 93,
                RiskLevel: InterventionRiskLevel.LowRisk_SessionReversible,
                HardwareContextReason: $"GPU detectada ({hardware.PrimaryGpuName}) opera con arquitectura de memoria compartida.",
                TechnicalRationale: "A diferencia de una GPU dedicada con VRAM GDDR6 propia, una GPU integrada compite directamente con los núcleos de la CPU por el ancho de banda de la RAM del sistema. Reducir las transferencias en segundo plano y aplicaciones con aceleración por hardware secundaria impacta directamente en la estabilidad de FPS.",
                ExpectedMeasurableImpact: "Reducción de contención en el controlador de memoria y mejora en estabilidad de frametime.",
                ValidationCriteria: "Disminución de memoria comprometida por procesos DWM/WebView secundarios antes de jugar.",
                RollbackStrategy: "Reanudación inmediata de prioridad normal de procesos al cerrar la sesión optimizada."
            ));
        }
        else
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "GPU-DISCRETE-QUEUE-ISOLATION",
                SubsystemTag: "GPU INTELLIGENCE",
                Title: "Política de Despacho para GPU Dedicada (" + hardware.PrimaryGpuName + ")",
                Disposition: objective == OptimizationObjective.EverydayUse
                    ? DecisionDisposition.SuppressedNotBeneficial
                    : DecisionDisposition.RecommendedIntervention,
                ConfidencePercent: 87,
                RiskLevel: InterventionRiskLevel.LowRisk_SessionReversible,
                HardwareContextReason: $"Adaptador discreto detectado ({hardware.PrimaryGpuName}) bajo objetivo '{FormatObjectiveName(objective)}'.",
                TechnicalRationale: objective == OptimizationObjective.EverydayUse
                    ? "En modo 'Uso Cotidiano', forzar estados de reloj altos o priorización agresiva de colas de GPU incrementa el consumo eléctrico en reposo sin beneficio perceptible en ofimática o navegación."
                    : "Para 'Gaming' y 'Máximo Rendimiento', aislar la prioridad de planificación de hilos del proceso renderizador evita que tareas de fondo retrasen la entrega de paquetes al driver gráfico (DPC/ISR).",
                ExpectedMeasurableImpact: objective == OptimizationObjective.EverydayUse
                    ? "Ahorro energético y menor generación térmica en escritorio."
                    : "Mejora en consistencia de entrega de cuadros (reducción de varianza entre percentil 99 y promedio).",
                ValidationCriteria: "Verificación de latencia de frametime 1% low mediante motor de validación.",
                RollbackStrategy: "Reversión instantánea de prioridad de E/S y CPU al finalizar el proceso objetivo."
            ));
        }

        // =========================================================================================
        // DECISIÓN 3: GUARDIA TÉRMICA Y TRANSPARENCIA ANTE INCERTIDUMBRE
        // =========================================================================================
        if (telemetry.ThermalSensorState == SensorCalibrationState.ProviderNotAttached)
        {
            decisions.Add(new AdaptiveDecisionItem(
                DecisionId: "THERM-SAFETY-LOCK-CPU-BOOST",
                SubsystemTag: "THERMAL GUARD",
                Title: "Bloqueo Preventivo de Ajustes Agresivos de Boost y Core Parking",
                Disposition: DecisionDisposition.LockedBySensorUncertainty,
                ConfidencePercent: 100,
                RiskLevel: InterventionRiskLevel.ZeroRisk_Informational,
                HardwareContextReason: $"Procesador {hardware.CpuModelName} ({hardware.LogicalCoreCount} hilos) sin sensor térmico Ring-0 calibrado en la sesión actual.",
                TechnicalRationale: "Principio de ingeniería EVO: Jamás deshabilitar el Core Parking ni forzar estados P0 permanentes en un procesador sin conocer su margen térmico real. Si el equipo es una portátil o tiene limitación de disipación, forzar el 100% de frecuencia mínima provoca Thermal Throttling severo y caídas bruscas de FPS.",
                ExpectedMeasurableImpact: "Prevención del 100% de regresiones inducidas por estrangulamiento térmico.",
                ValidationCriteria: "Se desbloqueará automáticamente cuando el proveedor Thermal Intelligence verifique temperaturas < 80 °C bajo carga.",
                RollbackStrategy: "Política de energía original ('" + hardware.ActivePowerSchemeName + "') conservada intacta."
            ));
        }

        // =========================================================================================
        // DECISIÓN 4: INTELIGENCIA DE PROCESOS Y PLANIFICACIÓN SEGÚN OBJETIVO ELEGIDO
        // =========================================================================================
        string topProcessSummary = telemetry.TopMemoryConsumers.Count > 0
            ? string.Join(", ", telemetry.TopMemoryConsumers.Take(3).Select(p => $"{p.ProcessName} ({p.WorkingSetMb:F0} MB)"))
            : "Sin procesos pesados aislados";

        decisions.Add(new AdaptiveDecisionItem(
            DecisionId: $"PROC-SCHEDULER-{objective.ToString().ToUpperInvariant()}",
            SubsystemTag: "PROCESS & CPU SCHEDULER",
            Title: objective switch
            {
                OptimizationObjective.EverydayUse => "Gobernanza Silenciosa de Procesos de Fondo (Modo Cotidiano)",
                OptimizationObjective.Gaming => "Aislamiento de Planificación y Reducción de Context-Switching (Modo Gaming)",
                _ => "Priorización de Rendimiento de Cómputo e Hilos (Modo Máximo Rendimiento)"
            },
            Disposition: DecisionDisposition.RecommendedIntervention,
            ConfidencePercent: 90,
            RiskLevel: InterventionRiskLevel.LowRisk_SessionReversible,
            HardwareContextReason: $"Ecosistema actual: {telemetry.TotalRunningProcesses} procesos y {telemetry.TotalSystemThreads} hilos en {hardware.LogicalCoreCount} núcleos lógicos. Mayores consumidores: {topProcessSummary}.",
            TechnicalRationale: objective switch
            {
                OptimizationObjective.EverydayUse =>
                    "En uso cotidiano no se deben cerrar aplicaciones del usuario ni alterar servicios del sistema. La estrategia óptima consiste en aplicar prioridad EcoQoS / BelowNormal únicamente a indexadores y actualizadores en segundo plano cuando superan umbrales de CPU.",
                OptimizationObjective.Gaming =>
                    $"Con {telemetry.TotalSystemThreads} hilos activos compitiendo por {hardware.LogicalCoreCount} procesadores lógicos, las interrupciones de procesos de fondo degradan la localidad de caché L2/L3 del hilo principal del juego. Se propone contención temporal de prioridad y afinidad para procesos no esenciales.",
                _ =>
                    "Para cargas de máxima productividad o renderizado, se prioriza el quantum de planificación de la ventana de trabajo activa sin restringir hilos de cálculo secundarios."
            },
            ExpectedMeasurableImpact: "Reducción de variabilidad en tiempos de respuesta del planificador de Windows sin desactivar ningún servicio crítico del sistema.",
            ValidationCriteria: "Comparativa antes/después del porcentaje de CPU consumido por procesos fuera del foco principal.",
            RollbackStrategy: "Diccionario en memoria con los niveles de prioridad y afinidad originales de cada PID para restauración exacta en < 50 ms."
        ));

        return decisions;
    }

    private static string FormatObjectiveName(OptimizationObjective objective) => objective switch
    {
        OptimizationObjective.EverydayUse => "Uso Cotidiano",
        OptimizationObjective.Gaming => "Gaming Competitivo",
        OptimizationObjective.MaxPerformance => "Máximo Rendimiento",
        _ => "Estándar"
    };
