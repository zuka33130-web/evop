    private async Task ExecuteLiveCaptureAsync(bool isGroupA)
    {
        string groupTag = isGroupA ? "Grupo A (Línea Base)" : "Grupo B (Intervención)";
        LastActionStatusBanner = $"Iniciando captura PresentMon/ETW de 20 segundos para {groupTag} sobre cs2.exe...";

        RealFrametimeBenchmarkRun run = await _presentMonService.CaptureLiveCs2FrametimesAsync(
            configurationTag: groupTag,
            scenarioNotes: "Captura en vivo CS2",
            durationSeconds: 20);

        ProcessCapturedBenchmarkRun(run, isGroupA);
    }

    private void ExecuteImportPresentMonCsv(bool isGroupA)
    {
        var dlg = new OpenFileDialog
        {
            Title = isGroupA
                ? "Importar CSV de PresentMon para Grupo A (Línea Base)"
                : "Importar CSV de PresentMon para Grupo B (Intervención)",
            Filter = "Archivos CSV de PresentMon (*.csv)|*.csv|Todos los archivos (*.*)|*.*"
        };

        if (dlg.ShowDialog() != true) return;

        SystemTelemetrySnapshot snap = _telemetryEngine.CaptureSnapshot();
        string groupTag = isGroupA ? "Grupo A (Línea Base)" : "Grupo B (Intervención)";

        RealFrametimeBenchmarkRun run = _presentMonService.AnalyzePresentMonCsvFile(
            csvFilePath: dlg.FileName,
            configurationTag: groupTag,
            scenarioNotes: Path.GetFileName(dlg.FileName),
            backgroundProcessCount: snap.TotalRunningProcesses,
            availableRamGb: snap.PhysicalMemoryAvailableGb);

        ProcessCapturedBenchmarkRun(run, isGroupA);
    }

    private void ProcessCapturedBenchmarkRun(RealFrametimeBenchmarkRun run, bool isGroupA)
    {
        _latestBenchmarkRun = run;

        if (run.Status != BenchmarkCaptureStatus.ValidCapture)
        {
            BenchmarkSummaryHeadline = $"BENCHMARK ENGINE: {run.StatusExplanation}";
            BenchmarkMetricsDetail = "No se agregaron datos inválidos ni simulados a los grupos estadísticos A/B.";
            LastActionStatusBanner = run.StatusExplanation;
            ExecuteTelemetryCycle(forceRefreshRecommendations: true);
            return;
        }

        if (isGroupA)
            _runsGroupA.Add(run);
        else
            _runsGroupB.Add(run);

        string p01Text = run.PointOnePercentLowAverageFps.HasValue
            ? $"{run.PointOnePercentLowAverageFps:F1} FPS (P99.9 = {run.P99Point9FrametimeMs:F2} ms)"
            : run.PointOnePercentLowNotice;

        BenchmarkSummaryHeadline =
            $"ÚLTIMA CORRIDA VÁLIDA ({run.ConfigurationTag}): {run.AverageFps:F1} FPS Avg | " +
            $"1% Low Avg: {run.OnePercentLowAverageFps:F1} FPS (P99: {run.P99FrametimeMs:F2} ms)";

        BenchmarkMetricsDetail =
            $"Muestras Válidas: N={run.ValidEvaluatedFrames} ({run.CaptureDurationSeconds:F1}s, Warmup descartado={run.WarmupDiscardedFrames}, Dropped={run.DroppedFramesCount}) | " +
            $"Mediana (P50): {run.MedianFrametimeMs:F2} ms | P95: {run.P95FrametimeMs:F2} ms | IQR: {run.InterquartileRangeMs:F2} ms | SD: {run.StandardDeviationMs:F2} ms | " +
            $"Stutters: {run.StutterSpikeCount} | 0.1% Low: {p01Text}";

        RecomputeAbComparison();
        ExecuteTelemetryCycle(forceRefreshRecommendations: true);
    }

    private void RecomputeAbComparison()
    {
        AbComparisonStatisticalReport report = _abEngine.CompareConfigurationRuns(
            "Grupo A (Línea Base)", _runsGroupA,
            "Grupo B (Intervención)", _runsGroupB);

        AbComparisonVerdictHeadline = $"VEREDICTO A/B: {report.VerdictSummary}";
        AbComparisonDetail = $"{report.StatisticalJustification} | {report.ContextValidationNotes}";

        AbVerdictBrush = report.Verdict switch
        {
            ComparisonVerdict.Improvement => new SolidColorBrush(Color.FromRgb(0, 230, 118)),
            ComparisonVerdict.Regression => new SolidColorBrush(Color.FromRgb(255, 61, 87)),
            ComparisonVerdict.NoChange => new SolidColorBrush(Color.FromRgb(0, 229, 255)),
            _ => new SolidColorBrush(Color.FromRgb(255, 179, 0))
        };

        LastActionStatusBanner = report.VerdictSummary;
    }

    private void ExecuteClearAbRuns()
    {
        _runsGroupA.Clear();
        _runsGroupB.Clear();
        _latestBenchmarkRun = null;
        RecomputeAbComparison();
        BenchmarkSummaryHeadline = "BENCHMARK ENGINE REAL: Grupos A y B reiniciados (Información insuficiente).";
        BenchmarkMetricsDetail = "Listo para iniciar un nuevo diseño experimental por bloques.";
    }

    private void ExecuteRecommendationWithUserConsent(EvidenceBasedRecommendation rec)
    {
        if (rec.TargetProcessIdentity is null)
        {
            LastActionStatusBanner = "Información insuficiente: No hay un proceso objetivo válido para esta intervención.";
            return;
        }

        MessageBoxResult consent = MessageBox.Show(
            $"¿Autoriza explícitamente aplicar la siguiente intervención reversible?\n\n" +
            $"• Intervención: {rec.Title}\n" +
            $"• Recurso Afectado: {rec.TargetResourceDescription} (Inicio UTC Ticks: {rec.TargetProcessIdentity.CreationTimeUtcTicks})\n" +
            $"• Mecanismo: {rec.ProposedMechanism}\n" +
            $"• Protocolo de Reversión: {rec.RollbackProtocol}",
            "EVO FPS OPTIMIZER — Permiso Explícito de Intervención",
            MessageBoxButton.YesNo,
            MessageBoxImage.Question);

        if (consent != MessageBoxResult.Yes)
        {
            LastActionStatusBanner = "Intervención cancelada por el usuario.";
            return;
        }

        VerifiedInterventionRecord record;
        if (rec.RecommendationId == "HYBRID-CPUSETS-ECORE-STEER")
        {
            record = _safeInterventionService.ApplyBackgroundProcessECoreCpuSets(
                rec.TargetProcessIdentity,
                _hybridTopology,
                userExplicitConsentGranted: true);
        }
        else
        {
            record = _safeInterventionService.ApplyBackgroundProcessEcoQosAndLowPriority(
                rec.TargetProcessIdentity,
                userExplicitConsentGranted: true);
        }

        LastActionStatusBanner = $"{record.Description} -> {record.VerificationMessage}";
        RefreshVerifiedLedgerView();
        ExecuteTelemetryCycle(forceRefreshRecommendations: true);
    }

