using System.Diagnostics;
using System.Globalization;
using System.IO;
using EvoOptimizer.Core.Contracts;
using EvoOptimizer.Core.Engine;
using EvoOptimizer.Core.Models;

namespace EvoOptimizer.Infrastructure.Services;

/// <summary>
/// Motor de captura real de presentación de fotogramas basado en PresentMon / ETW.
/// - Jamás inventa datos cuando CS2 no está activo.
/// - Soporta captura en vivo mediante PresentMon CLI/ETW y análisis de archivos CSV estándar de PresentMon (v1 y v2).
/// </summary>
public sealed class PresentMonBenchmarkService : IPresentMonBenchmarkService
{
    private readonly ILiveTelemetryEngine _telemetryEngine;

    public PresentMonBenchmarkService(ILiveTelemetryEngine telemetryEngine)
    {
        _telemetryEngine = telemetryEngine;
    }

    public async Task<RealFrametimeBenchmarkRun> CaptureLiveCs2FrametimesAsync(
        string configurationTag,
        string scenarioNotes,
        int durationSeconds,
        CancellationToken cancellationToken = default)
    {
        SystemTelemetrySnapshot sysSnap = _telemetryEngine.CaptureSnapshot();
        Process[] cs2Procs = Process.GetProcessesByName("cs2");

        if (cs2Procs.Length == 0)
        {
            return FrametimeMathCalculator.ComputeMetricsFromSamples(
                configurationTag: configurationTag,
                targetProcessName: "cs2.exe (No detectado)",
                scenarioNotes: scenarioNotes,
                rawSamples: [],
                backgroundProcessCount: sysSnap.TotalRunningProcesses,
                availableRamGb: sysSnap.PhysicalMemoryAvailableGb);
        }

        foreach (var p in cs2Procs) p.Dispose();

        string? presentMonExePath = LocatePresentMonExecutable();
        if (string.IsNullOrWhiteSpace(presentMonExePath))
        {
            return new RealFrametimeBenchmarkRun(
                RunId: Guid.NewGuid(),
                ConfigurationTag: configurationTag,
                TargetProcessName: "cs2.exe",
                ScenarioNotes: scenarioNotes,
                CapturedAt: DateTimeOffset.Now,
                Status: BenchmarkCaptureStatus.PresentMonProviderUnavailable,
                StatusExplanation: "Información insuficiente: cs2.exe está activo, pero no se encontró PresentMon.exe en Tools/PATH para iniciar la sesión ETW de captura. Puede colocar PresentMon.exe en la carpeta de la aplicación o importar un archivo CSV de PresentMon.",
                CaptureDurationSeconds: 0,
                TotalRawFrames: 0,
                WarmupDiscardedFrames: 0,
                DroppedFramesCount: 0,
                ValidEvaluatedFrames: 0,
                AverageFrametimeMs: null,
                AverageFps: null,
                MedianFrametimeMs: null,
                P95FrametimeMs: null,
                P99FrametimeMs: null,
                P99Point9FrametimeMs: null,
                OnePercentLowPercentileFps: null,
                OnePercentLowAverageFps: null,
                PointOnePercentLowPercentileFps: null,
                PointOnePercentLowAverageFps: null,
                PointOnePercentLowNotice: "Información insuficiente",
                StandardDeviationMs: null,
                InterquartileRangeMs: null,
                CoefficientOfVariation: null,
                StutterSpikeCount: 0,
                GpuBusyRatioPercent: null,
                BackgroundProcessCountDuringRun: sysSnap.TotalRunningProcesses,
                SystemAvailableRamGbDuringRun: sysSnap.PhysicalMemoryAvailableGb
            );
        }

        string tempCsvPath = Path.Combine(Path.GetTempPath(), $"evo_cs2_presentmon_{Guid.NewGuid():N}.csv");

        try
        {
            int clampedDuration = Math.Clamp(durationSeconds, 10, 300);
            var psi = new ProcessStartInfo
            {
                FileName = presentMonExePath,
                Arguments = $"-process_name cs2.exe -timed {clampedDuration} -output_file \"{tempCsvPath}\" -stop_existing_session -no_top",
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var proc = Process.Start(psi);
            if (proc is not null)
            {
                await proc.WaitForExitAsync(cancellationToken);
            }

            if (File.Exists(tempCsvPath))
            {
                return AnalyzePresentMonCsvFile(
                    tempCsvPath,
                    configurationTag,
                    scenarioNotes,
                    sysSnap.TotalRunningProcesses,
                    sysSnap.PhysicalMemoryAvailableGb);
            }
        }
        catch (Exception ex)
        {
            return new RealFrametimeBenchmarkRun(
                RunId: Guid.NewGuid(),
                ConfigurationTag: configurationTag,
                TargetProcessName: "cs2.exe",
                ScenarioNotes: scenarioNotes,
                CapturedAt: DateTimeOffset.Now,
                Status: BenchmarkCaptureStatus.CaptureAbortedOrInvalid,
                StatusExplanation: $"Información insuficiente: Error al ejecutar sesión ETW/PresentMon ({ex.Message}). Verifique permisos de Administrador o grupo Performance Log Users.",
                CaptureDurationSeconds: 0,
                TotalRawFrames: 0,
                WarmupDiscardedFrames: 0,
                DroppedFramesCount: 0,
                ValidEvaluatedFrames: 0,
                AverageFrametimeMs: null,
                AverageFps: null,
                MedianFrametimeMs: null,
                P95FrametimeMs: null,
                P99FrametimeMs: null,
                P99Point9FrametimeMs: null,
                OnePercentLowPercentileFps: null,
                OnePercentLowAverageFps: null,
                PointOnePercentLowPercentileFps: null,
                PointOnePercentLowAverageFps: null,
                PointOnePercentLowNotice: "Información insuficiente",
                StandardDeviationMs: null,
                InterquartileRangeMs: null,
                CoefficientOfVariation: null,
                StutterSpikeCount: 0,
                GpuBusyRatioPercent: null,
                BackgroundProcessCountDuringRun: sysSnap.TotalRunningProcesses,
                SystemAvailableRamGbDuringRun: sysSnap.PhysicalMemoryAvailableGb
            );
        }
        finally
        {
            try
            {
                if (File.Exists(tempCsvPath)) File.Delete(tempCsvPath);
            }
            catch { }
        }

        return FrametimeMathCalculator.ComputeMetricsFromSamples(
            configurationTag, "cs2.exe", scenarioNotes, [], sysSnap.TotalRunningProcesses, sysSnap.PhysicalMemoryAvailableGb);
    }

    public RealFrametimeBenchmarkRun AnalyzePresentMonCsvFile(
        string csvFilePath,
        string configurationTag,
        string scenarioNotes,
        int backgroundProcessCount,
        double availableRamGb)
    {
        if (!File.Exists(csvFilePath))
        {
            return FrametimeMathCalculator.ComputeMetricsFromSamples(
                configurationTag, "Archivo No Encontrado", scenarioNotes, [], backgroundProcessCount, availableRamGb);
        }

        var samples = new List<FramePresentationSample>();
        string detectedAppName = "cs2.exe";

        using var reader = new StreamReader(csvFilePath);
        string? headerLine = reader.ReadLine();
        if (string.IsNullOrWhiteSpace(headerLine))
        {
            return FrametimeMathCalculator.ComputeMetricsFromSamples(
                configurationTag, detectedAppName, scenarioNotes, [], backgroundProcessCount, availableRamGb);
        }

        string[] headers = headerLine.Split(',').Select(h => h.Trim()).ToArray();

        int idxApp = FindColumnIndex(headers, "Application");
        int idxTimeInSec = FindColumnIndex(headers, "TimeInSeconds", "CPUStartTime");
        int idxMsBetweenPresents = FindColumnIndex(headers, "MsBetweenPresents", "FrameTime");
        int idxMsInPresentApi = FindColumnIndex(headers, "MsInPresentAPI");
        int idxMsUntilRenderComplete = FindColumnIndex(headers, "MsUntilRenderComplete", "MsGPUBusy");
        int idxMsUntilDisplayed = FindColumnIndex(headers, "MsUntilDisplayed", "MsBetweenDisplayChange");
        int idxDropped = FindColumnIndex(headers, "Dropped");
        int idxPresentMode = FindColumnIndex(headers, "PresentMode");

        if (idxMsBetweenPresents < 0)
        {
            return FrametimeMathCalculator.ComputeMetricsFromSamples(
                configurationTag, detectedAppName, scenarioNotes, [], backgroundProcessCount, availableRamGb);
        }

        int frameIndex = 0;
        double cumulativeTimeSeconds = 0.0;

        while (!reader.EndOfStream)
        {
            string? line = reader.ReadLine();
            if (string.IsNullOrWhiteSpace(line)) continue;

            string[] cols = line.Split(',');
            if (cols.Length <= idxMsBetweenPresents) continue;

            if (idxApp >= 0 && idxApp < cols.Length && !string.IsNullOrWhiteSpace(cols[idxApp]))
            {
                detectedAppName = cols[idxApp].Trim();
            }

            if (!double.TryParse(cols[idxMsBetweenPresents], NumberStyles.Float, CultureInfo.InvariantCulture, out double msBetweenPresents))
            {
                continue;
            }

            double timestampSec;
            if (idxTimeInSec >= 0 && idxTimeInSec < cols.Length &&
                double.TryParse(cols[idxTimeInSec], NumberStyles.Float, CultureInfo.InvariantCulture, out double parsedTimeSec))
            {
                timestampSec = parsedTimeSec;
            }
            else
            {
                cumulativeTimeSeconds += (msBetweenPresents / 1000.0);
                timestampSec = cumulativeTimeSeconds;
            }

            double msInApi = ParseOptionalDouble(cols, idxMsInPresentApi);
            double msRender = ParseOptionalDouble(cols, idxMsUntilRenderComplete);
            double msDisplay = ParseOptionalDouble(cols, idxMsUntilDisplayed);

            bool dropped = false;
            if (idxDropped >= 0 && idxDropped < cols.Length)
            {
                string dropVal = cols[idxDropped].Trim();
                dropped = dropVal == "1" || dropVal.Equals("true", StringComparison.OrdinalIgnoreCase);
            }

            string presentMode = (idxPresentMode >= 0 && idxPresentMode < cols.Length)
                ? cols[idxPresentMode].Trim()
                : "Hardware: Independent Flip";

            samples.Add(new FramePresentationSample(
                FrameIndex: ++frameIndex,
                TimestampSeconds: timestampSec,
                MsBetweenPresents: msBetweenPresents,
                MsInPresentApi: msInApi,
                MsUntilRenderComplete: msRender,
                MsUntilDisplayed: msDisplay,
                IsDropped: dropped,
                PresentMode: presentMode
            ));
        }

        return FrametimeMathCalculator.ComputeMetricsFromSamples(
            configurationTag: configurationTag,
            targetProcessName: detectedAppName,
            scenarioNotes: scenarioNotes,
            rawSamples: samples,
            backgroundProcessCount: backgroundProcessCount,
            availableRamGb: availableRamGb);
    }

    private static int FindColumnIndex(string[] headers, params string[] candidateNames)
    {
        foreach (string candidate in candidateNames)
        {
            for (int i = 0; i < headers.Length; i++)
            {
                if (headers[i].Equals(candidate, StringComparison.OrdinalIgnoreCase))
                {
                    return i;
                }
            }
        }
        return -1;
    }

    private static double ParseOptionalDouble(string[] cols, int index)
    {
        if (index >= 0 && index < cols.Length &&
            double.TryParse(cols[index], NumberStyles.Float, CultureInfo.InvariantCulture, out double val))
        {
            return val;
        }
        return 0.0;
    }

    private static string? LocatePresentMonExecutable()
    {
        string baseDir = AppDomain.CurrentDomain.BaseDirectory;
        string[] candidatePaths =
        [
            Path.Combine(baseDir, "PresentMon.exe"),
            Path.Combine(baseDir, "Tools", "PresentMon.exe"),
            Path.Combine(baseDir, "PresentMon-2.2.0-x64.exe")
        ];

        foreach (string path in candidatePaths)
        {
            if (File.Exists(path)) return path;
        }

        return null;
    }
}
