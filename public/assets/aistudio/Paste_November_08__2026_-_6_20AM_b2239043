public enum BenchmarkVerdict { Improved, NoChange, Regressed, Inconclusive }

public enum InconclusiveReason
{
    None,
    /// <summary>Contexto de carga ausente o distinto entre grupos.</summary>
    ContextMismatch,
    InvalidData,
    InsufficientRuns,
    /// <summary>Mediana de la línea base ≤ 0: el cambio relativo no está definido.</summary>
    DegenerateBaseline,
    /// <summary>Datos válidos, pero no permiten afirmar ni descartar un efecto relevante.</summary>
    Ambiguous
}

/// <param name="MinimumRelevantChange">
/// Cambio relativo mínimo que importa en la práctica (0.03 = 3 %), en (0, 0.5].
/// Debe superar el ruido típico entre corridas; si no, el veredicto será No concluyente.
/// </param>
public sealed record MetricSpec(string Name, MetricDirection Direction, double MinimumRelevantChange);

/// <summary>
/// Un valor por CORRIDA independiente (p. ej. el 1% low de cada captura).
/// Los fotogramas dentro de una corrida NO son réplicas independientes y no deben introducirse como tales.
/// </summary>
public sealed record MeasurementSeries(MetricSpec Metric, string WorkloadContext, IReadOnlyList<double> RunValues);

/// <param name="MinRunsPerGroup">Mínimo de corridas por grupo (≥ 4: con menos, Mann-Whitney casi nunca alcanza significación).</param>
/// <param name="Alpha">Nivel de significación; el IC tiene nivel 1 − Alpha. En (0, 0.5).</param>
/// <param name="Seed">Semilla del bootstrap: resultados reproducibles.</param>
public sealed record ComparisonOptions(
    int MinRunsPerGroup = 5,
    double Alpha = 0.05,
    int BootstrapResamples = 10_000,
    ulong Seed = 0x45564F)
{
    public static ComparisonOptions Default { get; } = new();
}

/// <summary>Todo valor numérico es null cuando no pudo calcularse. RelativeChange, CiLow y CiHigh están orientados: positivo = mejor.</summary>
public sealed record ComparisonResult(
    BenchmarkVerdict Verdict,
    InconclusiveReason Reason,
    string Summary,
    IReadOnlyList<string> Notes,
    int RunsBefore,
    int RunsAfter,
    double? MedianBefore,
    double? MedianAfter,
    double? RelativeChange,
    double? CiLow,
    double? CiHigh,
    double? PValue,
    bool? PValueIsExact,
    double? ProbabilityOfImprovement,
    double? BaselineNoise);

public static class BenchmarkFormat
{
    public static string Percent(double fraction, bool signed = true)
        => (fraction * 100).ToString(signed ? "+0.0;-0.0;0.0" : "0.0", CultureInfo.CurrentCulture) + " %";

    public static string PValue(double p)
        => p < 0.001
