using EvoOptimizer.Core.Benchmarking;

namespace EvoOptimizer.Core.Frames;

public enum RunGroup { Baseline, Candidate }

public enum FrameMetric { OnePercentLowFps, PointOnePercentLowFps, AverageFps, P99FrameTimeMs, MedianFrameTimeMs }

/// <param name="Sequence">Orden real de captura (único). Permite detectar diseños no intercalados.</param>
public sealed record LabeledRun(string Id, RunGroup Group, int Sequence, string Context, FrameStats Stats);

public sealed record ExperimentResult(ComparisonResult Comparison, IReadOnlyList<string> DesignWarnings);

public static class FrameMetrics
{
    public static MetricSpec Spec(FrameMetric metric, double minimumRelevantChange) => metric switch
    {
        FrameMetric.OnePercentLowFps => new MetricSpec("1% low (FPS)", MetricDirection.HigherIsBetter, minimumRelevantChange),
        FrameMetric.PointOnePercentLowFps => new MetricSpec("0,1% low (FPS)", MetricDirection.HigherIsBetter, minimumRelevantChange),
        FrameMetric.AverageFps => new MetricSpec("FPS promedio", MetricDirection.HigherIsBetter, minimumRelevantChange),
        FrameMetric.P99FrameTimeMs => new MetricSpec("Frametime P99 (ms)", MetricDirection.LowerIsBetter, minimumRelevantChange),
        FrameMetric.MedianFrameTimeMs => new MetricSpec("Frametime mediano (ms)", MetricDirection.LowerIsBetter, minimumRelevantChange),
        _ => throw new ArgumentOutOfRangeException(nameof(metric))
    };

    public static double? Value(FrameMetric metric, FrameStats s) => metric switch
    {
        FrameMetric.OnePercentLowFps => s.OnePercentLowFps,
        FrameMetric.PointOnePercentLowFps => s.PointOnePercentLowFps,
        FrameMetric.AverageFps => s.AverageFps,
        FrameMetric.P99FrameTimeMs => s.P99FrameTimeMs,
        FrameMetric.MedianFrameTimeMs => s.MedianFrameTimeMs,
        _ => throw new ArgumentOutOfRangeException(nameof(metric))
    };
}

/// <summary>
/// Experimento A/B sobre corridas reales. Una corrida = una observación. Comprueba el diseño antes de delegar la
/// estadística en <see cref="BenchmarkComparer"/>. Sin estado ni efectos secundarios.
/// </summary>
public static class FrameExperiment
{
    public const double DefaultMaxDurationRatio = 1.25;

    public static ExperimentResult Evaluate(
        IReadOnlyList<LabeledRun> runs,
        FrameMetric metric,
        double minimumRelevantChange,
        ComparisonOptions? options = null,
        double maxDurationRatio = DefaultMaxDurationRatio)
    {
        ArgumentNullException.ThrowIfNull(runs);
        if (!(maxDurationRatio >= 1)) throw new ArgumentException("maxDurationRatio debe ser ≥ 1.", nameof(maxDurationRatio));

        var spec = FrameMetrics.Spec(metric, minimumRelevantChange);
        var baseline = runs.Where(r => r.Group == RunGroup.Baseline).OrderBy(r => r.Sequence).ToList();
        var candidate = runs.Where(r => r.Group == RunGroup.Candidate).OrderBy(r => r.Sequence).ToList();
        int nA = baseline.Count, nB = candidate.Count;

        if (runs.Select(r => r.Sequence).Distinct().Count() != runs.Count)
            return Blocked(InconclusiveReason.InvalidData, "No se puede comparar: hay corridas con el mismo número de secuencia.", nA, nB);

        var contexts = runs.Select(r => (r.Context ?? "").Trim()).ToList();
        if (contexts.Any(c => c.Length == 0))
            return Blocked(InconclusiveReason.ContextMismatch,
                "No se puede comparar: falta declarar el contexto de carga en al menos una corrida.", nA, nB);
        if (contexts.Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1)
            return Blocked(InconclusiveReason.ContextMismatch,
                "No se puede comparar: las corridas se midieron en contextos de carga distintos.", nA, nB,
                "Contextos: " + string.Join(" | ", contexts.Distinct(StringComparer.OrdinalIgnoreCase)));

        if (runs.Count > 0)
        {
            double min = runs.Min(r => r.Stats.DurationSeconds);
            double max = runs.Max(r => r.Stats.DurationSeconds);
            if (!(min > 0))
                return Blocked(InconclusiveReason.InvalidData, "No se puede comparar: hay corridas sin duración válida.", nA, nB);
            if (max / min > maxDurationRatio)
                return Blocked(InconclusiveReason.ContextMismatch,
                    $"No se puede comparar: la duración de las corridas no es comparable (de {min:F1} s a {max:F1} s; razón máxima admitida {maxDurationRatio:0.##}).", nA, nB,
                    "Los percentiles de cola dependen de cuántos fotogramas hay; corridas de duración muy distinta no son réplicas equivalentes.");
        }

        var missing = runs.Where(r => FrameMetrics.Value(metric, r.Stats) is null).Select(r => r.Id).ToList();
        if (missing.Count > 0)
            return Blocked(InconclusiveReason.InvalidData,
                $"Información insuficiente: «{spec.Name}» no puede calcularse en las corridas {string.Join(", ", missing)}.", nA, nB,
                "No se descartan corridas en silencio: eso sesgaría la comparación. Captura más tiempo o elige otra métrica.");

        string context = contexts.Count > 0 ? contexts[0] : "";
        var comparison = BenchmarkComparer.Compare(
            new MeasurementSeries(spec, context, baseline.Select(r => FrameMetrics.Value(metric, r.Stats)!.Value).ToArray()),
            new MeasurementSeries(spec, context, candidate.Select(r => FrameMetrics.Value(metric, r.Stats)!.Value).ToArray()),
            options);

        return new ExperimentResult(comparison, DesignWarnings(runs, nA, nB));
    }

    private static List<string> DesignWarnings(IReadOnlyList<LabeledRun> runs, int nA, int nB)
    {
        var warnings = new List<string>();
        if (nA == 0 || nB == 0) return warnings;

        var ordered = runs.OrderBy(r => r.Sequence).ToList();
        int switches = 0;
        for (int i = 1; i < ordered.Count; i++)
            if (ordered[i].Group != ordered[i - 1].Group) switches++;

        if (switches <= 1)
            warnings.Add("Diseño no intercalado: todas las corridas de un grupo se midieron antes que las del otro. Eso confunde el ajuste con la deriva temporal (temperatura, caché, procesos de fondo). Alterna A-B-A-B y repite.");

        return warnings;
    }

    private static ExperimentResult Blocked(InconclusiveReason reason, string summary, int nA, int nB, params string[] notes)
        => new(new ComparisonResult(BenchmarkVerdict.Inconclusive, reason, summary, notes, nA, nB,
                null, null, null, null, null, null, null, null, null),
               Array.Empty<string>());
}
