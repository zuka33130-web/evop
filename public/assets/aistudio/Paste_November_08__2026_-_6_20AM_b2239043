```csharp
namespace EvoOptimizer.Core.Benchmarking;

/// <param name="UStatisticFirst">Pares (x, y) con x del primer grupo mayor que y, contando los empates como 0,5.</param>
public sealed record MannWhitneyResult(double UStatisticFirst, double PValue, bool IsExact);

/// <summary>
/// Mann-Whitney U bilateral.
/// N ≤ 50: p exacto por permutación (programación dinámica sobre rangos doblados; maneja empates).
/// N &gt; 50: aproximación normal con corrección por empates y por continuidad.
/// </summary>
public static class MannWhitneyTest
{
    public const int ExactMaxTotal = 50;

    public static MannWhitneyResult TwoSided(IReadOnlyList<double> first, IReadOnlyList<double> second)
    {
        ArgumentNullException.ThrowIfNull(first);
        ArgumentNullException.ThrowIfNull(second);
        if (first.Count == 0 || second.Count == 0)
            throw new ArgumentException("Ambos grupos necesitan al menos una observación.");
        if (first.Any(v => !double.IsFinite(v)) || second.Any(v => !double.IsFinite(v)))
            throw new ArgumentException("Todos los valores deben ser finitos.");

        double u = 0;
        foreach (double x in first)
            foreach (double y in second)
                u += x > y ? 1.0 : x == y ? 0.5 : 0.0;

        return first.Count + second.Count <= ExactMaxTotal
            ? Exact(first, second, u)
            : Approximate(first, second, u);
    }

    private static MannWhitneyResult Exact(IReadOnlyList<double> first, IReadOnlyList<double> second, double u)
    {
        int n1 = first.Count;
        int n = n1 + second.Count;

        var items = new (double Value, bool InFirst)[n];
        for (int i = 0; i < n1; i++) items[i] = (first[i], true);
        for (int j = 0; j < second.Count; j++) items[n1 + j] = (second[j], false);
        Array.Sort(items, (x, y) => x.Value.CompareTo(y.Value));

        // Rangos medios doblados (enteros): evita cualquier comparación en coma flotante.
        var ranks2 = new int[n];
        int observed = 0;
        for (int i = 0; i < n;)
        {
            int j = i;
            while (j + 1 < n && items[j + 1].Value == items[i].Value) j++;
            int r2 = (i + 1) + (j + 1);
            for (int t = i; t <= j; t++)
            {
                ranks2[t] = r2;
                if (items[t].InFirst) observed += r2;
            }
            i = j + 1;
        }

        int total2 = n * (n + 1); // suma de todos los rangos doblados
        var dp = new double[n1 + 1, total2 + 1]; // dp[j, s] = nº de subconjuntos de tamaño j con suma s
        dp[0, 0] = 1;
        for (int i = 0; i < n; i++)
        {
            int r = ranks2[i];
            for (int j = Math.Min(i + 1, n1); j >= 1; j--)
                for (int s = total2; s >= r; s--)
                    dp[j, s] += dp[j - 1, s - r];
        }

        long target = Math.Abs((long)observed * n - (long)n1 * total2);
        double all = 0, extreme = 0;
        for (int s = 0; s <= total2; s++)
        {
            double c = dp[n1, s];
            if (c == 0) continue;
            all += c;
            if (Math.Abs((long)s * n - (long)n1 * total2) >= target) extreme += c;
        }

        return new MannWhitneyResult(u, Math.Min(1.0, extreme / all), true);
    }

    private static MannWhitneyResult Approximate(IReadOnlyList<double> first, IReadOnlyList<double> second, double u)
    {
        int n1 = first.Count, n2 = second.Count, n = n1 + n2;

        var all = first.Concat(second).ToArray();
        Array.Sort(all);
        double tieTerm = 0;
        for (int i = 0; i < n;)
        {
            int j = i;
            while (j + 1 < n && all[j + 1] == all[i]) j++;
            double t = j - i + 1;
            tieTerm += t * t * t - t;
            i = j + 1;
        }

        double pairs = (double)n1 * n2;
        double mean = pairs / 2.0;
        double variance = pairs / 12.0 * ((n + 1) - tieTerm / ((double)n * (n - 1)));
        if (variance <= 1e-12) return new MannWhitneyResult(u, 1.0, false);

        double z = Math.Max(0, Math.Abs(u - mean) - 0.5) / Math.Sqrt(variance);
        double p = Math.Clamp(Erfc(z / Math.Sqrt(2)), 0.0, 1.0); // 2·(1 − Φ(z))
        return new MannWhitneyResult(u, p, false);
    }

    /// <summary>erfc(x) para x ≥ 0 (Abramowitz-Stegun 7.1.26; error absoluto &lt; 1,5e-7).</summary>
    private static double Erfc(double x)
    {
        double t = 1.0 / (1.0 + 0.3275911 * x);
        double poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))));
        return poly * Math.Exp(-x * x);
    }
}
