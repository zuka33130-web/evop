using EvoOptimizer.Core.Memory;
using Xunit;

namespace EvoOptimizer.Core.Tests;

public class MemoryAnalyzerTests
{
    [Fact]
    public void Window_below_minimum_is_insufficient_data()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(29, 16, 8, 0), TestData.Bytes(16));
        Assert.Equal(MemoryState.InsufficientData, a.State);
    }

    [Fact]
    public void Window_at_minimum_is_evaluated()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(30, 16, 8, 0), TestData.Bytes(16));
        Assert.Equal(MemoryState.Healthy, a.State);
    }

    [Theory]
    [InlineData(8, 0.8)]    // 10 % de 8 GB
    [InlineData(16, 1.6)]   // 10 % de 16 GB
    [InlineData(64, 2.0)]   // 10 % serían 6,4 GB, pero el tope es 2 GB
    public void Low_memory_threshold_scales_with_installed_ram_and_is_capped(double totalGib, double expectedGib)
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, totalGib, totalGib / 2, 0), TestData.Bytes(totalGib));
        Assert.Equal(expectedGib, a.LowAvailableThresholdBytes!.Value / TestData.Gib, 2);
    }

    [Theory]
    [InlineData(8, MemoryState.PagingWithoutShortage)]  // 1,5 GB libres > umbral 0,8 GB
    [InlineData(16, MemoryState.Pressure)]              // 1,5 GB libres < umbral 1,6 GB
    [InlineData(64, MemoryState.Pressure)]              // 1,5 GB libres < umbral 2,0 GB
    public void Same_available_memory_gives_different_verdict_depending_on_installed_ram(double totalGib, MemoryState expected)
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, totalGib, 1.5, 500), TestData.Bytes(totalGib));
        Assert.Equal(expected, a.State);
    }

    [Fact]
    public void Low_available_with_sustained_paging_is_pressure()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 8, 0.5, 300), TestData.Bytes(8));
        Assert.Equal(MemoryState.Pressure, a.State);
        Assert.True(a.AvailabilityLow);
        Assert.True(a.PagingSustained);
    }

    [Fact]
    public void Low_available_without_paging_is_reduced_headroom_not_pressure()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 8, 0.5, 10), TestData.Bytes(8));
        Assert.Equal(MemoryState.ReducedHeadroom, a.State);
    }

    [Fact]
    public void Sustained_paging_with_enough_memory_is_not_shortage()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 16, 8, 300), TestData.Bytes(16));
        Assert.Equal(MemoryState.PagingWithoutShortage, a.State);
    }

    [Fact]
    public void High_commit_is_detected()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 16, 8, 0, commitRatio: 0.9), TestData.Bytes(16));
        Assert.Equal(MemoryState.CommitNearLimit, a.State);
        Assert.True(a.CommitHigh);
    }

    [Fact]
    public void Pressure_takes_precedence_over_commit_but_still_reports_commit()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 8, 0.5, 300, commitRatio: 0.9), TestData.Bytes(8));
        Assert.Equal(MemoryState.Pressure, a.State);
        Assert.True(a.CommitHigh);
    }

    [Fact]
    public void Missing_paging_counter_with_low_memory_does_not_claim_pressure()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 8, 0.5, null), TestData.Bytes(8));
        Assert.Equal(MemoryState.ReducedHeadroom, a.State);
        Assert.Null(a.PagingSustained);
        Assert.Equal(0, a.PagingSampleCount);
    }

    [Fact]
    public void Missing_paging_counter_with_enough_memory_is_healthy_but_flagged_unknown()
    {
        var a = MemoryAnalyzer.Analyze(TestData.Window(60, 16, 8, null), TestData.Bytes(16));
        Assert.Equal(MemoryState.Healthy, a.State);
        Assert.Null(a.PagingSustained);
    }

    [Fact]
    public void Transient_paging_spikes_do_not_count_as_sustained()
    {
        // 55 s sin lecturas y 5 s con 5000 págs/s (por ejemplo, la carga de un programa).
        var paging = Enumerable.Repeat<double?>(0.0, 55).Concat(Enumerable.Repeat<double?>(5000.0, 5));
        var a = MemoryAnalyzer.Analyze(TestData.PagingWindow(16, 8, paging), TestData.Bytes(16));

        Assert.Equal(MemoryState.Healthy, a.State);
        Assert.False(a.PagingSustained);
        Assert.Equal(0.0, a.MedianPagesInputPerSec);
        Assert.Equal(5000.0, a.P95PagesInputPerSec);   // el pico se reporta, pero no decide el estado
    }

    [Fact]
    public void Paging_threshold_is_inclusive_and_uses_mean_of_middle_values_for_even_counts()
    {
        // 30 muestras: 15 × 0 y 15 × 200 → mediana = (0 + 200) / 2 = 100 = umbral.
        var paging = Enumerable.Repeat<double?>(0.0, 15).Concat(Enumerable.Repeat<double?>(200.0, 15));
        var a = MemoryAnalyzer.Analyze(TestData.PagingWindow(16, 8, paging), TestData.Bytes(16));

        Assert.Equal(100.0, a.MedianPagesInputPerSec);
        Assert.True(a.PagingSustained);
        Assert.Equal(MemoryState.PagingWithoutShortage, a.State);
    }
}
