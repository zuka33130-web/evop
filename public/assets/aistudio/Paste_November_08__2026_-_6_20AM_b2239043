namespace EvoOptimizer.Infrastructure.Telemetry;

/// <summary>
/// CPU: delta de GetSystemTimes entre muestras (utilización global, 0..100). La primera muestra devuelve null.
/// Memoria: GlobalMemoryStatusEx (física y commit).
/// Paginación: PDH \Memory\Pages Input/sec (null si el contador no está disponible).
/// No mide GPU, temperatura, disco ni procesos por hilo: esos campos no existen aún en el snapshot.
/// </summary>
[SupportedOSPlatform("windows")]
public sealed class WindowsTelemetryProvider : ITelemetryProvider, IDisposable
{
    private readonly PdhCounter _pagesInput = new(@"\Memory\Pages Input/sec");
    private bool _hasPrevious;
    private ulong _prevIdle, _prevKernel, _prevUser;

    public TelemetrySnapshot Sample()
    {
        double? memLoad = null;
        ulong? total = null, avail = null, commitUsed = null, commitLimit = null;

        if (NativeMethods.TryGetMemoryStatus(out var m))
        {
            memLoad = m.dwMemoryLoad;
            total = m.ullTotalPhys;
            avail = m.ullAvailPhys;
            commitLimit = m.ullTotalPageFile;
            commitUsed = m.ullTotalPageFile >= m.ullAvailPageFile ? m.ullTotalPageFile - m.ullAvailPageFile : null;
        }

        double? cpu = ReadCpuPercent();
        double? paging = _pagesInput.Read();

        return new TelemetrySnapshot(DateTimeOffset.Now, cpu, memLoad, total, avail, commitUsed, commitLimit, paging);
    }

    private double? ReadCpuPercent()
    {
        if (!NativeMethods.GetSystemTimes(out var idle, out var kernel, out var user))
            return null;

        ulong i = idle.Value, k = kernel.Value, u = user.Value;
        double? result = null;

        if (_hasPrevious)
        {
            ulong dIdle = i - _prevIdle;
            ulong dTotal = (k - _prevKernel) + (u - _prevUser); // kernel incluye idle
            if (dTotal > 0 && dTotal >= dIdle)
                result = Math.Clamp((dTotal - dIdle) * 100.0 / dTotal, 0, 100);
        }

        _prevIdle = i; _prevKernel = k; _prevUser = u;
        _hasPrevious = true;
        return result;
    }

    public void Dispose() => _pagesInput.Dispose();
}
