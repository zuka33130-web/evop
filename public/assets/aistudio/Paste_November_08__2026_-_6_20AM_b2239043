        OptimizationGoal goal = OptimizationGoal.Everyday,
        IReadOnlyList<ProcessMemoryUsage>? consumers = null)
        => _engine.Evaluate(TestData.Context(
            TestData.Window(samples, totalGib, availGib, paging, commit), totalGib, goal, consumers));

    private static readonly IReadOnlyList<ProcessMemoryUsage> Consumers = new[]
    {
        new ProcessMemoryUsage("chrome", 12, TestData.Bytes(3.0), TestData.Bytes(4.0)),
