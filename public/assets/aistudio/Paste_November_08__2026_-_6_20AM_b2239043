using static EvoOptimizer.Core.Benchmarking.BenchmarkFormat;

namespace EvoOptimizer.Core.Benchmarking;

/// <summary>
/// Compara dos grupos de corridas (antes/después). Sin estado ni efectos secundarios.
/// Regla de decisión (m = mínimo relevante, [lo, hi] = IC bootstrap del cambio relativo orientado):
///   Mejora        : p &lt; α  y  lo &gt; 0  y  estimación ≥ m
///   Empeora       : p &lt; α  y  hi &lt; 0  y  estimación ≤ −m
///   Sin cambio    : lo ≥ −m  y  hi ≤ m        (equivalencia: todo el IC es irrelevante)
///   No concluyente: cualquier otro caso
/// Exigir p e IC a la vez es deliberadamente conservador.
/// </summary>
public static class BenchmarkComparer
{
    private const double NormalConsistency = 1.4826; // MAD → desviación típica si la distribución es normal

    public static ComparisonResult Compare(MeasurementSeries before, MeasurementSeries after, ComparisonOptions? options = null)
    {
        ArgumentNullException.ThrowIfNull(before);
        ArgumentNullException.ThrowIfNull(after);
        ArgumentNullException.ThrowIfNull(before.RunValues);
        ArgumentNullException.ThrowIfNull(after.RunValues);
        options ??= ComparisonOptions.Default;
        ValidateOptions(options);
        if (before.Metric != after.Metric)
            throw new ArgumentException("Ambas series deben medir la misma métrica con la misma especificación.");
        ValidateMetric(before.Metric);

        var spec = before.Metric;
        int nB = before.RunValues.Count, nA = after.RunValues.Count;

        string ctxB = (before.WorkloadContext ?? "").Trim();
        string ctxA = (after.WorkloadContext ?? "").Trim();
        if (ctxB.Length == 0 || ctxA.Length == 0)
            return Inconclusive(InconclusiveReason.ContextMismatch,
                "No se puede comparar: falta declarar el contexto de carga (juego, escena, resolución, duración).",
                nB, nA, new[] { "Un score o una comparación solo es válido dentro del mismo contexto de medición." });
        if (!string.Equals(ctxB, ctxA, StringComparison.OrdinalIgnoreCase))
            return Inconclusive(InconclusiveReason.ContextMismatch,
                "No se puede comparar: los dos grupos se midieron en contextos de carga distintos.",
                nB, nA, new[] { $"Antes: «{ctxB}». Después: «{ctxA}». Comparar contextos distintos mezcla el efecto del ajuste con el de la carga." });

        if (!AllFinite(before.RunValues) || !AllFinite(after.RunValues))
            return Inconclusive(InconclusiveReason.InvalidData,
                "No se puede comparar: hay valores no numéricos o infinitos.", nB, nA, Array.Empty<string>());

        double? medB = nB > 0 ? RobustStatistics.Median(before.RunValues) : null;
        double? medA = nA > 0 ? RobustStatistics.Median(after.RunValues) : null;

        if (nB < options.MinRunsPerGroup || nA < options.MinRunsPerGroup)
            return Inconclusive(InconclusiveReason.InsufficientRuns,
                $"Datos insuficientes: se necesitan al menos {options.MinRunsPerGroup} corridas por grupo y hay {nB} antes y {nA} después.",
                nB, nA,
                new[]
                {
                    "Una sola captura no mide un ajuste: el ruido entre corridas puede ser mayor que el efecto.",
                    "Con pocas corridas, incluso una separación perfecta puede no alcanzar significación: con 3 y 3 corridas el menor p posible es 0,10."
                },
                medB, medA);

        double[] b = before.RunValues.ToArray();
        double[] a = after.RunValues.ToArray();
        double medianB = RobustStatistics.Median(b);
        double medianA = RobustStatistics.Median(a);

        if (medianB <= 0)
            return Inconclusive(InconclusiveReason.DegenerateBaseline,
                "No se puede calcular el cambio relativo: la mediana de la línea base es 0 o negativa.",
                nB, nA, Array.Empty<string>(), medianB, medianA);

        double sign = spec.Direction == MetricDirection.HigherIsBetter ? 1.0 : -1.0;
        double estimate = sign * (medianA - medianB) / medianB;

        var mw = MannWhitneyTest.TwoSided(a, b); // primer grupo = después
        double pairs = (double)nA * nB;
        double probImprovement = spec.Direction == MetricDirection.HigherIsBetter
            ? mw.UStatisticFirst / pairs
            : 1.0 - mw.UStatisticFirst / pairs;

        var (lo, hi) = BootstrapInterval(b, a, sign, medianB, options);
        double noise = NormalConsistency * RobustStatistics.MedianAbsoluteDeviation(b) / medianB;

        double m = spec.MinimumRelevantChange;
        bool significant = mw.PValue < options.Alpha;

        BenchmarkVerdict verdict;
        InconclusiveReason reason = InconclusiveReason.None;
        if (significant && lo > 0 && estimate >= m) verdict = BenchmarkVerdict.Improved;
        else if (significant && hi < 0 && estimate <= -m) verdict = BenchmarkVerdict.Regressed;
        else if (lo >= -m && hi <= m) verdict = BenchmarkVerdict.NoChange;
        else { verdict = BenchmarkVerdict.Inconclusive; reason = InconclusiveReason.Ambiguous; }

        var notes = new List<string>();
        if (Math.Min(nB, nA) < 10)
            notes.Add("Con menos de 10 corridas por grupo el intervalo bootstrap tiende a ser demasiado estrecho (optimista); interprétalo con cautela.");

        switch (verdict)
        {
            case BenchmarkVerdict.Improved:
                if (lo < m)
                    notes.Add($"El límite inferior del intervalo ({Percent(lo)}) queda por debajo del mínimo relevante ({Percent(m, false)}): la mejora es real, pero podría ser de poca magnitud.");
                notes.Add(CausalityNote);
                break;
            case BenchmarkVerdict.Regressed:
                if (hi > -m)
                    notes.Add($"El límite superior del intervalo ({Percent(hi)}) queda por encima de −{Percent(m, false)}: el empeoramiento es real, pero podría ser de poca magnitud.");
                notes.Add(CausalityNote);
                break;
            case BenchmarkVerdict.NoChange:
                if (significant)
                    notes.Add($"Se detecta una diferencia estadísticamente distinguible ({PValue(mw.PValue)}), pero es menor que el mínimo relevante (±{Percent(m, false)}): no se considera mejora ni empeoramiento práctico.");
                break;
            default:
                notes.Add("«No concluyente» no significa «sin efecto»: significa que los datos no bastan para afirmar ni descartar un efecto del tamaño relevante.");
                if (noise > m)
                    notes.Add($"El ruido entre corridas de la línea base (≈{Percent(noise, false)}) supera el mínimo relevante ({Percent(m, false)}): hacen falta más corridas o condiciones más controladas para detectar efectos de ese tamaño.");
                break;
        }

        string name = spec.Name;
        string ci = $"IC {1 - options.Alpha:P0}: {Percent(lo)} a {Percent(hi)}";
        string summary = verdict switch
        {
            BenchmarkVerdict.Improved => $"Mejora respaldada por los datos en «{name}»: {Percent(estimate)} ({ci}; {PValue(mw.PValue)}).",
            BenchmarkVerdict.Regressed => $"Empeoramiento respaldado por los datos en «{name}»: {Percent(estimate)} ({ci}; {PValue(mw.PValue)}).",
            BenchmarkVerdict.NoChange => $"Sin cambio práctico en «{name}»: el intervalo ({Percent(lo)} a {Percent(hi)}) queda dentro de ±{Percent(m, false)}.",
            _ => $"No concluyente en «{name}»: cambio estimado {Percent(estimate)}, pero el intervalo ({Percent(lo)} a {Percent(hi)}) no permite afirmar ni descartar un efecto relevante ({PValue(mw.PValue)})."
        };

        return new ComparisonResult(verdict, reason, summary, notes, nB, nA, medianB, medianA,
            estimate, lo, hi, mw.PValue, mw.IsExact, probImprovement, noise);
    }

    private const string CausalityNote =
        "Esto demuestra una diferencia entre dos grupos de corridas, no que el ajuste sea la causa: temperatura, caché de disco, procesos en segundo plano o drivers pueden diferir entre grupos. Alterna corridas antes/después (A-B-A-B) y repite en otra sesión para confirmarlo.";

    private static (double Low, double High) BootstrapInterval(double[] before, double[] after, double sign, double denominator, ComparisonOptions o)
    {
        var rng = new SplitMix64(o.Seed);
        var rb = new double[before.Length];
        var ra = new double[after.Length];
        var stats = new double[o.BootstrapResamples];

        for (int r = 0; r < stats.Length; r++)
        {
            for (int i = 0; i < rb.Length; i++) rb[i] = before[rng.NextIndex(before.Length)];
            for (int i = 0; i < ra.Length; i++) ra[i] = after[rng.NextIndex(after.Length)];
            Array.Sort(rb);
            Array.Sort(ra);
            stats[r] = sign * (RobustStatistics.MedianOfSorted(ra) - RobustStatistics.MedianOfSorted(rb)) / denominator;
        }

        Array.Sort(stats);
        return (RobustStatistics.PercentileOfSorted(stats, o.Alpha / 2),
                RobustStatistics.PercentileOfSorted(stats, 1 - o.Alpha / 2));
    }

    private static bool AllFinite(IReadOnlyList<double> values)
    {
        for (int i = 0; i < values.Count; i++)
            if (!double.IsFinite(values[i])) return false;
        return true;
    }

    private static ComparisonResult Inconclusive(InconclusiveReason reason, string summary, int nB, int nA,
        IReadOnlyList<string> notes, double? medB = null, double? medA = null)
        => new(BenchmarkVerdict.Inconclusive, reason, summary, notes, nB, nA, medB, medA,
               null, null, null, null, null, null, null);

    private static void ValidateOptions(ComparisonOptions o)
    {
        if (o.MinRunsPerGroup < 4)
            throw new ArgumentException("MinRunsPerGroup debe ser ≥ 4: con menos corridas Mann-Whitney casi nunca alcanza significación.", nameof(o));
        if (!(o.Alpha > 0 && o.Alpha < 0.5))
            throw new ArgumentException("Alpha debe estar en (0, 0.5).", nameof(o));
        if (o.BootstrapResamples < 1000)
            throw new ArgumentException("BootstrapResamples debe ser ≥ 1000.", nameof(o));
    }

    private static void ValidateMetric(MetricSpec m)
    {
        if (string.IsNullOrWhiteSpace(m.Name))
            throw new ArgumentException("La métrica necesita un nombre.");
        if (!(m.MinimumRelevantChange > 0 && m.MinimumRelevantChange <= 0.5))
            throw new ArgumentException("MinimumRelevantChange debe estar en (0, 0.5].");
    }

    /// <summary>Generador determinista (SplitMix64): mismo resultado en cualquier runtime o versión.</summary>
    private sealed class SplitMix64
    {
        private ulong _state;
        public SplitMix64(ulong seed) => _state = seed;

        private ulong Next()
        {
            unchecked
            {
                _state += 0x9E3779B97F4A7C15UL;
                ulong z = _state;
                z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL;
                z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL;
                return z ^ (z >> 31);
            }
        }

        public int NextIndex(int exclusiveMax) => (int)(Next() % (ulong)exclusiveMax);
    }
}
