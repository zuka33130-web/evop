using EvoOptimizer.Core.Benchmarking;

namespace EvoOptimizer.Core.Frames;

/// <summary>Métricas de una corrida. Fórmulas y filtros documentados en la sección 2 del diseño. Sin estado.</summary>
public static class FrameTimeAnalyzer
{
    private const double MadToSigma = 1.4826;

    public static FrameStats Analyze(FrameRun run, FrameAnalysisOptions? options = null)
    {
        ArgumentNullException.ThrowIfNull(run);
        ArgumentNullException.ThrowIfNull(run.FrameTimesMs);
        options ??= FrameAnalysisOptions.Default;
        Validate(options);

        var notes = new List<string>();
        var kept = new List<double>(run.FrameTimesMs.Count);
        var afterGap = new List<bool>(run.FrameTimesMs.Count);
        double warmupMs = options.WarmupSeconds * 1000.0;
        double elapsed = 0;
        int skipped = 0, paused = 0;
        bool gap = false;

        foreach (double ms in run.FrameTimesMs)
        {
            if (!double.IsFinite(ms) || ms <= 0)
                throw new ArgumentException("FrameRun contiene un intervalo no válido (no finito o ≤ 0); debe validarse antes de analizar.", nameof(run));

            if (elapsed < warmupMs)
            {
                elapsed += ms;
                skipped++;
                continue;
            }
            elapsed += ms;

            if (ms >= options.PauseThresholdMs)
            {
                paused++;
                gap = true;
                continue;
            }

            kept.Add(ms);
            afterGap.Add(gap);
            gap = false;
        }

        if (skipped > 0) notes.Add($"Calentamiento descartado: {skipped} fotogramas ({options.WarmupSeconds:0.#} s).");
        if (paused > 0) notes.Add($"{paused} fotogramas ≥ {options.PauseThresholdMs:0} ms se excluyeron como pausas (alt-tab, cargas); no entran en las métricas.");

        int n = kept.Count;
        if (n == 0)
        {
            notes.Add("Información insuficiente: no quedan fotogramas válidos tras excluir calentamiento y pausas.");
            return new FrameStats(0, paused, skipped, 0.0,
                null, null, null, null, null, null, null, null, null, null, 0, null, notes);
        }

        double sum = 0;
        foreach (double x in kept) sum += x;

        var sorted = kept.ToArray();
        Array.Sort(sorted);
        double median = RobustStatistics.MedianOfSorted(sorted);

        double? one = TailLowFps(sorted, 100, options.MinTailFrames);
        double? pointOne = TailLowFps(sorted, 1000, options.MinTailFrames);
        if (one is null)
            notes.Add($"1 % low: información insuficiente (se necesitan ≥ {MinFramesForTail(100, options.MinTailFrames)} fotogramas; hay {n}).");
        if (pointOne is null)
            notes.Add($"0,1 % low: información insuficiente (se necesitan ≥ {MinFramesForTail(1000, options.MinTailFrames)} fotogramas; hay {n}).");

        double diffSum = 0;
        int diffCount = 0;
        for (int i = 1; i < n; i++)
        {
            if (afterGap[i]) continue;
            diffSum += Math.Abs(kept[i] - kept[i - 1]);
            diffCount++;
        }

        var deviations = new double[n];
        for (int i = 0; i < n; i++) deviations[i] = Math.Abs(sorted[i] - median);
        Array.Sort(deviations);
        double mad = RobustStatistics.MedianOfSorted(deviations);

        double spikeThreshold = options.SpikeFactor * median;
        int spikes = 0;
        foreach (double x in kept) if (x > spikeThreshold) spikes++;

        return new FrameStats(
            ValidFrames: n,
            PausedFrames: paused,
            WarmupFramesSkipped: skipped,
            DurationSeconds: sum / 1000.0,
            AverageFps: 1000.0 * n / sum,
            MedianFrameTimeMs: median,
            P95FrameTimeMs: RobustStatistics.PercentileOfSorted(sorted, 0.95),
            P99FrameTimeMs: RobustStatistics.PercentileOfSorted(sorted, 0.99),
            MinFrameTimeMs: sorted[0],
            MaxFrameTimeMs: sorted[n - 1],
            OnePercentLowFps: one,
            PointOnePercentLowFps: pointOne,
            RobustVariability: MadToSigma * mad / median,
            MeanSuccessiveDifferenceMs: diffCount > 0 ? diffSum / diffCount : null,
            SpikeCount: spikes,
            SpikeFraction: (double)spikes / n,
            Notes: notes);
    }

    /// <summary>k = ⌈n/denominator⌉ (aritmética entera exacta); null si k &lt; minTail.</summary>
    private static double? TailLowFps(double[] sortedAscending, int denominator, int minTail)
    {
        int n = sortedAscending.Length;
        int k = (n + denominator - 1) / denominator;
        if (k < minTail) return null;

        double sum = 0;
        for (int i = n - k; i < n; i++) sum += sortedAscending[i];
        return 1000.0 / (sum / k);
    }

    private static int MinFramesForTail(int denominator, int minTail) => (minTail - 1) * denominator + 1;

    private static void Validate(FrameAnalysisOptions o)
    {
        if (!(o.PauseThresholdMs > 0)) throw new ArgumentException("PauseThresholdMs debe ser > 0.", nameof(o));
        if (!(o.WarmupSeconds >= 0)) throw new ArgumentException("WarmupSeconds debe ser ≥ 0.", nameof(o));
        if (!(o.SpikeFactor > 1)) throw new ArgumentException("SpikeFactor debe ser > 1.", nameof(o));
        if (o.MinTailFrames < 1) throw new ArgumentException("MinTailFrames debe ser ≥ 1.", nameof(o));
    }
}
