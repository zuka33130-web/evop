```csharp
using System.Collections.ObjectModel;
using System.Globalization;
using System.Windows.Input;
using EvoOptimizer.App.Mvvm;
using EvoOptimizer.Core.Benchmarking;
using EvoOptimizer.Core.Frames;
using Microsoft.Win32;

namespace EvoOptimizer.App.ViewModels;

public sealed record MetricOption(FrameMetric Metric, string Label);
public sealed record RunGroupOption(RunGroup Group, string Label);
public sealed record RunRow(string Id, string Text);

/// <summary>
/// Captura (PresentMon) o importación de CSV, análisis por corrida y comparación A/B.
/// EVO no cambia ningún ajuste: tú cambias la configuración entre corridas y EVO solo mide y compara.
/// </summary>
public sealed class FrametimeLabViewModel : ObservableObject
{
    private readonly Func<string, bool, IFrameCaptureSource> _captureFactory;
    private readonly List<LabeledRun> _runs = new();
    private CancellationTokenSource? _cts;
    private int _nextSequence = 1;

    private string _presentMonPath = "";
    private string _processName = "cs2.exe";
    private string _durationText = "60";
    private string _context = "";
    private string _marginText = "3";
    private bool _legacyFlags;
    private bool _isBusy;
    private bool _hasResult;
    private string _status = "Sin corridas.";
    private string _errorText = "";
    private string _verdictCode = "";
    private string _verdictLabel = "";
    private string _summary = "";
    private RunGroupOption _selectedGroup;
    private MetricOption _selectedMetric;
    private IReadOnlyList<string> _lastRunLines = Array.Empty<string>();
    private IReadOnlyList<string> _parseNotes = Array.Empty<string>();
    private IReadOnlyList<string> _stats = Array.Empty<string>();
    private IReadOnlyList<string> _notes = Array.Empty<string>();

    /// <param name="captureFactory">(ruta de PresentMon, flags 1.x) → fuente de captura. Lo aporta la raíz de composición.</param>
    public FrametimeLabViewModel(Func<string, bool, IFrameCaptureSource> captureFactory)
    {
        _captureFactory = captureFactory ?? throw new ArgumentNullException(nameof(captureFactory));

        Groups = new[]
        {
            new RunGroupOption(RunGroup.Baseline, "A · antes (configuración base)"),
            new RunGroupOption(RunGroup.Candidate, "B · después (configuración a probar)")
        };
        Metrics = new[]
        {
            new MetricOption(FrameMetric.OnePercentLowFps, "1 % low (FPS)"),
            new MetricOption(FrameMetric.P99FrameTimeMs, "Frametime P99 (ms)"),
            new MetricOption(FrameMetric.MedianFrameTimeMs, "Frametime mediano (ms)"),
            new MetricOption(FrameMetric.AverageFps, "FPS promedio"),
            new MetricOption(FrameMetric.PointOnePercentLowFps, "0,1 % low (FPS)")
        };
        _selectedGroup = Groups[0];
        _selectedMetric = Metrics[0];

        CaptureCommand = new RelayCommand(() => _ = CaptureAsync(), () => !IsBusy);
        ImportCommand = new RelayCommand(Import, () => !IsBusy);
        CancelCommand = new RelayCommand(() => _cts?.Cancel(), () => IsBusy);
        RemoveLastCommand = new RelayCommand(RemoveLast, () => !IsBusy && _runs.Count > 0);
        ClearCommand = new RelayCommand(Clear, () => !IsBusy && _runs.Count > 0);
        CompareCommand = new RelayCommand(Compare, () => !IsBusy);
    }

    public IReadOnlyList<RunGroupOption> Groups { get; }
    public IReadOnlyList<MetricOption> Metrics { get; }
    public ObservableCollection<RunRow> Runs { get; } = new();

    public RelayCommand CaptureCommand { get; }
    public RelayCommand ImportCommand { get; }
    public RelayCommand CancelCommand { get; }
    public RelayCommand RemoveLastCommand { get; }
    public RelayCommand ClearCommand { get; }
    public RelayCommand CompareCommand { get; }

    public string PresentMonPath { get => _presentMonPath; set => Set(ref _presentMonPath, value); }
    public string ProcessName { get => _processName; set => Set(ref _processName, value); }
    public string DurationText { get => _durationText; set => Set(ref _durationText, value); }
    public string Context { get => _context; set => Set(ref _context, value); }
    public string MarginText { get => _marginText; set => Set(ref _marginText, value); }
    public bool LegacyFlags { get => _legacyFlags; set => Set(ref _legacyFlags, value); }

    public RunGroupOption SelectedGroup
    {
        get => _selectedGroup;
        set { if (value is not null) Set(ref _selectedGroup, value); }
    }

    public MetricOption SelectedMetric
    {
        get => _selectedMetric;
        set { if (value is not null) Set(ref _selectedMetric, value); }
    }

    public bool IsBusy
    {
        get => _isBusy;
        private set { if (Set(ref _isBusy, value)) CommandManager.InvalidateRequerySuggested(); }
    }

    public bool HasResult { get => _hasResult; private set => Set(ref _hasResult, value); }
    public string Status { get => _status; private set => Set(ref _status, value); }
    public string ErrorText { get => _errorText; private set => Set(ref _errorText, value); }
    public string VerdictCode { get => _verdictCode; private set => Set(ref _verdictCode, value); }
    public string VerdictLabel { get => _verdictLabel; private set => Set(ref _verdictLabel, value); }
    public string Summary { get => _summary; private set => Set(ref _summary, value); }
    public IReadOnlyList<string> LastRunLines { get => _lastRunLines; private set => Set(ref _lastRunLines, value); }
    public IReadOnlyList<string> ParseNotes { get => _parseNotes; private set => Set(ref _parseNotes, value); }
    public IReadOnlyList<string> Stats { get => _stats; private set => Set(ref _stats, value); }
    public IReadOnlyList<string> Notes { get => _notes; private set => Set(ref _notes, value); }

    private async Task CaptureAsync()
    {
        if (string.IsNullOrWhiteSpace(PresentMonPath)) { Fail("Indica la ruta de PresentMon."); return; }
        if (!int.TryParse((DurationText ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int seconds)
            || seconds < 10 || seconds > 600)
        {
            Fail("La duración debe ser un número entero de segundos entre 10 y 600.");
            return;
        }
        if (string.IsNullOrWhiteSpace(Context)) { Fail("Declara el contexto de carga antes de capturar."); return; }

        IsBusy = true;
        ErrorText = "";
        Status = $"Capturando {seconds} s… mantén el juego en primer plano y la escena estable.";
        _cts = new CancellationTokenSource();

        try
        {
            var source = _captureFactory(PresentMonPath.Trim(), LegacyFlags);
            var parsed = await source.CaptureAsync(
                new FrameCaptureRequest(ProcessName ?? "", TimeSpan.FromSeconds(seconds)), _cts.Token);
            AddRun(parsed);
        }
        catch (Exception ex) // frontera de UI: cualquier fallo se muestra, nunca se oculta
        {
            Fail($"Error inesperado en la captura: {ex.Message}");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            IsBusy = false;
        }
    }

    private void Import()
    {
        var dialog = new OpenFileDialog { Filter = "CSV de PresentMon|*.csv|Todos los archivos|*.*" };
        if (dialog.ShowDialog() != true) return;
        AddRun(PresentMonCsvParser.ParseFile(dialog.FileName));
    }

    private void AddRun(FrameParseResult parsed)
    {
        if (parsed.Run is null) { Fail(parsed.Error ?? "Error desconocido."); return; }

        string ctx = (Context ?? "").Trim();
        if (ctx.Length == 0) { Fail("Declara el contexto de carga antes de añadir una corrida."); return; }

        FrameStats stats;
        try { stats = FrameTimeAnalyzer.Analyze(parsed.Run); }
        catch (ArgumentException ex) { Fail(ex.Message); return; }

        if (stats.ValidFrames == 0) { Fail("Información insuficiente: no quedaron fotogramas válidos."); return; }

        int seq = _nextSequence++;
        var run = new LabeledRun($"#{seq}", SelectedGroup.Group, seq, ctx, stats);
        _runs.Add(run);
        string groupName = run.Group == RunGroup.Baseline ? "A (antes)" : "B (después)";
        Runs.Add(new RunRow(run.Id, $"{run.Id} · {groupName} · {FrameStatsFormatter.OneLine(stats)}"));

        LastRunLines = FrameStatsFormatter.Lines(stats);
        ParseNotes = parsed.Warnings;
        ErrorText = "";
        HasResult = false;
        Status = $"Corrida {run.Id} añadida al grupo {groupName}. Total: {_runs.Count}.";

        // Para favorecer el diseño A-B-A-B se propone el otro grupo para la siguiente corrida (puedes cambiarlo).
        SelectedGroup = Groups[run.Group == RunGroup.Baseline ? 1 : 0];
        CommandManager.InvalidateRequerySuggested();
    }

    private void RemoveLast()
    {
        if (_runs.Count == 0) return;
        _runs.RemoveAt(_runs.Count - 1);
        Runs.RemoveAt(Runs.Count - 1);
        HasResult = false;
        Status = $"Total de corridas: {_runs.Count}.";
        CommandManager.InvalidateRequerySuggested();
    }

    private void Clear()
    {
        _runs.Clear();
        Runs.Clear();
        _nextSequence = 1;
        HasResult = false;
        LastRunLines = Array.Empty<string>();
        ParseNotes = Array.Empty<string>();
        Status = "Sin corridas.";
        CommandManager.InvalidateRequerySuggested();
    }

    private void Compare()
    {
        if (!double.TryParse((MarginText ?? "").Trim().Replace(',', '.'), NumberStyles.Float,
                CultureInfo.InvariantCulture, out double pct) || !(pct > 0 && pct <= 50))
        {
            Fail("El mínimo relevante debe ser un porcentaje mayor que 0 y no superior a 50.");
            return;
        }

        var options = ComparisonOptions.Default;
        ExperimentResult result;
        try { result = FrameExperiment.Evaluate(_runs, SelectedMetric.Metric, pct / 100.0, options); }
        catch (ArgumentException ex) { Fail(ex.Message); return; }

        var c = result.Comparison;
        ErrorText = "";
        VerdictCode = c.Verdict.ToString();
        VerdictLabel = c.Verdict switch
        {
            BenchmarkVerdict.Improved => "MEJORA",
            BenchmarkVerdict.NoChange => "SIN CAMBIO",
            BenchmarkVerdict.Regressed => "EMPEORA",
            _ => "NO CONCLUYENTE"
        };
        Summary = c.Summary;
        Notes = result.DesignWarnings.Concat(c.Notes).ToArray();
        Stats = BuildStats(c, options);
        HasResult = true;
    }

    private void Fail(string message)
    {
        ErrorText = message;
        HasResult = false;
        Status = "Operación no completada.";
    }

    private static IReadOnlyList<string> BuildStats(ComparisonResult r, ComparisonOptions o)
    {
        var lines = new List<string> { $"Corridas: {r.RunsBefore} en A · {r.RunsAfter} en B" };
        if (r.MedianBefore is { } mb && r.MedianAfter is { } ma) lines.Add($"Mediana por corrida: {mb:G5} → {ma:G5}");
        if (r.RelativeChange is { } rc) lines.Add($"Cambio relativo (positivo = mejor): {BenchmarkFormat.Percent(rc)}");
        if (r.CiLow is { } lo && r.CiHigh is { } hi)
            lines.Add($"IC {1 - o.Alpha:P0} (bootstrap, {o.BootstrapResamples:N0} remuestreos): {BenchmarkFormat.Percent(lo)} a {BenchmarkFormat.Percent(hi)}");
        if (r.PValue is { } p)
            lines.Add($"Mann-Whitney U bilateral: {BenchmarkFormat.PValue(p)} ({(r.PValueIsExact == true ? "exacto" : "aprox. normal")})");
        if (r.BaselineNoise is { } n)
            lines.Add($"Ruido de la línea base (MAD robusto / mediana): {BenchmarkFormat.Percent(n, false)}");
        return lines;
    }
