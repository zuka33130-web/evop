using EvoOptimizer.Core.Telemetry;

namespace EvoOptimizer.Core.Memory;

public enum MemoryState { InsufficientData, Healthy, PagingWithoutShortage, ReducedHeadroom, CommitNearLimit, Pressure }

public sealed record MemoryAssessment(
    MemoryState State,
    int SampleCount,
    int PagingSampleCount,
    ulong? TotalBytes,
    ulong? LowAvailableThresholdBytes = null,
    double? MedianAvailableBytes = null,
    double? MedianCommitRatio = null,
    double? MaxCommitRatio = null,
    double? MedianPagesInputPerSec = null,
    double? P95PagesInputPerSec = null,
    bool? AvailabilityLow = null,
    bool? CommitHigh = null,
    bool? PagingSustained = null);

/// <summary>
/// Memory Intelligence: estadística pura sobre una ventana de telemetría. No depende de Windows.
/// Los umbrales son HEURÍSTICOS y no están calibrados empíricamente; el Historical Analysis Engine
/// deberá ajustarlos con datos reales de cada equipo.
/// </summary>
public static class MemoryAnalyzer
{
    public const int MinSamples = 30;
    public const double CommitHighRatio = 0.85;
    public const double PagingSustainedPagesPerSec = 100;
    public const double LowAvailableFraction = 0.10;
    public const ulong LowAvailableCapBytes = 2UL * 1024 * 1024 * 1024;

    public static MemoryAssessment Analyze(IReadOnlyList<TelemetrySnapshot> window, ulong? installedBytes)
    {
        var avail = new List<double>();
        var commit = new List<double>();
        var paging = new List<double>();
        ulong? total = installedBytes;

        foreach (var s in window)
        {
            if (s.MemoryTotalBytes is { } t && s.MemoryAvailableBytes is { } a && t > 0 && a <= t)
            {
                avail.Add(a);
                total = t;
            }
            if (s.CommitUsedBytes is { } cu && s.CommitLimitBytes is { } cl && cl > 0)
                commit.Add((double)cu / cl);
            if (s.HardPageInputPerSec is { } p)
                paging.Add(p);
        }

        if (total is null || total.Value == 0 || avail.Count < MinSamples)
            return new MemoryAssessment(MemoryState.InsufficientData, avail.Count, paging.Count, total);

        ulong totalBytes = total.Value;
        ulong threshold = Math.Min((ulong)(totalBytes * LowAvailableFraction), LowAvailableCapBytes);

        double medAvail = Median(avail);
        bool low = medAvail < threshold;

        double? medCommit = null, maxCommit = null;
        bool? commitHigh = null;
        if (commit.Count >= MinSamples)
        {
            maxCommit = commit.Max();
            medCommit = Median(commit);
            commitHigh = medCommit >= CommitHighRatio;
        }

        double? medPaging = null, p95 = null;
        bool? pagingSustained = null;
        if (paging.Count >= MinSamples)
        {
            medPaging = Median(paging);
            p95 = Percentile(paging, 0.95);
            pagingSustained = medPaging >= PagingSustainedPagesPerSec;
        }

        MemoryState state =
            low && pagingSustained == true ? MemoryState.Pressure :
            commitHigh == true ? MemoryState.CommitNearLimit :
            low ? MemoryState.ReducedHeadroom :
            pagingSustained == true ? MemoryState.PagingWithoutShortage :
            MemoryState.Healthy;

        return new MemoryAssessment(state, avail.Count, paging.Count, totalBytes, threshold, medAvail,
            medCommit, maxCommit, medPaging, p95, low, commitHigh, pagingSustained);
    }

    private static double Median(List<double> values)
    {
        var v = values.ToArray();
        Array.Sort(v);
        int n = v.Length;
        return n % 2 == 1 ? v[n / 2] : (v[n / 2 - 1] + v[n / 2]) / 2.0;
    }

    private static double Percentile(List<double> values, double q)
    {
        var v = values.ToArray();
        Array.Sort(v);
        int idx = Math.Clamp((int)Math.Ceiling(q * v.Length) - 1, 0, v.Length - 1);
        return v[idx];
    }
}
