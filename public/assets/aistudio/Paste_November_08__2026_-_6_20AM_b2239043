    {
        var r = Run(16, 8, 0, samples: 10);

        var f = Assert.Single(r.Findings);
        Assert.Equal("memory.insufficient-data", f.Id);
        Assert.Equal(0, f.Confidence);
        Assert.Empty(r.Recommendations);
    }

