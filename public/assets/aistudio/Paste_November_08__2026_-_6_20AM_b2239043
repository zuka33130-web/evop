```csharp
using System.Globalization;

namespace EvoOptimizer.Core.Benchmarking;

/// <summary>
/// Interpreta una lista de valores escrita por el usuario. Separadores: espacios, saltos de línea o ';'.
/// La coma o el punto se aceptan SOLO como separador decimal. Ante cualquier ambigüedad rechaza la entrada
/// con un error explícito en lugar de adivinar.
/// </summary>
public static class RunListParser
{
    private static readonly char[] Separators = { ' ', '\t', '\r', '\n', ';' };

    public static bool TryParse(string? text, out IReadOnlyList<double> values, out string? error)
    {
        values = Array.Empty<double>();
        error = null;

        if (string.IsNullOrWhiteSpace(text))
        {
            error = "No hay valores.";
            return false;
        }

        var list = new List<double>();
        foreach (var token in text.Split(Separators, StringSplitOptions.RemoveEmptyEntries))
        {
            if (!double.TryParse(token.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out double v)
                || !double.IsFinite(v))
            {
                error = $"No se pudo interpretar «{token}» como número. Separa los valores con espacios, saltos de línea o punto y coma; usa coma o punto solo como separador decimal.";
                return false;
            }
            list.Add(v);
        }

        values = list;
        return true;
    }
}
