using System.Globalization;
using System.Text;

namespace EvoOptimizer.Core.Frames;

/// <summary>
/// Lee el CSV de PresentMon por NOMBRE de columna (no por posición).
/// Columna de intervalo aceptada: "MsBetweenPresents" (1.x) o "FrameTime" (2.x); ambas se tratan como
/// intervalo presente-a-presente. Verifica la cabecera de tu versión: si no existe ninguna, falla con error explícito.
/// </summary>
public static class PresentMonCsvParser
{
    private static readonly string[] FrameTimeColumns = { "MsBetweenPresents", "FrameTime" };

    public static FrameParseResult ParseFile(string path)
    {
        try
        {
            return Parse(File.ReadLines(path), path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            return FrameParseResult.Failure($"No se pudo leer «{path}»: {ex.Message}");
        }
    }

    public static FrameParseResult Parse(IEnumerable<string> lines, string? source = null)
    {
        ArgumentNullException.ThrowIfNull(lines);
        using var e = lines.GetEnumerator();

        string? header = null;
        while (e.MoveNext())
        {
            if (!string.IsNullOrWhiteSpace(e.Current)) { header = e.Current; break; }
        }
        if (header is null)
            return FrameParseResult.Failure("Información insuficiente: el archivo está vacío.");

        var cols = SplitCsvLine(header.TrimStart('\uFEFF')).Select(c => c.Trim()).ToList();

        int ftIdx = -1;
        foreach (var name in FrameTimeColumns)
        {
            ftIdx = IndexOf(cols, name);
            if (ftIdx >= 0) break;
        }
        if (ftIdx < 0)
            return FrameParseResult.Failure(
                $"No se encontró ninguna columna de intervalo de presentación ({string.Join(" / ", FrameTimeColumns)}). Columnas del archivo: {string.Join(", ", cols)}.");

        int appIdx = IndexOf(cols, "Application");
        int scIdx = IndexOf(cols, "SwapChainAddress");
        int needed = Math.Max(ftIdx, Math.Max(appIdx, scIdx));

        var groups = new Dictionary<(string App, string Chain), List<double>>();
        int invalid = 0;

        while (e.MoveNext())
        {
            string line = e.Current;
            if (string.IsNullOrWhiteSpace(line)) continue;

            var f = SplitCsvLine(line);
            if (f.Count <= needed) { invalid++; continue; }

            if (!double.TryParse(f[ftIdx].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out double ms)
                || !double.IsFinite(ms) || ms <= 0)
            {
                invalid++;
                continue;
            }

            var key = (appIdx >= 0 ? f[appIdx].Trim() : "(sin columna Application)",
                       scIdx >= 0 ? f[scIdx].Trim() : "(sin columna SwapChainAddress)");
            if (!groups.TryGetValue(key, out var list)) groups[key] = list = new List<double>();
            list.Add(ms);
        }

        if (groups.Count == 0)
            return FrameParseResult.Failure(
                $"Información insuficiente: no hay filas con intervalo válido ({invalid} descartadas). ¿El juego estaba en ejecución y presentando fotogramas durante la captura?");

        var dominant = groups.OrderByDescending(g => g.Value.Count).First();
        int other = groups.Values.Sum(v => v.Count) - dominant.Value.Count;

        var warnings = new List<string>();
        if (invalid > 0)
            warnings.Add($"Filas descartadas (valor no numérico, ≤ 0 o incompleto): {invalid}. La primera fila de cada swap chain suele valer 0.");
        if (groups.Count > 1)
            warnings.Add($"El archivo contiene {groups.Count} swap chains; se usó la de más filas ({dominant.Key.App}, {dominant.Key.Chain}, {dominant.Value.Count} filas) y se descartaron {other} filas de las demás.");

        return new FrameParseResult(
            new FrameRun(dominant.Key.App, dominant.Key.Chain, dominant.Value, invalid, other, source),
            null, warnings);
    }

    private static int IndexOf(List<string> cols, string name)
        => cols.FindIndex(c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase));

    private static List<string> SplitCsvLine(string line)
    {
        var fields = new List<string>();
        var sb = new StringBuilder();
        bool quoted = false;

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (quoted)
            {
                if (c == '"')
                {
                    if (i + 1 < line.Length && line[i + 1] == '"') { sb.Append('"'); i++; }
                    else quoted = false;
                }
                else sb.Append(c);
            }
            else if (c == '"') quoted = true;
            else if (c == ',') { fields.Add(sb.ToString()); sb.Clear(); }
            else sb.Append(c);
        }

        fields.Add(sb.ToString());
        return fields;
    }
}
