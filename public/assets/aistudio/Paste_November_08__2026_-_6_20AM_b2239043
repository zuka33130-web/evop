```csharp
using System.Globalization;
using EvoOptimizer.App.Mvvm;
using EvoOptimizer.Core.Benchmarking;

namespace EvoOptimizer.App.ViewModels;

public sealed record DirectionOption(MetricDirection Direction, string Label);

/// <summary>Laboratorio de comparación antes/después. Solo analiza datos escritos por el usuario.</summary>
public sealed class ComparisonLabViewModel : ObservableObject
{
    private string _metricName = "1% low (FPS)";
    private string _context = "";
    private string _beforeText = "";
    private string _afterText = "";
    private string _marginText = "3";
    private DirectionOption _selectedDirection;
    private bool _hasResult;
    private string _errorText = "";
    private string _verdictCode = "";
    private string _verdictLabel = "";
    private string _summary = "";
    private IReadOnlyList<string> _stats = Array.Empty<string>();
    private IReadOnlyList<string> _notes = Array.Empty<string>();

    public ComparisonLabViewModel()
    {
        Directions = new[]
        {
            new DirectionOption(MetricDirection.HigherIsBetter, "Mayor es mejor (FPS, 1% low)"),
            new DirectionOption(MetricDirection.LowerIsBetter, "Menor es mejor (frametime, latencia)")
        };
        _selectedDirection = Directions[0];
        CompareCommand = new RelayCommand(Compare);
    }

    public IReadOnlyList<DirectionOption> Directions { get; }
    public RelayCommand CompareCommand { get; }

    public string MetricName { get => _metricName; set => Set(ref _metricName, value); }
    public string Context { get => _context; set => Set(ref _context, value); }
    public string BeforeText { get => _beforeText; set => Set(ref _beforeText, value); }
    public string AfterText { get => _afterText; set => Set(ref _afterText, value); }
    public string MarginText { get => _marginText; set => Set(ref _marginText, value); }

    public DirectionOption SelectedDirection
    {
        get => _selectedDirection;
        set { if (value is not null) Set(ref _selectedDirection, value); }
    }

    public bool HasResult { get => _hasResult; private set => Set(ref _hasResult, value); }
    public string ErrorText { get => _errorText; private set => Set(ref _errorText, value); }
    public string VerdictCode { get => _verdictCode; private set => Set(ref _verdictCode, value); }
    public string VerdictLabel { get => _verdictLabel; private set => Set(ref _verdictLabel, value); }
    public string Summary { get => _summary; private set => Set(ref _summary, value); }
    public IReadOnlyList<string> Stats { get => _stats; private set => Set(ref _stats, value); }
    public IReadOnlyList<string> Notes { get => _notes; private set => Set(ref _notes, value); }

    private void Compare()
    {
        if (!RunListParser.TryParse(BeforeText, out var before, out var beforeError))
        {
            Fail($"Corridas «antes»: {beforeError}");
            return;
        }
        if (!RunListParser.TryParse(AfterText, out var after, out var afterError))
        {
            Fail($"Corridas «después»: {afterError}");
            return;
        }
        if (!double.TryParse((MarginText ?? "").Trim().Replace(',', '.'), NumberStyles.Float,
                CultureInfo.InvariantCulture, out double pct) || !(pct > 0 && pct <= 50))
        {
            Fail("El mínimo relevante debe ser un porcentaje mayor que 0 y no superior a 50 (por ejemplo 3).");
            return;
        }

        var options = ComparisonOptions.Default;
        var spec = new MetricSpec(
            string.IsNullOrWhiteSpace(MetricName) ? "Métrica" : MetricName.Trim(),
            SelectedDirection.Direction,
            pct / 100.0);

        var result = BenchmarkComparer.Compare(
            new MeasurementSeries(spec, Context, before),
            new MeasurementSeries(spec, Context, after),
            options);

        ErrorText = "";
        VerdictCode = result.Verdict.ToString();
        VerdictLabel = result.Verdict switch
        {
            BenchmarkVerdict.Improved => "MEJORA",
            BenchmarkVerdict.NoChange => "SIN CAMBIO",
            BenchmarkVerdict.Regressed => "EMPEORA",
            _ => "NO CONCLUYENTE"
        };
        Summary = result.Summary;
        Notes = result.Notes;
        Stats = BuildStats(result, options);
        HasResult = true;
    }

    private void Fail(string message)
    {
        ErrorText = message;
        HasResult = false;
    }

    private static IReadOnlyList<string> BuildStats(ComparisonResult r, ComparisonOptions o)
    {
        var lines = new List<string> { $"Corridas: {r.RunsBefore} antes · {r.RunsAfter} después" };

        if (r.MedianBefore is { } mb && r.MedianAfter is { } ma)
            lines.Add($"Mediana: {mb:G5} → {ma:G5}");
        if (r.RelativeChange is { } rc)
            lines.Add($"Cambio relativo (positivo = mejor): {BenchmarkFormat.Percent(rc)}");
        if (r.CiLow is { } lo && r.CiHigh is { } hi)
            lines.Add($"IC {1 - o.Alpha:P0} (bootstrap, {o.BootstrapResamples:N0} remuestreos): {BenchmarkFormat.Percent(lo)} a {BenchmarkFormat.Percent(hi)}");
        if (r.PValue is { } p)
            lines.Add($"Mann-Whitney U bilateral: {BenchmarkFormat.PValue(p)} ({(r.PValueIsExact == true ? "exacto" : "aprox. normal")})");
        if (r.ProbabilityOfImprovement is { } pi)
            lines.Add($"Prob. de que una corrida «después» supere a una «antes»: {pi:P0}");
        if (r.BaselineNoise is { } n)
            lines.Add($"Ruido de la línea base (MAD robusto / mediana): {BenchmarkFormat.Percent(n, false)}");

        return lines;
    }
}
