using EvoOptimizer.Core.Frames;
using Xunit;

namespace EvoOptimizer.Core.Tests;

public class FrameTimeAnalyzerTests
{
    private static FrameRun Run(IEnumerable<double> frames)
        => new("cs2.exe", "0x1", frames.ToList(), 0, 0, null);

    private static IEnumerable<double> Repeat(double ms, int count) => Enumerable.Repeat(ms, count);

    [Fact]
    public void Constant_frametimes_give_exact_metrics()
    {
        var s = FrameTimeAnalyzer.Analyze(Run(Repeat(5.0, 1000)));

        Assert.Equal(1000, s.ValidFrames);
        Assert.Equal(5.0, s.DurationSeconds, 9);
        Assert.Equal(200.0, s.AverageFps!.Value, 6);
        Assert.Equal(5.0, s.MedianFrameTimeMs!.Value, 9);
        Assert.Equal(5.0, s.P95FrameTimeMs!.Value, 9);
        Assert.Equal(5.0, s.P99FrameTimeMs!.Value, 9);
        Assert.Equal(200.0, s.OnePercentLowFps!.Value, 6);
        Assert.Null(s.PointOnePercentLowFps);          // 1000 < 9001 fotogramas
        Assert.Equal(0.0, s.RobustVariability!.Value, 9);
        Assert.Equal(0.0, s.MeanSuccessiveDifferenceMs!.Value, 9);
        Assert.Equal(0, s.SpikeCount);
    }

    [Fact]
    public void Average_fps_is_frames_over_total_time_not_mean_of_instantaneous_fps()
    {
        var s = FrameTimeAnalyzer.Analyze(Run(new[] { 5.0, 20.0 }));

        Assert.Equal(80.0, s.AverageFps!.Value, 9);   // 2 fotogramas / 25 ms; la media de FPS daría 125
    }

    [Fact]
    public void Tail_low_percentiles_and_spikes_are_computed_from_the_slowest_frames()
    {
        var s = FrameTimeAnalyzer.Analyze(Run(Repeat(5.0, 990).Concat(Repeat(25.0, 10))));

        Assert.Equal(40.0, s.OnePercentLowFps!.Value, 6);        // media de los 10 peores = 25 ms
        Assert.Equal(5.2, s.P99FrameTimeMs!.Value, 6);           // interpolación: 5 + 0,01 × (25 − 5)
        Assert.Equal(5.0, s.P95FrameTimeMs!.Value, 9);
        Assert.Equal(5.0, s.MedianFrameTimeMs!.Value, 9);
        Assert.Equal(10, s.SpikeCount);                          // > 2 × 5 ms
        Assert.Equal(0.01, s.SpikeFraction!.Value, 9);
        Assert.Equal(25.0, s.MaxFrameTimeMs!.Value, 9);
    }

    [Theory]
    [InlineData(900, false)]    // k = 9  < 10
    [InlineData(901, true)]     // k = 10
    public void One_percent_low_requires_at_least_ten_frames_in_the_tail(int frames, bool expected)
    {
        var s = FrameTimeAnalyzer.Analyze(Run(Repeat(5.0, frames)));

        Assert.Equal(expected, s.OnePercentLowFps is not null);
        Assert.Contains(s.Notes, n => n.Contains("1 % low") == !expected || expected);
    }

    [Fact]
    public void Point_one_percent_low_requires_at_least_nine_thousand_and_one_frames()
    {
        var tooFew = FrameTimeAnalyzer.Analyze(Run(Repeat(4.0, 9000)));
        Assert.Null(tooFew.PointOnePercentLowFps);
        Assert.Contains(tooFew.Notes, n => n.Contains("0,1 % low") && n.Contains("9001"));

        var enough = FrameTimeAnalyzer.Analyze(Run(Repeat(4.0, 8991).Concat(Repeat(40.0, 10))));
        Assert.Equal(9001, enough.ValidFrames);
        Assert.Equal(25.0, enough.PointOnePercentLowFps!.Value, 6);   // los 10 peores = 40 ms
    }

    [Fact]
    public void Pauses_are_excluded_counted_and_reported()
    {
        var frames = Repeat(5.0, 500).Concat(new[] { 1500.0 }).Concat(Repeat(5.0, 500));
        var s = FrameTimeAnalyzer.Analyze(Run(frames));

        Assert.Equal(1000, s.ValidFrames);
        Assert.Equal(1, s.PausedFrames);
        Assert.Equal(5.0, s.MaxFrameTimeMs!.Value, 9);
        Assert.Equal(0.0, s.MeanSuccessiveDifferenceMs!.Value, 9);   // no se mide diferencia a través de la pausa
        Assert.Contains(s.Notes, n => n.Contains("pausas"));
    }

    [Fact]
    public void Warmup_discards_frames_that_start_before_the_threshold()
    {
        var s = FrameTimeAnalyzer.Analyze(Run(Repeat(5.0, 1000)), new FrameAnalysisOptions(WarmupSeconds: 1));

        Assert.Equal(200, s.WarmupFramesSkipped);   // los fotogramas que empiezan en 0..995 ms
        Assert.Equal(800, s.ValidFrames);
    }

    [Fact]
    public void Alternating_frametimes_give_known_jitter_and_robust_variability()
    {
        var frames = Enumerable.Range(0, 1000).Select(i => i % 2 == 0 ? 4.0 : 6.0);
        var s = FrameTimeAnalyzer.Analyze(Run(frames));

        Assert.Equal(5.0, s.MedianFrameTimeMs!.Value, 9);
        Assert.Equal(2.0, s.MeanSuccessiveDifferenceMs!.Value, 9);
        Assert.Equal(1.4826 / 5.0, s.RobustVariability!.Value, 6);   // MAD = 1
        Assert.Equal(0, s.SpikeCount);
    }

    [Fact]
    public void Empty_run_reports_insufficient_information_instead_of_zeros()
    {
        var s = FrameTimeAnalyzer.Analyze(Run(Array.Empty<double>()));

        Assert.Equal(0, s.ValidFrames);
        Assert.Null(s.AverageFps);
        Assert.Null(s.OnePercentLowFps);
        Assert.Contains(s.Notes, n => n.Contains("Información insuficiente"));
    }

    [Theory]
    [InlineData(double.NaN)]
    [InlineData(0.0)]
    [InlineData(-1.0)]
    public void Invalid_intervals_are_rejected(double bad)
        => Assert.Throws<ArgumentException>(() => FrameTimeAnalyzer.Analyze(Run(new[] { 5.0, bad, 5.0 })));

    [Fact]
    public void Invalid_options_throw()
    {
        var run = Run(Repeat(5.0, 10));
        Assert.Throws<ArgumentException>(() => FrameTimeAnalyzer.Analyze(run, new FrameAnalysisOptions(PauseThresholdMs: 0)));
        Assert.Throws<ArgumentException>(() => FrameTimeAnalyzer.Analyze(run, new FrameAnalysisOptions(WarmupSeconds: -1)));
        Assert.Throws<ArgumentException>(() => FrameTimeAnalyzer.Analyze(run, new FrameAnalysisOptions(SpikeFactor: 1)));
        Assert.Throws<ArgumentException>(() => FrameTimeAnalyzer.Analyze(run, new FrameAnalysisOptions(MinTailFrames: 0)));
    }
}
