```csharp
using EvoOptimizer.Core.Benchmarking;
using EvoOptimizer.Core.Frames;
using Xunit;

namespace EvoOptimizer.Core.Tests;

public class FrameExperimentTests
{
    private const string Ctx = "CS2 · mapa benchmark · 1080p · 4 s";

    /// <summary>Corrida sintética: (frames − tail) × 4 ms y tail × tailMs. 1 % low = 1000 / tailMs si tail ≥ ⌈n/100⌉.</summary>
    private static LabeledRun Make(string id, RunGroup g, int seq, string ctx, int frames, int tail, double tailMs)
    {
        var list = new List<double>(frames);
        for (int i = 0; i < frames - tail; i++) list.Add(4.0);
        for (int i = 0; i < tail; i++) list.Add(tailMs);
        var stats = FrameTimeAnalyzer.Analyze(new FrameRun("cs2.exe", "0x1", list, 0, 0, null));
        return new LabeledRun(id, g, seq, ctx, stats);
    }

    private static readonly double[] SlowTail = { 8.0, 8.1, 7.9, 8.0, 8.2, 8.0, 8.1, 7.9 };   // ≈ 125 FPS
    private static readonly double[] FastTail = { 6.0, 6.1, 5.9, 6.0, 6.2, 6.0, 6.1, 5.9 };   // ≈ 167 FPS

    private static List<LabeledRun> Interleaved(double[] a, double[] b, int tail = 10, int aFrames = 1000, int bFrames = 1000, string ctx = Ctx)
    {
        var runs = new List<LabeledRun>();
        for (int i = 0; i < a.Length; i++)
        {
            runs.Add(Make($"A{i}", RunGroup.Baseline, 2 * i + 1, ctx, aFrames, tail, a[i]));
            runs.Add(Make($"B{i}", RunGroup.Candidate, 2 * i + 2, ctx, bFrames, tail, b[i]));
        }
        return runs;
    }

    [Fact]
    public void Clear_interleaved_improvement_is_supported_without_design_warnings()
    {
        var r = FrameExperiment.Evaluate(Interleaved(SlowTail, FastTail), FrameMetric.OnePercentLowFps, 0.03);

        Assert.Equal(BenchmarkVerdict.Improved, r.Comparison.Verdict);
        Assert.True(r.Comparison.RelativeChange > 0.3);
        Assert.True(r.Comparison.PValue < 0.001);
        Assert.Empty(r.DesignWarnings);
    }

    [Fact]
    public void Non_interleaved_design_is_flagged()
    {
        var runs = Interleaved(SlowTail, FastTail)
            .OrderBy(x => x.Group)
            .Select((x, i) => x with { Sequence = i + 1 })
            .ToList();

        var r = FrameExperiment.Evaluate(runs, FrameMetric.OnePercentLowFps, 0.03);

        Assert.Contains(r.DesignWarnings, w => w.Contains("no intercalado"));
    }

    [Fact]
    public void P99_frametime_is_lower_is_better()
    {
        // 200 de 1000 fotogramas en la cola → P99 = tailMs exacto.
        var r = FrameExperiment.Evaluate(Interleaved(SlowTail, FastTail, tail: 200), FrameMetric.P99FrameTimeMs, 0.03);

        Assert.Equal(BenchmarkVerdict.Improved, r.Comparison.Verdict);
        Assert.True(r.Comparison.RelativeChange > 0.2);   // 8 ms → 6 ms = +25 % (positivo = mejor)
    }

    [Fact]
    public void Different_contexts_inside_the_experiment_are_never_compared()
    {
        var runs = Interleaved(SlowTail, FastTail);
        runs[3] = runs[3] with { Context = "CS2 · otro mapa · 1080p · 4 s" };

        var r = FrameExperiment.Evaluate(runs, FrameMetric.OnePercentLowFps, 0.03);

        Assert.Equal(BenchmarkVerdict.Inconclusive, r.Comparison.Verdict);
        Assert.Equal(InconclusiveReason.ContextMismatch, r.Comparison.Reason);
    }

    [Fact]
    public void Empty_context_is_never_compared()
    {
        var runs = Interleaved(SlowTail, FastTail);
        runs[0] = runs[0] with { Context = "  " };

        var r = FrameExperiment.Evaluate(runs, FrameMetric.OnePercentLowFps, 0.03);

        Assert.Equal(InconclusiveReason.ContextMismatch, r.Comparison.Reason);
    }

    [Fact]
    public void Non_comparable_durations_are_blocked()
    {
        var r = FrameExperiment.Evaluate(
            Interleaved(SlowTail, FastTail, aFrames: 1000, bFrames: 2000), FrameMetric.OnePercentLowFps, 0.03);

        Assert.Equal(InconclusiveReason.ContextMismatch, r.Comparison.Reason);
        Assert.Contains("duración", r.Comparison.Summary);
    }

    [Fact]
    public void Metric_unavailable_in_any_run_is_blocked_not_silently_dropped()
    {
        // 1000 fotogramas no bastan para el 0,1 % low (necesita 9001).
        var r = FrameExperiment.Evaluate(Interleaved(SlowTail, FastTail), FrameMetric.PointOnePercentLowFps, 0.03);

        Assert.Equal(InconclusiveReason.InvalidData, r.Comparison.Reason);
        Assert.Contains("Información insuficiente", r.Comparison.Summary);
    }

    [Fact]
    public void Duplicate_sequence_numbers_are_rejected()
    {
        var runs = Interleaved(SlowTail, FastTail);
        runs[1] = runs[1] with { Sequence = runs[0].Sequence };

        var r = FrameExperiment.Evaluate(runs, FrameMetric.OnePercentLowFps, 0.03);

        Assert.Equal(InconclusiveReason.InvalidData, r.Comparison.Reason);
    }

    [Fact]
    public void Too_few_runs_never_conclude()
    {
        var runs = Interleaved(SlowTail.Take(3).ToArray(), FastTail.Take(3).ToArray());

        var r = FrameExperiment.Evaluate(runs, FrameMetric.OnePercentLowFps, 0.03);

        Assert.Equal(BenchmarkVerdict.Inconclusive, r.Comparison.Verdict);
        Assert.Equal(InconclusiveReason.InsufficientRuns, r.Comparison.Reason);
    }
}
