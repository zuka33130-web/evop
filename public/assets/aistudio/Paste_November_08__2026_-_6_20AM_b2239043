using EvoOptimizer.Core.Decisions;
using EvoOptimizer.Core.Hardware;
using EvoOptimizer.Core.Processes;
using EvoOptimizer.Core.Telemetry;

namespace EvoOptimizer.Core.Tests;

/// <summary>Generadores de ventanas sintéticas. Valores explícitos: nada aleatorio, nada inventado.</summary>
internal static class TestData
{
    public const double Gib = 1024.0 * 1024 * 1024;

    public static ulong Bytes(double gib) => (ulong)(gib * Gib);

    /// <summary>Límite de commit = 2 × RAM (RAM + archivo de paginación equivalente).</summary>
    public static TelemetrySnapshot Snapshot(double totalGib, double availGib, double? pagesPerSec, double commitRatio = 0.4)
    {
        ulong total = Bytes(totalGib);
        ulong avail = Bytes(availGib);
        ulong limit = total * 2;
        ulong used = (ulong)(limit * commitRatio);

        return new TelemetrySnapshot(
            DateTimeOffset.UnixEpoch,
            CpuUtilizationPercent: 10,
            MemoryLoadPercent: (1.0 - availGib / totalGib) * 100.0,
            MemoryTotalBytes: total,
            MemoryAvailableBytes: avail,
            CommitUsedBytes: used,
            CommitLimitBytes: limit,
            HardPageInputPerSec: pagesPerSec);
    }

    public static List<TelemetrySnapshot> Window(int count, double totalGib, double availGib, double? pagesPerSec, double commitRatio = 0.4)
        => Enumerable.Repeat(Snapshot(totalGib, availGib, pagesPerSec, commitRatio), count).ToList();

    public static List<TelemetrySnapshot> PagingWindow(double totalGib, double availGib, IEnumerable<double?> paging, double commitRatio = 0.4)
        => paging.Select(p => Snapshot(totalGib, availGib, p, commitRatio)).ToList();

    public static HardwareProfile Hardware(double totalGib)
        => new("Windows (test)", "CPU de prueba", 8, 3000, Bytes(totalGib), Array.Empty<GpuInfo>());

    public static DecisionContext Context(
        IReadOnlyList<TelemetrySnapshot> window, double totalGib, OptimizationGoal goal,
        IReadOnlyList<ProcessMemoryUsage>? consumers = null)
        => new(Hardware(totalGib), window, goal, consumers);
}
