using EvoOptimizer.Core.Benchmarking;
using Xunit;

namespace EvoOptimizer.Core.Tests;

public class MannWhitneyTests
{
    private static double[] Range(int start, int count) => Enumerable.Range(start, count).Select(i => (double)i).ToArray();

    [Theory]
    [InlineData(3, 2.0 / 20)]    // 2 / C(6,3)
    [InlineData(4, 2.0 / 70)]    // 2 / C(8,4)
    [InlineData(5, 2.0 / 252)]   // 2 / C(10,5)
    public void Complete_separation_gives_exact_two_sided_p(int n, double expected)
    {
        var r = MannWhitneyTest.TwoSided(Range(1, n), Range(n + 1, n));

        Assert.True(r.IsExact);
        Assert.Equal(expected, r.PValue, 10);
        Assert.Equal(0.0, r.UStatisticFirst);
    }

    [Fact]
    public void Ties_are_handled_exactly()
    {
        // a = {1, 2}, b = {2, 3}: 6 subconjuntos de rangos doblados {2, 5, 5, 8}; 4 son tan extremos como el observado.
        var r = MannWhitneyTest.TwoSided(new[] { 1.0, 2.0 }, new[] { 2.0, 3.0 });

        Assert.Equal(0.5, r.UStatisticFirst);
        Assert.Equal(4.0 / 6.0, r.PValue, 12);
        Assert.True(r.IsExact);
    }

    [Fact]
    public void Swapping_groups_keeps_p_and_mirrors_u()
    {
        var a = new[] { 1.2, 3.4, 2.2, 5.5, 4.1 };
        var b = new[] { 2.9, 6.1, 3.3, 7.7 };

        var ab = MannWhitneyTest.TwoSided(a, b);
        var ba = MannWhitneyTest.TwoSided(b, a);

        Assert.Equal(6.0, ab.UStatisticFirst);
        Assert.Equal(14.0, ba.UStatisticFirst);
        Assert.Equal(a.Length * b.Length, ab.UStatisticFirst + ba.UStatisticFirst);
        Assert.Equal(ab.PValue, ba.PValue, 12);
    }

    [Fact]
    public void Identical_values_give_p_of_one()
    {
        var r = MannWhitneyTest.TwoSided(new[] { 5.0, 5.0, 5.0, 5.0 }, new[] { 5.0, 5.0, 5.0, 5.0 });
        Assert.Equal(1.0, r.PValue, 12);
    }

    [Fact]
    public void Large_samples_use_normal_approximation()
    {
        var r = MannWhitneyTest.TwoSided(Range(1, 30), Range(31, 30));

        Assert.False(r.IsExact);
        Assert.InRange(r.PValue, 0.0, 1e-6);
    }

    [Fact]
    public void Large_identical_samples_give_p_of_one()
    {
        var same = Enumerable.Repeat(7.0, 30).ToArray();
        var r = MannWhitneyTest.TwoSided(same, same);

        Assert.False(r.IsExact);
        Assert.InRange(r.PValue, 0.999, 1.0);
    }

