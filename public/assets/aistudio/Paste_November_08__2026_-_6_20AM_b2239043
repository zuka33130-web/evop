using System.ComponentModel;
using System.Diagnostics;
using EvoOptimizer.Core.Processes;

namespace EvoOptimizer.Infrastructure.Processes;

/// <summary>
/// Enumera procesos con System.Diagnostics.Process (sin elevación) y agrupa por nombre.
/// Limitaciones: los procesos que terminan durante la enumeración se omiten; el nombre es el del
/// ejecutable, sin distinguir rutas ni usuarios.
/// </summary>
public sealed class WindowsProcessMemoryProvider : IProcessMemoryProvider
{
    public IReadOnlyList<ProcessMemoryUsage> GetTopByPrivateBytes(int count)
    {
        var groups = new Dictionary<string, (int Instances, ulong Private, ulong WorkingSet)>(StringComparer.OrdinalIgnoreCase);

        foreach (var p in Process.GetProcesses())
        {
            using (p)
            {
                try
                {
                    if (p.Id == 0) continue; // proceso Idle
                    string name = p.ProcessName;
                    ulong priv = (ulong)Math.Max(0, p.PrivateMemorySize64);
                    ulong ws = (ulong)Math.Max(0, p.WorkingSet64);

                    groups.TryGetValue(name, out var g);
                    groups[name] = (g.Instances + 1, g.Private + priv, g.WorkingSet + ws);
                }
                catch (Exception ex) when (ex is InvalidOperationException or Win32Exception or NotSupportedException)
                {
                    // proceso finalizado o inaccesible durante la lectura
                }
            }
        }

        return groups
            .OrderByDescending(kv => kv.Value.Private)
            .Take(Math.Max(0, count))
            .Select(kv => new ProcessMemoryUsage(kv.Key, kv.Value.Instances, kv.Value.Private, kv.Value.WorkingSet))
            .ToList();
    }
}
