using System.Globalization;
using EvoOptimizer.Core.Memory;
using EvoOptimizer.Core.Processes;

namespace EvoOptimizer.Core.Decisions;

/// <summary>
/// Fase 2: solo reglas de memoria. Sin estado, sin efectos secundarios; nunca modifica el sistema.
/// Confianza = cobertura de evidencia (muestras y señales disponibles), NO una probabilidad estadística.
/// </summary>
public sealed class AdaptiveDecisionEngine : IDecisionEngine
{
    private const double MaxConfidence = 0.85;
    private const double Gib = 1024.0 * 1024 * 1024;
    private const double Mib = 1024.0 * 1024;

    public DecisionReport Evaluate(DecisionContext context)
    {
        var findings = new List<Finding>();
        var recs = new List<Recommendation>();

        var memory = MemoryAnalyzer.Analyze(context.RecentTelemetry, context.Hardware.TotalMemoryBytes);
        EvaluateMemory(memory, context, findings, recs);

        return new DecisionReport(findings, recs);
    }

    private static void EvaluateMemory(MemoryAssessment a, DecisionContext ctx, List<Finding> findings, List<Recommendation> recs)
    {
        double med = a.MedianAvailableBytes ?? 0;
        double total = a.TotalBytes ?? 0;
        double thr = a.LowAvailableThresholdBytes ?? 0;
        var evidence = MemoryEvidence(a);

        string gamingNote = ctx.Goal == OptimizationGoal.Gaming
            ? " Para gaming, el efecto en frametime/1% lows no puede confirmarse sin captura de frametime (pendiente)."
            : "";
        string pagingNote = a.PagingSustained is null
            ? " El contador de paginación no tiene datos suficientes, por lo que la confianza es menor."
            : "";

        switch (a.State)
        {
            case MemoryState.InsufficientData:
                findings.Add(new Finding("memory.insufficient-data", "Memoria: recopilando datos", Severity.Info, 0,
                    $"Evaluar presión de memoria exige una ventana sostenida (mínimo {MemoryAnalyzer.MinSamples} muestras; hay {a.SampleCount}). Un valor puntual no basta para concluir nada.",
                    evidence, "Sin conclusiones hasta completar la ventana."));
                break;

            case MemoryState.Healthy:
            {
                double conf = Confidence(a, needsPaging: true);
                findings.Add(new Finding("memory.healthy", "Memoria: sin presión detectada", Severity.Info, conf,
                    $"La mediana de memoria disponible ({Size(med)}) supera el umbral de este equipo ({Size(thr)}), sin paginación sostenida ni commit cercano al límite.",
                    evidence,
                    $"Ventana de {a.SampleCount} s: no detecta picos breves ni presión en otros momentos de uso. Una carga alta de RAM no es un problema por sí misma: Windows usa la memoria libre como caché.{pagingNote}"));
                recs.Add(new Recommendation("memory.no-action", "No intervenir en memoria",
                    $"Con {Size(total)} instalados y {Size(med)} disponibles de mediana, no hay evidencia de que liberar memoria mejore algo. Vaciar la caché de espera o 'limpiar RAM' puede empeorar los tiempos de carga al forzar relecturas de disco.",
                    conf, RiskLevel.None,
                    "Ninguno medible; evita cambios sin evidencia.",
                    "No aplica: no se modifica el sistema.",
                    "No hay intervención cuya causalidad evaluar."));
                break;
            }

            case MemoryState.PagingWithoutShortage:
                findings.Add(new Finding("memory.paging-no-shortage", "Lecturas de paginación sostenidas sin escasez de memoria", Severity.Info,
                    Confidence(a, needsPaging: false),
                    $"Hay lecturas continuas por fallos de página duros ({a.MedianPagesInputPerSec:F0} págs/s de mediana) pero la memoria disponible ({Size(med)}) está sobre el umbral ({Size(thr)}). Con RAM suficiente suele corresponder a lectura de archivos mapeados o carga de aplicaciones, no a falta de RAM.",
                    evidence,
                    "El contador no distingue el origen de las lecturas. Sin atribución por proceso no se puede concluir causa; no se propone ninguna acción."));
                break;

            case MemoryState.ReducedHeadroom:
            {
                double conf = Confidence(a, needsPaging: true);
                findings.Add(new Finding("memory.reduced-headroom", "Memoria: margen reducido sin paginación sostenida", Severity.Warning, conf,
                    $"La mediana de memoria disponible ({Size(med)}) está bajo el umbral de este equipo ({Size(thr)}), pero no hay lecturas de paginación sostenidas. Queda poco margen, aunque no hay evidencia de que falte RAM para la carga actual.",
                    evidence,
                    $"Poca memoria disponible sin paginación no confirma escasez: la carga puede ser estable.{pagingNote}"));
                recs.Add(new Recommendation("memory.observe", "Observar antes de actuar",
                    "Sin paginación sostenida no hay síntoma medible que justifique intervenir. EVO reevalúa de forma continua y escalará si aparece paginación.",
                    conf, RiskLevel.None,
                    "Evita intervenir sin evidencia de impacto.",
                    "No aplica: no se modifica el sistema.",
                    "Margen bajo y rendimiento percibido pueden no estar relacionados."));
                break;
            }

            case MemoryState.CommitNearLimit:
            {
                double conf = Confidence(a, needsPaging: false);
                findings.Add(new Finding("memory.commit-near-limit", "Memoria: commit cercano al límite", Severity.Warning, conf,
                    $"El commit (mediana {a.MedianCommitRatio:P0}, máximo {a.MaxCommitRatio:P0}) se acerca al límite del sistema (RAM + archivo de paginación). Si se agota, las asignaciones de memoria pueden fallar.",
                    evidence,
                    "EVO aún no lee la configuración del archivo de paginación: el límite puede crecer si Windows lo gestiona automáticamente. El commit refleja reservas, no uso real de memoria física."));
                recs.Add(new Recommendation("memory.check-pagefile", "Comprobar la configuración del archivo de paginación",
                    "Un commit alto con límite fijo o pequeño puede provocar fallos de asignación. Conviene verificar si el archivo de paginación está en gestión automática y si el límite es coherente con la RAM instalada.",
                    conf, RiskLevel.Low,
                    "Evitar fallos de asignación; efecto no garantizado.",
                    "En esta fase EVO no cambia nada. Cualquier cambio futuro guardará la configuración previa en el change journal antes de aplicarse y se restaurará desde ahí.",
                    "Un commit alto indica memoria reservada, no necesariamente en uso; puede no haber síntoma real."));
                break;
            }

            case MemoryState.Pressure:
            {
                bool commitHigh = a.CommitHigh == true;
                double conf = Confidence(a, needsPaging: false);
                string commitNote = commitHigh ? " Además, el commit está cerca de su límite." : "";
                findings.Add(new Finding("memory.pressure", "Memoria: presión sostenida (poca memoria disponible y lecturas de paginación)",
                    commitHigh ? Severity.Critical : Severity.Warning, conf,
                    $"La mediana de memoria disponible ({Size(med)}) está bajo el umbral de este equipo ({Size(thr)}) y hay lecturas continuas por fallos de página duros ({a.MedianPagesInputPerSec:F0} págs/s de mediana): Windows recupera páginas desde disco. Es el patrón compatible con falta de RAM para la carga actual.{commitNote}",
                    evidence,
                    "Pages Input/sec también incluye lecturas de archivos mapeados; se mitiga exigiendo mediana sostenida, pero no se puede atribuir a un proceso concreto. Umbrales heurísticos sin calibrar. Impacto en latencia o frametime no medido."));

                string consumers = DescribeConsumers(ctx.TopMemoryConsumers);
                recs.Add(new Recommendation("memory.review-consumers", "Revisar los mayores consumidores de memoria",
                    $"Mayores consumidores de memoria privada: {consumers}. {CapacityNote(a.TotalBytes)}",
                    conf, RiskLevel.None,
                    "Reducir la presión si la memoria liberada baja la tasa de lecturas de paginación; verificable comparando antes y después.",
                    "No se modifica nada: cerrar aplicaciones es decisión del usuario y se revierte reabriéndolas.",
                    "El mayor consumidor no es necesariamente la causa de la paginación; no hay correlación demostrada por proceso." + gamingNote));
                break;
            }
        }
    }

    private static List<Evidence> MemoryEvidence(MemoryAssessment a)
    {
        var list = new List<Evidence>();

        if (a.MedianAvailableBytes is { } med && a.TotalBytes is { } total && total > 0 && a.LowAvailableThresholdBytes is { } thr)
            list.Add(new Evidence("Memoria disponible (mediana de la ventana)",
                $"{Size(med)} de {Size(total)} ({med / total:P0}). Umbral de 'baja' para este equipo: {Size(thr)}",
                $"GlobalMemoryStatusEx · {a.SampleCount} muestras"));

        if (a.MedianCommitRatio is { } mc && a.MaxCommitRatio is { } xc)
            list.Add(new Evidence("Commit (mediana / máximo)",
                $"{mc:P0} / {xc:P0} del límite (umbral de alerta {MemoryAnalyzer.CommitHighRatio:P0})",
                "GlobalMemoryStatusEx"));

        if (a.MedianPagesInputPerSec is { } mp && a.P95PagesInputPerSec is { } p95)
            list.Add(new Evidence("Lecturas por fallos duros (mediana / p95)",
                $"{mp:F0} / {p95:F0} págs/s (umbral sostenido {MemoryAnalyzer.PagingSustainedPagesPerSec:F0})",
                $@"PDH \Memory\Pages Input/sec · {a.PagingSampleCount} muestras"));
        else if (a.State != MemoryState.InsufficientData)
            list.Add(new Evidence("Lecturas por fallos duros",
                $"No disponible: {a.PagingSampleCount} muestras válidas (mínimo {MemoryAnalyzer.MinSamples})",
                "PDH"));

        return list;
    }

    private static double Confidence(MemoryAssessment a, bool needsPaging)
    {
        double sample = Math.Min(1.0, a.SampleCount / 60.0);
        double signals = needsPaging && a.PagingSustained is null ? 0.7 : 1.0;
        return Math.Round(MaxConfidence * sample * signals, 2);
    }

    private static string CapacityNote(ulong? totalBytes)
    {
        if (totalBytes is not { } t || t == 0) return "No se pudo determinar la RAM instalada.";
        double gib = t / Gib;
        if (gib <= 12)
            return $"Con {Size(t)} instalados el margen es estrecho para cargas actuales; más RAM sería la medida de mayor efecto potencial, aunque EVO no puede lograrlo por software.";
        if (gib >= 28)
            return $"Con {Size(t)} instalados la presión sostenida es poco habitual: conviene sospechar de un proceso con consumo anómalo (hipótesis, no verificada).";
        return $"Con {Size(t)} instalados, la presión sostenida indica una carga inusualmente alta para esta capacidad; revisar consumidores antes de considerar otras medidas.";
    }

    private static string DescribeConsumers(IReadOnlyList<ProcessMemoryUsage>? top)
    {
        if (top is null || top.Count == 0) return "sin datos de procesos";
        return string.Join(", ", top.Take(3).Select(DescribeProcess));
    }

    private static string DescribeProcess(ProcessMemoryUsage p)
    {
        string instances = p.InstanceCount > 1 ? " ×" + p.InstanceCount.ToString(CultureInfo.InvariantCulture) : "";
        return p.Name + instances + " (" + Size(p.PrivateBytes) + ")";
    }

    private static string Size(double bytes)
        => bytes >= Gib
            ? (bytes / Gib).ToString("F1", CultureInfo.CurrentCulture) + " GB"
            : (bytes / Mib).ToString("F0", CultureInfo.CurrentCulture) + " MB";
}
