using System.ComponentModel;
using System.Diagnostics;
using System.Runtime.Versioning;
using System.Security.Principal;
using System.Text;
using System.Text.RegularExpressions;
using EvoOptimizer.Core.Frames;

namespace EvoOptimizer.Infrastructure.PresentMon;

/// <summary>
/// Captura con PresentMon como proceso externo (sesión ETW de solo lectura) y lee su CSV.
/// - No modifica nada del sistema salvo crear la sesión ETW (con nombre único) y un CSV en el directorio indicado.
/// - Si falla algo (permisos, juego no iniciado, timeout, código de salida ≠ 0) devuelve un error: nunca datos parciales ni simulados.
/// - Requiere administrador o pertenecer a «Performance Log Users».
/// - Las opciones de línea de comandos dependen de la versión de PresentMon: 2.x usa «--opción», 1.x «-opción».
///   Verifícalas con «PresentMon --help». Si tu versión rechaza alguna, el error de PresentMon se muestra tal cual.
/// - Si hay que abortar PresentMon (timeout/cancelación) la sesión ETW puede quedar activa: el mensaje indica cómo cerrarla.
/// </summary>
[SupportedOSPlatform("windows")]
public sealed class PresentMonCapture : IFrameCaptureSource
{
    private static readonly TimeSpan StartupMargin = TimeSpan.FromSeconds(30);
    private static readonly Regex SafeName = new(@"^[A-Za-z0-9_.\-]+$", RegexOptions.Compiled);

    private readonly string _executablePath;
    private readonly string _outputDirectory;
    private readonly bool _legacyFlags;

    public PresentMonCapture(string executablePath, string outputDirectory, bool legacyFlags = false)
    {
        _executablePath = executablePath ?? throw new ArgumentNullException(nameof(executablePath));
        _outputDirectory = outputDirectory ?? throw new ArgumentNullException(nameof(outputDirectory));
        _legacyFlags = legacyFlags;
    }

    public async Task<FrameParseResult> CaptureAsync(FrameCaptureRequest request, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(request);

        string baseName = (request.ProcessName ?? "").Trim();
        if (baseName.EndsWith(".exe", StringComparison.OrdinalIgnoreCase)) baseName = baseName[..^4];
        if (baseName.Length == 0 || !SafeName.IsMatch(baseName))
            return FrameParseResult.Failure("Nombre de proceso no válido (solo letras, números, '_', '-' y '.').");
        if (request.Duration < TimeSpan.FromSeconds(10) || request.Duration > TimeSpan.FromMinutes(10))
            return FrameParseResult.Failure("La duración debe estar entre 10 s y 600 s.");
        if (!File.Exists(_executablePath))
            return FrameParseResult.Failure($"No se encontró PresentMon en «{_executablePath}».");
        if (!CanStartEtwSession())
            return FrameParseResult.Failure("PresentMon necesita permisos de ETW: ejecuta EVO como administrador o añade tu usuario al grupo «Performance Log Users» (requiere cerrar sesión).");

        var running = Process.GetProcessesByName(baseName);
        bool isRunning = running.Length > 0;
        foreach (var p in running) p.Dispose();
        if (!isRunning)
            return FrameParseResult.Failure($"«{baseName}.exe» no está en ejecución. Inicia el juego y la escena de prueba antes de capturar; EVO no genera datos sin proceso.");

        try { Directory.CreateDirectory(_outputDirectory); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            return FrameParseResult.Failure($"No se pudo crear el directorio de salida: {ex.Message}");
        }

        string id = Guid.NewGuid().ToString("N")[..8];
        string csv = Path.Combine(_outputDirectory, $"evo_{DateTime.Now:yyyyMMdd_HHmmss}_{id}.csv");
        string session = "EVO_" + id;
        string seconds = ((int)Math.Ceiling(request.Duration.TotalSeconds)).ToString(System.Globalization.CultureInfo.InvariantCulture);

        var psi = new ProcessStartInfo
        {
            FileName = _executablePath,
            UseShellExecute = false,
            CreateNoWindow = true,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            WorkingDirectory = _outputDirectory
        };

        string dash = _legacyFlags ? "-" : "--";
        psi.ArgumentList.Add(dash + "process_name"); psi.ArgumentList.Add(baseName + ".exe");
        psi.ArgumentList.Add(dash + "output_file"); psi.ArgumentList.Add(csv);
        psi.ArgumentList.Add(dash + "session_name"); psi.ArgumentList.Add(session);
        psi.ArgumentList.Add(dash + "timed"); psi.ArgumentList.Add(seconds);
        psi.ArgumentList.Add(dash + "terminate_after_timed");
        psi.ArgumentList.Add(_legacyFlags ? "-no_top" : "--no_console_stats");

        var log = new StringBuilder();
        void Append(string? line)
        {
            if (line is null) return;
            lock (log) { if (log.Length < 6000) log.AppendLine(line); }
        }

        using var proc = new Process { StartInfo = psi };
        proc.OutputDataReceived += (_, e) => Append(e.Data);
        proc.ErrorDataReceived += (_, e) => Append(e.Data);

        try
        {
            if (!proc.Start()) return FrameParseResult.Failure("No se pudo iniciar PresentMon.");
        }
        catch (Exception ex) when (ex is Win32Exception or InvalidOperationException)
        {
            return FrameParseResult.Failure($"No se pudo iniciar PresentMon: {ex.Message}");
        }

        proc.BeginOutputReadLine();
        proc.BeginErrorReadLine();

        using var linked = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        linked.CancelAfter(request.Duration + StartupMargin);

        try
        {
            await proc.WaitForExitAsync(linked.Token).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            TryKill(proc);
            string cleanup = $" Si la sesión ETW quedó activa, ciérrala con: logman stop {session} -ets";
            return FrameParseResult.Failure(cancellationToken.IsCancellationRequested
                ? "Captura cancelada. No se usan datos parciales." + cleanup
                : "PresentMon no terminó en el tiempo previsto y se abortó. No se usan datos parciales." + cleanup);
        }

        proc.WaitForExit(); // vacía los flujos redirigidos

        if (proc.ExitCode != 0)
            return FrameParseResult.Failure($"PresentMon terminó con código {proc.ExitCode}. Salida:\n{log}".TrimEnd());

        if (!File.Exists(csv))
            return FrameParseResult.Failure("PresentMon terminó sin generar el CSV. Salida:\n" + log);

        return PresentMonCsvParser.ParseFile(csv);
    }

    private static bool CanStartEtwSession()
    {
        using var identity = WindowsIdentity.GetCurrent();
        var principal = new WindowsPrincipal(identity);
        return principal.IsInRole(WindowsBuiltInRole.Administrator)
            || principal.IsInRole(new SecurityIdentifier("S-1-5-32-559")); // Performance Log Users
    }

    private static void TryKill(Process p)
    {
        try { if (!p.HasExited) p.Kill(entireProcessTree: true); }
        catch (Exception ex) when (ex is InvalidOperationException or Win32Exception) { }
    }
}
