namespace EvoOptimizer.App.ViewModels;

public sealed record GoalOption(OptimizationGoal Goal, string Label, string Description);
public sealed record SensorStatus(string Name, string Source, bool IsActive);
public sealed record ScoreDimensionView(string Name, string ValueText, string Basis);
public sealed record ConsumerView(string Name, string Detail);

public sealed class DashboardViewModel : ObservableObject, IDisposable
{
    private const int HistoryLength = 120;

    private readonly ITelemetryProvider _telemetry;
    private readonly IDecisionEngine? _decisionEngine;
    private readonly IProcessMemoryProvider? _processes;
    private readonly DispatcherTimer _timer;
    private readonly List<TelemetrySnapshot> _window = new(HistoryLength);
    private readonly List<double> _cpuSeries = new(HistoryLength);
    private readonly List<double> _memSeries = new(HistoryLength);
    private readonly List<double> _pagingSeries = new(HistoryLength);
    private readonly RunningStats _cpuStats = new();
    private readonly RunningStats _memStats = new();
    private readonly DateTimeOffset _sessionStart = DateTimeOffset.Now;
    private IReadOnlyList<ProcessMemoryUsage> _topConsumersRaw = Array.Empty<ProcessMemoryUsage>();
    private bool _processBusy;
    private bool _pagingSeen;
    private int _ticks;

    private GoalOption _selectedGoal;
    private IReadOnlyList<SensorStatus> _sensors = Array.Empty<SensorStatus>();
    private IReadOnlyList<ConsumerView> _topConsumers = Array.Empty<ConsumerView>();
    private string _consumersStatus = "Sin datos todavía";
    private string _cpuText = "N/D";
    private string _memoryText = "N/D";
    private string _memoryDetail = "";
    private string _commitDetail = "";
    private string _pagingText = "N/D";
    private string _pagingScaleText = "Sin muestras";
    private double _pagingScale = 200;
    private double[] _cpuHistory = Array.Empty<double>();
    private double[] _memoryHistory = Array.Empty<double>();
    private double[] _pagingHistory = Array.Empty<double>();
    private string _cpuStatsText = "Sin muestras";
    private string _memStatsText = "Sin muestras";
    private string _sessionText = "";
    private string _statusText = "Iniciando telemetría…";

    /// <param name="decisionEngine">Motor de decisión; null = no conectado.</param>
    /// <param name="processes">Proveedor de consumidores de memoria; null = no conectado.</param>
    public DashboardViewModel(ITelemetryProvider telemetry, HardwareProfile hardware,
        IDecisionEngine? decisionEngine = null, IProcessMemoryProvider? processes = null)
    {
        _telemetry = telemetry;
        _decisionEngine = decisionEngine;
        _processes = processes;
        Hardware = hardware;

        Goals = new[]
        {
            new GoalOption(OptimizationGoal.Everyday, "Uso cotidiano",
                "Prioriza estabilidad, respuesta del sistema y bajo consumo. Sin ajustes agresivos."),
            new GoalOption(OptimizationGoal.Gaming, "Gaming",
                "Prioriza estabilidad de frametime (1% lows) y latencia. Validarlo requiere captura de frametime (aún no disponible)."),
            new GoalOption(OptimizationGoal.MaximumPerformance, "Máximo rendimiento",
                "Prioriza rendimiento sostenido admitiendo más consumo y temperatura, siempre dentro de límites térmicos seguros.")
        };
        _selectedGoal = Goals[0];

        GpuLines = hardware.Gpus.Count == 0
            ? new[] { "No detectada" }
            : hardware.Gpus.Select(g => g.DedicatedMemoryBytes is { } b
                ? $"{g.Name} · {FormatGb(b)} (reportado por driver)"
                : g.Name).ToArray();

        RamText = hardware.TotalMemoryBytes is { } r ? FormatGb(r) : "No disponible";
        CpuNominalText = hardware.CpuNominalMhz is { } mhz ? $"{mhz / 1000.0:F2} GHz nominal" : "No disponible";

        _sensors = BuildSensors();

        Score = new[]
        {
            Unmeasured(ScoreDimension.Stability, "Estabilidad", "Requiere captura de frametime (1% lows, varianza)."),
            Unmeasured(ScoreDimension.Performance, "Rendimiento", "Requiere FPS o un benchmark reproducible."),
            Unmeasured(ScoreDimension.Efficiency, "Eficiencia", "Requiere consumo y utilización por componente."),
            Unmeasured(ScoreDimension.Health, "Salud", "Requiere temperaturas, throttling y registro de errores."),
        };

        _telemetry.Sample(); // cebar los deltas de CPU y PDH
        _timer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(1) };
        _timer.Tick += OnTick;
        _timer.Start();
    }

    public HardwareProfile Hardware { get; }
    public string RamText { get; }
    public string CpuNominalText { get; }
    public IReadOnlyList<string> GpuLines { get; }
    public IReadOnlyList<GoalOption> Goals { get; }
    public IReadOnlyList<ScoreDimensionView> Score { get; }

    public ObservableCollection<Finding> Findings { get; } = new();
    public ObservableCollection<Recommendation> Recommendations { get; } = new();

    public IReadOnlyList<SensorStatus> Sensors { get => _sensors; private set => Set(ref _sensors, value); }
    public IReadOnlyList<ConsumerView> TopConsumers { get => _topConsumers; private set => Set(ref _topConsumers, value); }
    public string ConsumersStatus { get => _consumersStatus; private set => Set(ref _consumersStatus, value); }

    public GoalOption SelectedGoal
    {
        get => _selectedGoal;
        set
        {
            if (value is not null && Set(ref _selectedGoal, value))
            {
                Raise(nameof(SelectedGoalDescription));
                RunDecisionEngine(); // el objetivo cambia el contexto: reevaluar de inmediato
            }
        }
    }
    public string SelectedGoalDescription => _selectedGoal.Description;

    public string CpuText { get => _cpuText; private set => Set(ref _cpuText, value); }
    public string MemoryText { get => _memoryText; private set => Set(ref _memoryText, value); }
    public string MemoryDetail { get => _memoryDetail; private set => Set(ref _memoryDetail, value); }
    public string CommitDetail { get => _commitDetail; private set => Set(ref _commitDetail, value); }
    public string PagingText { get => _pagingText; private set => Set(ref _pagingText, value); }
    public string PagingScaleText { get => _pagingScaleText; private set => Set(ref _pagingScaleText, value); }
    public double PagingScale { get => _pagingScale; private set => Set(ref _pagingScale, value); }
    public double[] CpuHistory { get => _cpuHistory; private set => Set(ref _cpuHistory, value); }
    public double[] MemoryHistory { get => _memoryHistory; private set => Set(ref _memoryHistory, value); }
    public double[] PagingHistory { get => _pagingHistory; private set => Set(ref _pagingHistory, value); }
    public string CpuStatsText { get => _cpuStatsText; private set => Set(ref _cpuStatsText, value); }
    public string MemStatsText { get => _memStatsText; private set => Set(ref _memStatsText, value); }
    public string SessionText { get => _sessionText; private set => Set(ref _sessionText, value); }
    public string StatusText { get => _statusText; private set => Set(ref _statusText, value); }

    private IReadOnlyList<SensorStatus> BuildSensors()
    {
        string pagingSource = _pagingSeen
            ? @"PDH \Memory\Pages Input/sec"
            : _ticks < 5 ? "PDH · iniciando…" : "PDH · sin datos (contador no disponible)";

        return new[]
        {
            new SensorStatus("Utilización global de CPU", "GetSystemTimes (kernel32)", true),
            new SensorStatus("Memoria física y commit", "GlobalMemoryStatusEx", true),
            new SensorStatus("Lecturas de paginación (fallos duros)", pagingSource, _pagingSeen),
            new SensorStatus("Mayores consumidores de memoria",
                _processes is null ? "No conectado" : "System.Diagnostics.Process · cada 5 s", _processes is not null),
            new SensorStatus("Perfil de hardware", "Registro de Windows", true),
            new SensorStatus("Utilización por hilo / afinidad", "Pendiente", false),
            new SensorStatus("GPU (uso, VRAM)", "Pendiente", false),
            new SensorStatus("Temperaturas / throttling", "Pendiente (requiere driver de sensores)", false),
            new SensorStatus("Disco (latencia, cola)", "Pendiente", false),
            new SensorStatus("Frametime", "Pendiente (ETW)", false),
        };
    }

    private void OnTick(object? sender, EventArgs e)
    {
        _ticks++;
        var s = _telemetry.Sample();

        _window.Add(s);
        if (_window.Count > HistoryLength) _window.RemoveAt(0);

        if (s.CpuUtilizationPercent is { } cpu)
        {
            Push(_cpuSeries, cpu);
            _cpuStats.Add(cpu);
            CpuText = $"{cpu:F0} %";
            CpuHistory = _cpuSeries.ToArray();
            CpuStatsText = _cpuStats.Describe("%");
        }
        else CpuText = "N/D";

        if (s.MemoryLoadPercent is { } mem)
        {
            Push(_memSeries, mem);
            _memStats.Add(mem);
            MemoryText = $"{mem:F0} %";
            MemoryHistory = _memSeries.ToArray();
            MemStatsText = _memStats.Describe("%");
        }
        else MemoryText = "N/D";

        if (s.HardPageInputPerSec is { } pg)
        {
            Push(_pagingSeries, pg);
            PagingText = $"{pg:F0} pág/s";
            PagingHistory = _pagingSeries.ToArray();
            PagingScale = Math.Max(200, Math.Ceiling(_pagingSeries.Max() * 1.1 / 100) * 100);
            PagingScaleText = $"Escala 0–{PagingScale:F0} págs/s (autoajustada) · 1 página = 4 KB";
            if (!_pagingSeen)
            {
                _pagingSeen = true;
                Sensors = BuildSensors();
            }
        }
        else
        {
            PagingText = "N/D";
            if (!_pagingSeen && _ticks == 5) Sensors = BuildSensors();
        }

        if (s.MemoryTotalBytes is { } total && s.MemoryAvailableBytes is { } avail && total >= avail)
            MemoryDetail = $"{FormatGb(total - avail)} en uso de {FormatGb(total)} · {FormatGb(avail)} disponibles";

        if (s.CommitUsedBytes is { } cu && s.CommitLimitBytes is { } cl)
            CommitDetail = $"Commit: {FormatGb(cu)} / {FormatGb(cl)}";

        var elapsed = DateTimeOffset.Now - _sessionStart;
        SessionText = $"Sesión: {elapsed:hh\\:mm\\:ss} · {_cpuStats.Count} muestras de CPU · {_memStats.Count} de memoria";
        StatusText = $"Telemetría activa · 1 Hz · ventana de {_window.Count} s";

        if (_processes is not null && !_processBusy && (_ticks == 1 || _ticks % 5 == 0))
            _ = RefreshConsumersAsync();

        if (_ticks % 5 == 0)
            RunDecisionEngine();
    }

    private async Task RefreshConsumersAsync()
    {
        _processBusy = true;
        try
        {
            var top = await Task.Run(() => _processes!.GetTopByPrivateBytes(5));
            _topConsumersRaw = top;
            TopConsumers = top.Select(p => new ConsumerView(
                p.InstanceCount > 1 ? $"{p.Name} ×{p.InstanceCount}" : p.Name,
                $"{FormatSize(p.PrivateBytes)} privada · {FormatSize(p.WorkingSetBytes)} en RAM")).ToArray();
            ConsumersStatus = top.Count == 0 ? "Sin datos" : $"Actualizado {DateTime.Now:T}";
        }
        catch (Exception ex)
        {
            _topConsumersRaw = Array.Empty<ProcessMemoryUsage>();
            TopConsumers = Array.Empty<ConsumerView>();
            ConsumersStatus = $"No disponible: {ex.Message}";
        }
        finally
        {
            _processBusy = false;
        }
    }

    private void RunDecisionEngine()
    {
        if (_decisionEngine is null) return;
        try
        {
            var report = _decisionEngine.Evaluate(
                new DecisionContext(Hardware, _window.ToArray(), _selectedGoal.Goal, _topConsumersRaw));
            Replace(Findings, report.Findings);
            Replace(Recommendations, report.Recommendations);
        }
        catch (Exception ex)
        {
            StatusText = $"Error en el motor de decisión: {ex.Message}";
        }
    }

    private static void Replace<T>(ObservableCollection<T> target, IReadOnlyList<T> source)
    {
        target.Clear();
        foreach (var item in source) target.Add(item);
    }

    private static void Push(List<double> series, double value)
    {
        series.Add(value);
        if (series.Count > HistoryLength) series.RemoveAt(0);
    }

    private static ScoreDimensionView Unmeasured(ScoreDimension d, string name, string requirement)
    {
        var score = new DimensionScore(d, null, 0, requirement + " Fuente aún no implementada.");
        return new ScoreDimensionView(name, score.Value is { } v ? $"{v:F0}" : "Sin medir", score.Basis);
    }

    private static string FormatGb(ulong bytes)
        => (bytes / 1024.0 / 1024.0 / 1024.0).ToString("F1", CultureInfo.CurrentCulture) + " GB";

    private static string FormatSize(ulong bytes)
        => bytes >= 1024UL * 1024 * 1024
            ? FormatGb(bytes)
            : (bytes / 1024.0 / 1024.0).ToString("F0", CultureInfo.CurrentCulture) + " MB";

    public void Dispose()
    {
        _timer.Stop();
        _timer.Tick -= OnTick;
    }

    private sealed class RunningStats
    {
        private double _sum, _min = double.MaxValue, _max = double.MinValue;
        public int Count { get; private set; }

        public void Add(double v)
        {
            Count++; _sum += v;
            if (v < _min) _min = v;
            if (v > _max) _max = v;
        }

        public string Describe(string unit)
            => Count == 0 ? "Sin muestras"
               : $"mín {_min:F0}{unit} · prom {_sum / Count:F0}{unit} · máx {_max:F0}{unit}";
    }
}
