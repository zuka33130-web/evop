namespace EvoOptimizer.Core.Benchmarking;

public static class RobustStatistics
{
    public static double Median(IReadOnlyList<double> values)
    {
        ArgumentNullException.ThrowIfNull(values);
        if (values.Count == 0) throw new ArgumentException("Se necesita al menos un valor.", nameof(values));
        var v = values.ToArray();
        Array.Sort(v);
        return MedianOfSorted(v);
    }

    public static double MedianOfSorted(double[] sorted)
    {
        int n = sorted.Length;
        if (n == 0) throw new ArgumentException("Se necesita al menos un valor.", nameof(sorted));
        return n % 2 == 1 ? sorted[n / 2] : (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0;
    }

    /// <summary>Percentil con interpolación lineal (tipo 7), q en [0, 1].</summary>
    public static double Percentile(IReadOnlyList<double> values, double q)
    {
        ArgumentNullException.ThrowIfNull(values);
        var v = values.ToArray();
        Array.Sort(v);
        return PercentileOfSorted(v, q);
    }

    public static double PercentileOfSorted(double[] sorted, double q)
    {
        if (sorted.Length == 0) throw new ArgumentException("Se necesita al menos un valor.", nameof(sorted));
        if (!(q >= 0 && q <= 1)) throw new ArgumentOutOfRangeException(nameof(q));
        double h = (sorted.Length - 1) * q;
        int lo = (int)Math.Floor(h);
        int hi = (int)Math.Ceiling(h);
        return sorted[lo] + (h - lo) * (sorted[hi] - sorted[lo]);
    }

    /// <summary>Desviación absoluta mediana (sin escalar). Robusta a valores atípicos.</summary>
    public static double MedianAbsoluteDeviation(IReadOnlyList<double> values)
    {
        double median = Median(values);
        var deviations = values.Select(x => Math.Abs(x - median)).ToArray();
        Array.Sort(deviations);
        return MedianOfSorted(deviations);
    }
}
