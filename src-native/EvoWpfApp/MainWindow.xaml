<Window x:Class="RyzerCortexUltra.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RYZER CORTEX ULTRA — ASUS PN64 CS2 Booster & Windows Optimizer" 
        Height="800" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A" Foreground="#F5F5F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilos de Color Dark Cyberpunk -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="CardDark" Color="#121212"/>
        <SolidColorBrush x:Key="BorderDark" Color="#262626"/>
        <SolidColorBrush x:Key="EmeraldAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#06B6D4"/>
        <SolidColorBrush x:Key="RoseAccent" Color="#F43F5E"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header (0) -->
            <RowDefinition Height="Auto"/>
            <!-- Target Hardware Banner (1) -->
            <RowDefinition Height="Auto"/>
            <!-- Action Button & Status (2) -->
            <RowDefinition Height="Auto"/>
            <!-- Terminal Log Console (3) -->
            <RowDefinition Height="*"/>
            <!-- Footer (4) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header Marca -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="#1A10B981" BorderBrush="#4010B981" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RYZER " FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="CORTEX ULTRA" FontSize="22" FontWeight="Bold" Foreground="{StaticResource EmeraldAccent}"/>
                        <Border Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="4" Margin="10,2,0,2" Padding="6,1">
                            <TextBlock Text="C# WPF .NET 8" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource EmeraldAccent}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Motor Nativo de Optimizacion de Windows 11 &amp; CS2 sin Consolas Negras" FontSize="12" Foreground="#888888"/>
                </StackPanel>
            </StackPanel>

            <!-- UAC Elevation Badge -->
            <Border x:Name="UacBadge" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="8" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Administrador UAC Activo" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource EmeraldAccent}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Row 1: Target Hardware Card -->
        <Border Grid.Row="1" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PROCESADOR OBJETIVO" FontSize="10" FontFamily="Consolas" Foreground="#666666"/>
                    <TextBlock Text="Intel Core i3-1220P" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                    <TextBlock Text="Alder Lake 2P+8E (12 Hilos @ 4.4 GHz)" FontSize="11" Foreground="#888888"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="GRAFICA INTEGRADA" FontSize="10" FontFamily="Consolas" Foreground="#666666"/>
                    <TextBlock Text="Intel UHD Graphics" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                    <TextBlock Text="64 Execution Units (FSR Rendimiento)" FontSize="11" Foreground="#888888"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CONFIGURACION MEMORIA" FontSize="10" FontFamily="Consolas" Foreground="#666666"/>
                    <TextBlock Text="16 GB DDR4 Dual-Channel" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                    <TextBlock Text="3200 MHz · DVMT 512MB" FontSize="11" Foreground="#888888"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="POLITICA AFINIDAD" FontSize="10" FontFamily="Consolas" Foreground="#666666"/>
                    <TextBlock Text="P-Cores Exclusivos" FontSize="14" FontWeight="Bold" Foreground="{StaticResource EmeraldAccent}" Margin="0,2,0,0"/>
                    <TextBlock Text="Mask 15 (Hilos 0-3) · E-Cores Libres" FontSize="11" Foreground="#888888"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Main Action Button -->
        <Border Grid.Row="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Center">
                <Button x:Name="BtnStartPhase3" Click="BtnStartPhase3_Click" Cursor="Hand" Width="360" Height="54">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{StaticResource EmeraldAccent}" CornerRadius="12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " FontSize="18"/>
                                    <TextBlock Text="INICIAR FASE 3 EXTREMA" FontSize="16" FontWeight="ExtraBold" Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#34D399"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock x:Name="TxtStatusHint" Text="Pulsa para crear punto de restauracion e inyectar optimizaciones a nivel kernel" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 3: Live Output Terminal Console -->
        <Border Grid.Row="3" Background="#000000" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="💻 CONSOLA DE LOGS EN TIEMPO REAL (C# ASYNC DISPATCHER)" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                    </StackPanel>
                    <TextBlock Text="CreateNoWindow = True" FontSize="11" FontFamily="Consolas" Foreground="#555555" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                </DockPanel>

                <TextBox x:Name="TxtConsoleLog" Grid.Row="1" 
                         Background="Transparent" Foreground="{StaticResource CyanAccent}" 
                         FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </Grid>
        </Border>

        <!-- Row 4: Footer -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="RYZER CORTEX ULTRA v8.0 · C# WPF .NET 8 Desktop Engine" FontSize="11" FontFamily="Consolas" Foreground="#555555" DockPanel.Dock="Left"/>
            <TextBlock Text="ASUS ExpertCenter PN64 CS2 Booster" FontSize="11" FontFamily="Consolas" Foreground="#555555" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
